# name: test/sql/tpcpatch.test
# description: Core tpcpatch type port — construction, text/WKB I/O and
#              basic accessors. A tpcpatch value is a temporal
#              pgpointcloud patch: a pgpointcloud pcpatch that moves over
#              time. The text of a pcpatch is the hex of its pgPointCloud
#              WKB, which MEOS reads through the schema of its pcid, so the
#              file registers the schema of pcid 1 first. The pcpatch hex
#              literal below is the little-endian WKB of pcid 1,
#              uncompressed, two points (1 1 1) and (2 2 2): the endian
#              flag 01, the pcid, the compression, the number of points and
#              the six doubles; MEOS writes it back unchanged.
# group: [sql]

require mobilityduck

# The text of a pcpoint and of a pcpatch is the hex of its pgPointCloud WKB, read through the
# schema its pcid names, so the schema of pcid 1 is registered first: three dimensions X, Y
# and Z of type double.
statement ok
CREATE TABLE pointcloud_schemas (
  pcid         integer PRIMARY KEY,
  srid         integer NOT NULL,
  compression  text    NOT NULL DEFAULT 'none',
  description  text
);

statement ok
CREATE TABLE pointcloud_dimensions (
  pcid            integer NOT NULL,
  dim_no          integer NOT NULL,
  dim_name        text    NOT NULL,
  interpretation  text    NOT NULL,
  dim_scale       double  NOT NULL DEFAULT 1,
  dim_offset      double  NOT NULL DEFAULT 0,
  active          boolean NOT NULL DEFAULT true,
  description     text,
  PRIMARY KEY (pcid, dim_no)
);

statement ok
INSERT INTO pointcloud_schemas VALUES (1, 0, 'none', 'Three dimensions of type double');

statement ok
INSERT INTO pointcloud_dimensions VALUES
  (1, 1, 'X', 'double', 1, 0, true, NULL),
  (1, 2, 'Y', 'double', 1, 0, true, NULL),
  (1, 3, 'Z', 'double', 1, 0, true, NULL);

query I
SELECT pointCloudSchemaRegister(s.pcid, s.srid, s.compression,
         list({'dim_no': d.dim_no, 'dim_name': d.dim_name,
               'interpretation': d.interpretation, 'dim_scale': d.dim_scale,
               'dim_offset': d.dim_offset, 'active': d.active,
               'description': d.description} ORDER BY d.dim_no))
FROM pointcloud_schemas s JOIN pointcloud_dimensions d USING (pcid)
GROUP BY s.pcid, s.srid, s.compression;
----
true

# Test tpcpatch constructor with parentheses (instant, hex-WKB pcpatch)
query I
SELECT (tpcpatch('01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01'))::text;
----
01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01 00:00:00+01

# Test tpcpatch constructor without parentheses
query I
SELECT (tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01')::text;
----
01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01 00:00:00+01

# Test the VARCHAR <-> TPCPATCH cast round-trips through temporal_out
query I
SELECT (tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01')::text;
----
01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01 00:00:00+01

# Test tempSubtype with instant
query I
SELECT tempSubtype(tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01');
----
Instant

# Test interp accessor on an instant
query I
SELECT interp(tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01');
----
None

# Test memSize is positive
query I
SELECT memSize(tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01') > 0;
----
true

# Test getValue surfaces the pcpatch value in canonical hex-WKB text
query I
SELECT getValue(tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01');
----
01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040

# Test startValue surfaces the pcpatch value in canonical hex-WKB text
query I
SELECT startValue(tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01');
----
01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040

# Test pcid returns the pgpointcloud schema id (schema-free header read)
query I
SELECT pcid(tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01');
----
1

# Test numPoints returns the patch point count (schema-free header read)
query I
SELECT numPoints(tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01');
----
2

# Test getTimestamp on an instant
query I
SELECT getTimestamp(tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2023-01-01 10:00:00+00');
----
2023-01-01 11:00:00+01

# Test tpcpatchInst transformation round-trips the instant
query I
SELECT (tpcpatchInst(tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01'))::text;
----
01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01 00:00:00+01

# Test startInstant
query I
SELECT (startInstant(tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01'))::text;
----
01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01 00:00:00+01

# Test binary round-trip is identity (subtype-agnostic MEOS-WKB)
query I
SELECT (tpcpatchFromBinary(asBinary(tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01')))::text
     = (tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01')::text;
----
true

# Test hex-WKB round-trip is identity
query I
SELECT (tpcpatchFromHexWKB(asHexWKB(tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01')))::text
     = (tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01')::text;
----
true

# Test tpcpatchFromText constructor
query I
SELECT (tpcpatchFromText('01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01'))::text IS NOT NULL;
----
true

# Test timeSpan function
query I
SELECT timeSpan(tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01');
----
[2024-01-01 00:00:00+01, 2024-01-01 00:00:00+01]

# Test numInstants generic accessor
query I
SELECT numInstants(tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01');
----
1

# Test asMFJSON. The MF-JSON form writes the points of each patch, decoded
# through the schema of pcid 1 registered above.
query I
SELECT asMFJSON(tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01');
----
{"type":"MovingPCPatch","values":[{"pcid":1,"npoints":2,"bounds":[1,2,1,2],"pts":[[1,1,1],[2,2,2]]}],"datetimes":["2024-01-01T00:00:00+01:00"],"interpolation":"None"}

# A negative MF-JSON precision reaches MEOS, which refuses it
statement error
SELECT asMFJSON(tpcpatch '01010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040@2024-01-01', 0, 0, -1);
----
cannot be negative

# Test invalid input is rejected deterministically
statement error
SELECT tpcpatch('not-a-valid-tpcpatch');
----
Missing delimeter character
