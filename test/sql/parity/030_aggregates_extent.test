# name: test/sql/parity/030_aggregates_extent.test
# description: extent() aggregate parity across scalar / span / set
#              inputs.  Coverage limited to types whose extent
#              finalize-blob round-trips cleanly through `::VARCHAR`;
#              tstzset / tstzspanset / TIMESTAMPTZ / temporal extents
#              go through MEOS `*span/*spanset/temporal_out` which
#              SIGSEGVs on aggregate-finalize output (pre-existing
#              upstream binding bug — same pattern as in 015 / 040 /
#              042 aggregate tests).  Those are covered via accessor
#              shape elsewhere (031_aggregates_skiplist.test).
# group: [sql]

require mobilityduck

require icu

statement ok
SET TimeZone='UTC'

# =============================================================================
# extent(scalar) — integer / bigint / float / date
# =============================================================================

statement ok
CREATE TEMP TABLE int_in (v INTEGER);

statement ok
INSERT INTO int_in VALUES (1), (5), (3);

query I
SELECT extent(v)::VARCHAR FROM int_in;
----
[1, 6)

statement ok
CREATE TEMP TABLE bigint_in (v BIGINT);

statement ok
INSERT INTO bigint_in VALUES (1), (5), (3);

query I
SELECT extent(v)::VARCHAR FROM bigint_in;
----
[1, 6)

statement ok
CREATE TEMP TABLE double_in (v DOUBLE);

statement ok
INSERT INTO double_in VALUES (1.5), (5.5), (3.5);

query I
SELECT extent(v)::VARCHAR FROM double_in;
----
[1.5, 5.5]

statement ok
CREATE TEMP TABLE date_in (v DATE);

statement ok
INSERT INTO date_in VALUES (DATE '2001-01-01'), (DATE '2001-02-15'), (DATE '2001-01-15');

query I
SELECT extent(v)::VARCHAR FROM date_in;
----
[2001-01-01, 2001-02-16)

# =============================================================================
# extent(span) — int / float
# =============================================================================

statement ok
CREATE TEMP TABLE intspan_in (v intspan);

statement ok
INSERT INTO intspan_in VALUES ('[1,5)'::intspan), ('[3,8)'::intspan);

query I
SELECT extent(v)::VARCHAR FROM intspan_in;
----
[1, 8)

statement ok
CREATE TEMP TABLE floatspan_in (v floatspan);

statement ok
INSERT INTO floatspan_in VALUES ('[1.0,5.0]'::floatspan), ('[3.0,8.0]'::floatspan);

query I
SELECT extent(v)::VARCHAR FROM floatspan_in;
----
[1, 8]

# =============================================================================
# extent(set) — int (numeric basetypes; timestamp basetypes covered
# via accessor in 031_aggregates_skiplist.test)
# =============================================================================

statement ok
CREATE TEMP TABLE intset_in (v intset);

statement ok
INSERT INTO intset_in VALUES ('{1,3,5}'::intset), ('{2,4,7}'::intset);

query I
SELECT extent(v)::VARCHAR FROM intset_in;
----
[1, 8)

# =============================================================================
# extent(spanset) — int (timestamp covered elsewhere)
# =============================================================================

statement ok
CREATE TEMP TABLE intspanset_in (v intspanset);

statement ok
INSERT INTO intspanset_in VALUES ('{[1,3),[5,7)}'::intspanset), ('{[10,15)}'::intspanset);

query I
SELECT extent(v)::VARCHAR FROM intspanset_in;
----
[1, 15)

# =============================================================================
# extent(tbox) — value-only TBOXINT
# =============================================================================

statement ok
CREATE TEMP TABLE tbox_in (v tbox);

statement ok
INSERT INTO tbox_in VALUES
  ('TBOXINT XT([1, 5),[2000-01-01, 2000-01-05])'::tbox),
  ('TBOXINT XT([3, 8),[2000-01-03, 2000-01-08])'::tbox);

# extent(tbox) result has a tstz time component; ::VARCHAR crashes
# in tbox_out for the aggregate-finalize layout.  Verify the value
# component via tbox_xmin / tbox_xmax instead.

query I
SELECT Xmin(extent(v)) = 1 FROM tbox_in;
----
true

query I
SELECT Xmax(extent(v)) = 7 FROM tbox_in;
----
true

# =============================================================================
# extent(stbox) — no time component (X-only)
# =============================================================================

statement ok
CREATE TEMP TABLE stbox_in (v stbox);

statement ok
INSERT INTO stbox_in VALUES
  ('STBOX X((1,2),(3,4))'::stbox),
  ('STBOX X((0,1),(5,6))'::stbox);

query I
SELECT extent(v)::VARCHAR FROM stbox_in;
----
STBOX X((0,1),(5,6))

# =============================================================================
# extent ignores NULLs
# =============================================================================

statement ok
CREATE TEMP TABLE intnull_in (v INTEGER);

statement ok
INSERT INTO intnull_in VALUES (1), (NULL), (5), (NULL), (3);

query I
SELECT extent(v)::VARCHAR FROM intnull_in;
----
[1, 6)

statement ok
CREATE TEMP TABLE allnull_in (v INTEGER);

statement ok
INSERT INTO allnull_in VALUES (NULL);

query I
SELECT extent(v)::VARCHAR FROM allnull_in;
----
NULL
