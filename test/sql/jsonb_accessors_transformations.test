# name: test/sql/jsonb_accessors_transformations.test
# description: The accessors and transformations of one JSONB value, and the paths a temporal
#              JSONB value sets, each answer MobilityDB's regression answer. A set-returning
#              function answers a list a query UNNESTs into its rows.
# group: [sql]

require mobilityduck

# ── accessors ────────────────────────────────────────────────────────────────

query T
SELECT jsonbObjectField(jsonb '{"a": {"b": 1}}', 'a')::VARCHAR;
----
{"b": 1}

query T
SELECT jsonbObjectField(jsonb '{"a": 1}', 'z') IS NULL;
----
true

query T
SELECT jsonbObjectFieldText(jsonb '{"a": "x"}', 'a');
----
x

query T
SELECT jsonbArrayElement(jsonb '[1, [2, 3]]', 1)::VARCHAR;
----
[2, 3]

query T
SELECT jsonbArrayElement(jsonb '[1, 2, 3]', -1)::VARCHAR;
----
3

query T
SELECT jsonbArrayElementText(jsonb '["x", "y"]', 0);
----
x

query T
SELECT jsonbExtractPathText(jsonb '{"a": {"b": "z"}}', ['a', 'b']);
----
z

# The line breaks of the pretty text written as '|', as value_type_sets.test reads jsonbsetPretty
query T
SELECT replace(jsonbPretty(jsonb '{"a": 1}'), chr(10), '|');
----
{|    "a": 1|}

query T
SELECT jsonbExists(jsonb '{"a": 1}', 'a');
----
true

query T
SELECT jsonbExists(jsonb '{"a": 1}', 'b');
----
false

query T
SELECT jsonbExistsAny(jsonb '{"a": 1}', ['b', 'a']);
----
true

query T
SELECT jsonbExistsAll(jsonb '{"a": 1}', ['b', 'a']);
----
false

# ── set-returning accessors ──────────────────────────────────────────────────

query T
SELECT unnest(jsonbArrayElements(jsonb '[1, "two", {"three": 3}]'))::VARCHAR;
----
1
"two"
{"three": 3}

query T
SELECT unnest(jsonbArrayElementsText(jsonb '[1, "two"]'));
----
1
two

# A JSON null read as text is an SQL NULL.
query T
SELECT unnest(jsonbArrayElementsText(jsonb '[1, null]'));
----
1
NULL

query TT
SELECT e.key, e.value::VARCHAR FROM (SELECT unnest(jsonbEach(jsonb '{"a": 1, "b": [2]}')) AS e)
ORDER BY 1;
----
a	1
b	[2]

query TT
SELECT e.key, e.value FROM (SELECT unnest(jsonbEachText(jsonb '{"a": 1, "b": "x"}')) AS e)
ORDER BY 1;
----
a	1
b	x

query T
SELECT k FROM (SELECT unnest(jsonbObjectKeys(jsonb '{"b": 1, "a": 2}')) AS k) ORDER BY 1;
----
a
b

query I
SELECT len(jsonbArrayElements(jsonb '[]'));
----
0

# ── transformations ──────────────────────────────────────────────────────────

query T
SELECT jsonbDelete(jsonb '{"a": 1, "b": 2}', 'a')::VARCHAR;
----
{"b": 2}

query T
SELECT jsonbDeleteIndex(jsonb '[1, 2, 3]', -1)::VARCHAR;
----
[1, 2]

# Given a value, jsonbSetLax sets it as jsonbSet does, MobilityDB's answers for jsonbSet; its
# treatment of a NULL value (handle_null) applies only to a NULL one.
query T
SELECT jsonbSetLax(jsonb '{"a": 1}', ['b'], jsonb '2')::VARCHAR;
----
{"a": 1, "b": 2}

query T
SELECT jsonbSetLax(jsonb '{"a": 1}', ['b'], jsonb '2', false)::VARCHAR;
----
{"a": 1}

query T
SELECT jsonbSetLax(jsonb '{"a": 1}', ['a'], jsonb '3', true, 'delete_key')::VARCHAR;
----
{"a": 3}

query T
SELECT jsonbStripNulls(jsonb '{"a": null, "b": [1, null]}')::VARCHAR;
----
{"b": [1, null]}

query T
SELECT jsonbStripNulls(jsonb '{"a": null, "b": [1, null]}', true)::VARCHAR;
----
{"b": [1]}

# ── the paths a temporal JSONB value sets ────────────────────────────────────

query T
SELECT tjsonbSet(tjsonb '"{\"speed\": 10}"@2001-01-01', ['units'], jsonb '"km/h"')
  = tjsonb '"{\"speed\": 10, \"units\": \"km/h\"}"@2001-01-01';
----
true

query T
SELECT tjsonbSet(tjsonb '{{"gears": [1, 3]}@2001-01-01}', ['gears', '1'], jsonb '2')
  = tjsonb '{"{\"gears\": [1, 2]}"@2001-01-01}';
----
true

query T
SELECT tjsonbSetLax(tjsonb '{{"gears": [1, 3]}@2001-01-01}', ['gears', '1'], jsonb '2')
  = tjsonbSet(tjsonb '{{"gears": [1, 3]}@2001-01-01}', ['gears', '1'], jsonb '2');
----
true

# ── a NULL element of a path or of the keys ──────────────────────────────────
# A NULL element of the list reaches MEOS as the NULL of the SQL array, and each function
# answers MobilityDB's regression answer (453_jsonb_jsonfuncs, 454_tjsonb_jsonfuncs), which is
# PostgreSQL's: an extraction answers NULL, an existence test skips the NULL key, and a path
# modification raises at the NULL element the walk reaches and leaves the value as it is when
# the walk does not reach it.

query T
SELECT jsonbExtractPath(jsonb '{"a": {"b": 1}}', ['a', NULL]) IS NULL;
----
true

query T
SELECT jsonbExtractPath(jsonb '{"a": {"b": 1}}', [NULL, 'a']) IS NULL;
----
true

query T
SELECT jsonbExtractPathText(jsonb '{"a": {"b": 1}}', ['a', NULL]) IS NULL;
----
true

query TTTT
SELECT jsonbExistsAny(jsonb '{"a": 1}', ['a', NULL]), jsonbExistsAny(jsonb '{"a": 1}', ['b', NULL]),
  jsonbExistsAll(jsonb '{"a": 1}', ['a', NULL]), jsonbExistsAll(jsonb '{"a": 1}', [NULL::VARCHAR]);
----
true	false	true	true

query T
SELECT jsonbDeleteArray(jsonb '{"a": 1, "b": 2}', ['a', NULL])::VARCHAR;
----
{"b": 2}

query T
SELECT jsonbDeletePath(jsonb '{"a": {"b": 1}}', ['x', NULL])::VARCHAR;
----
{"a": {"b": 1}}

statement error
SELECT jsonbDeletePath(jsonb '{"a": {"b": 1}}', ['a', NULL]);
----
path element at position 2 is null

statement error
SELECT jsonbDeletePath(jsonb '{"a": {"b": 1}}', [NULL::VARCHAR]);
----
path element at position 1 is null

query T
SELECT jsonbSet(jsonb '{"a": {"b": 1}}', ['x', NULL], jsonb '3', true)::VARCHAR;
----
{"a": {"b": 1}}

statement error
SELECT jsonbSet(jsonb '{"a": {"b": 1}}', ['a', NULL], jsonb '3', true);
----
path element at position 2 is null

statement error
SELECT jsonbSet(jsonb '{"d": [1, 2]}', ['d', NULL], jsonb '3', true);
----
path element at position 2 is null

statement error
SELECT jsonbSetLax(jsonb '{"a": {"b": 1}}', ['a', NULL], jsonb '3');
----
path element at position 2 is null

query T
SELECT jsonbInsert(jsonb '{"a": {"b": 1}}', ['x', NULL], jsonb '3', false)::VARCHAR;
----
{"a": {"b": 1}}

statement error
SELECT jsonbInsert(jsonb '{"d": [1, 2]}', ['d', NULL], jsonb '3', false);
----
path element at position 2 is null

statement error
SELECT tjsonbSet(tjsonb '{{"gears": [1, 3]}@2001-01-01}', ['gears', NULL], jsonb '2');
----
path element at position 2 is null

query T
SELECT tjsonbSet(tjsonb '{{"gears": [1, 3]}@2001-01-01}', ['x', NULL], jsonb '2')
  = tjsonb '{{"gears": [1, 3]}@2001-01-01}';
----
true

# ── the forms a trailing SQL default allows ──────────────────────────────────
# Each function MobilityDB declares with a trailing default (jsonbSet's create_missing true,
# jsonbInsert's after false, the null_handle 'use_json_null' of the path extractions) answers
# without that argument what it answers with the default passed.

query T
SELECT jsonbSet(jsonb '{"a": 1}', ['b'], jsonb '2')::VARCHAR;
----
{"a": 1, "b": 2}

query T
SELECT jsonbInsert(jsonb '{"d": [1, 2]}', ['d', '0'], jsonb '3')::VARCHAR;
----
{"d": [3, 1, 2]}

query T
SELECT tjsonbInsert(tjsonb '{{"gears": [1, 3]}@2001-01-01}', ['gears', '0'], jsonb '2')
  = tjsonbInsert(tjsonb '{{"gears": [1, 3]}@2001-01-01}', ['gears', '0'], jsonb '2', false);
----
true

query T
SELECT tjsonbExtractPath(tjsonb '{{"speed": 10}@2001-01-01, {"units": "km/h"}@2001-01-02}', ['speed'])
  = tjsonbExtractPath(tjsonb '{{"speed": 10}@2001-01-01, {"units": "km/h"}@2001-01-02}', ['speed'], 'use_json_null');
----
true

query T
SELECT tjsonbExtractPathText(tjsonb '{{"speed": 10}@2001-01-01, {"speed": 20}@2001-01-02}', ['speed'])
  = tjsonbExtractPathText(tjsonb '{{"speed": 10}@2001-01-01, {"speed": 20}@2001-01-02}', ['speed'], 'use_json_null');
----
true

query T
SELECT tjsonExtractPath(ttext '{"{\"speed\": 10}"@2001-01-01, "{\"speed\": 20}"@2001-01-02}', ['speed'])
  = tjsonExtractPath(ttext '{"{\"speed\": 10}"@2001-01-01, "{\"speed\": 20}"@2001-01-02}', ['speed'], 'use_json_null');
----
true

# A path holding a NULL element extracts no value, as jsonbExtractPath answers NULL
query T
SELECT tjsonbExtractPath(tjsonb '{{"speed": 10}@2001-01-01, {"speed": 20}@2001-01-02}', ['speed', NULL]) IS NULL;
----
true
