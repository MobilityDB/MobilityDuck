# A NaN nodata value.
statement error
SELECT raster(from_hex('53520000020000000300000002000000000000000000F87F0001027F80FF0A141E28323C'), 0, 0, meta_none())
----
datacube: the nodata value is NaN, where it is finite or -infinity for none

# A +infinity nodata value.
statement error
SELECT raster(from_hex('53520000020000000300000002000000000000000000F07F0001027F80FF0A141E28323C'), 0, 0, meta_none())
----
datacube: the nodata value is +infinity, where it is finite or -infinity for none

# A nodata value beyond the data type.
statement error
SELECT raster(from_hex('535200000200000003000000020000000000000000C072400001027F80FF0A141E28323C'), 0, 0, meta_none())
----
raster: the datacube nodata value 300.0 is no value of its data type UINT8

# A fractional nodata value of an integer type.
statement error
SELECT raster(from_hex('53520000020000000300000002000000000000000000F83F0001027F80FF0A141E28323C'), 0, 0, meta_none())
----
raster: the datacube nodata value 1.5 is no value of its data type UINT8

# ── what the metadata of a tile cannot be ────────────────────────────────────

# Metadata that is not JSON.
statement error
SELECT raster(cube, 0, 0, 'not json') FROM cube WHERE type = 'UINT8' AND format = 'RAW'
----
raster: the tile metadata is not JSON

# Metadata that is no object.
statement error
SELECT raster(cube, 0, 0, '[1, 2]') FROM cube WHERE type = 'UINT8' AND format = 'RAW'
----
raster: the tile metadata is not a JSON object

# A transform of 5 coefficients.
statement error
SELECT raster(cube, 0, 0, '{"crs": "EPSG:4326", "transform": [10, 2, 0, 50, 0], "blocksize_x": 3, "blocksize_y": 2}') FROM cube WHERE type = 'UINT8' AND format = 'RAW'
----
raster: the tile metadata states no 'transform' of 6 numbers

# No transform.
statement error
SELECT raster(cube, 0, 0, '{"crs": "EPSG:4326", "blocksize_x": 3, "blocksize_y": 2}') FROM cube WHERE type = 'UINT8' AND format = 'RAW'
----
raster: the tile metadata states no 'transform' of 6 numbers

# A transform coefficient that is a string.
statement error
SELECT raster(cube, 0, 0, '{"crs": "EPSG:4326", "transform": [10, 2, "0", 50, 0, -2], "blocksize_x": 3, "blocksize_y": 2}') FROM cube WHERE type = 'UINT8' AND format = 'RAW'
----
raster: the tile metadata states a 'transform' whose coefficient 3 is not a finite number

# A transform coefficient that is NaN.
statement error
SELECT raster(cube, 0, 0, '{"crs": "EPSG:4326", "transform": [10, 2, 0, NaN, 0, -2], "blocksize_x": 3, "blocksize_y": 2}') FROM cube WHERE type = 'UINT8' AND format = 'RAW'
----
raster: the tile metadata states a 'transform' whose coefficient 4 is not a finite number

# No blocksize_x.
statement error
SELECT raster(cube, 0, 0, '{"crs": "EPSG:4326", "transform": [10, 2, 0, 50, 0, -2], "blocksize_y": 2}') FROM cube WHERE type = 'UINT8' AND format = 'RAW'
----
raster: the tile metadata states no integer 'blocksize_x'

# A zero blocksize.
statement error
SELECT raster(cube, 0, 0, '{"crs": "EPSG:4326", "transform": [10, 2, 0, 50, 0, -2], "blocksize_x": 3, "blocksize_y": 0}') FROM cube WHERE type = 'UINT8' AND format = 'RAW'
----
raster: the tile metadata states a 'blocksize_y' that is not a positive 32-bit integer

# A fractional blocksize.
statement error
SELECT raster(cube, 0, 0, '{"crs": "EPSG:4326", "transform": [10, 2, 0, 50, 0, -2], "blocksize_x": 2.5, "blocksize_y": 2}') FROM cube WHERE type = 'UINT8' AND format = 'RAW'
----
raster: the tile metadata states no integer 'blocksize_x'

# No reference system.
statement error
SELECT raster(cube, 0, 0, '{"transform": [10, 2, 0, 50, 0, -2], "blocksize_x": 3, "blocksize_y": 2}') FROM cube WHERE type = 'UINT8' AND format = 'RAW'
----
raster: the tile metadata states no string 'crs'

# A reference system as WKT, which states no SRID.
statement error
SELECT raster(cube, 0, 0, '{"crs": "GEOGCS[WGS 84]", "transform": [10, 2, 0, 50, 0, -2], "blocksize_x": 3, "blocksize_y": 2}') FROM cube WHERE type = 'UINT8' AND format = 'RAW'
----
raster: the tile metadata states the reference system 'GEOGCS[WGS 84]', where a raster reads EPSG:<code> or none

# A reference system of another authority.
statement error
SELECT raster(cube, 0, 0, '{"crs": "OGC:CRS84", "transform": [10, 2, 0, 50, 0, -2], "blocksize_x": 3, "blocksize_y": 2}') FROM cube WHERE type = 'UINT8' AND format = 'RAW'
----
raster: the tile metadata states the reference system 'OGC:CRS84', where a raster reads EPSG:<code> or none

# An EPSG code that is no number.
statement error
SELECT raster(cube, 0, 0, '{"crs": "EPSG:43x6", "transform": [10, 2, 0, 50, 0, -2], "blocksize_x": 3, "blocksize_y": 2}') FROM cube WHERE type = 'UINT8' AND format = 'RAW'
----
raster: the tile metadata states the reference system 'EPSG:43x6', whose code is no positive 32-bit integer

# The EPSG code 0.
statement error
SELECT raster(cube, 0, 0, '{"crs": "EPSG:0", "transform": [10, 2, 0, 50, 0, -2], "blocksize_x": 3, "blocksize_y": 2}') FROM cube WHERE type = 'UINT8' AND format = 'RAW'
----
raster: the tile metadata states the reference system 'EPSG:0', whose code is no positive 32-bit integer

# A negative tile coordinate.
statement error
SELECT raster(cube, -1, 0, meta_none()) FROM cube WHERE type = 'UINT8' AND format = 'RAW'
----
raster: the tile (-1, 0) has a negative coordinate

# A tile whose pixel offset overflows 32 bits.
statement error
SELECT raster(cube, 2147483647, 0, meta_none()) FROM cube WHERE type = 'UINT8' AND format = 'RAW'
----
raster: the tile (2147483647, 0) of 3 x 2 pixels lies beyond the pixel offsets of a raster
