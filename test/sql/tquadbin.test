require mobilityduck

# ── static cell round-trip ──────────────────────────────────────────────────
query I
SELECT quadbinTileToCell(1, 0, 1);
----
5194902170171867135

query I
SELECT quadbinGetResolution(quadbinTileToCell(2, 1, 2));
----
2

query I
SELECT quadbinIsValidCell(quadbinTileToCell(5, 3, 3));
----
true

query III
SELECT quadbinCellToTileX(quadbinTileToCell(2, 1, 2)),
       quadbinCellToTileY(quadbinTileToCell(2, 1, 2)),
       quadbinCellToTileZ(quadbinTileToCell(2, 1, 2));
----
2	1	2

# ── the temporal cell index reports the canonical lowercase type name ────────
query I
SELECT typeof(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'));
----
tquadbin

# ── generated generic Temporal<T> accessor (SIG_TEMPORAL_ACC) over tquadbin ───
query I
SELECT numInstants(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'));
----
1

# ── generated traditional comparison (compops) over tquadbin ─────────────────
query I
SELECT tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01')
     = tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01');
----
true

# ── the cell-id value accessor reports the canonical lowercase base type ──────
query I
SELECT typeof(startValue(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01')));
----
quadbin

# ── tquadbin instant constructor + accessor ─────────────────────────────────
query I
SELECT startValue(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'));
----
5194902170171867135

query I
SELECT endValue(tquadbin(quadbinTileToCell(2,1,2), TIMESTAMPTZ '2024-06-01'));
----
5199124294822526975

# ── generated cell-id valueN (Temporal<T> out-param fold) → quadbin ───────────
query I
SELECT typeof(valueN(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'), 1));
----
quadbin

query I
SELECT valueN(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'), 1)
     = startValue(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'));
----
true

# ── generated cell-id getValues → LIST(quadbin) ──────────────────────────────
query I
SELECT typeof(getValues(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'))[1]);
----
quadbin

query I
SELECT getValues(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'))[1];
----
5194902170171867135

# ── the shared DGGS cell-index slots, answered from the tcellindex kernel ─────
# The same kernel answers these for quadbin as for H3, under the bare slot names.
# cellToPoint is quadbin's alone among the temporal cell indexes: it returns the
# planar tgeompoint centroid, where H3 answers cellToPoint geodetically.
query I
SELECT startValue(getResolution(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01')));
----
1

query I
SELECT startValue(isValidCell(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01')));
----
true

query I
SELECT startValue(cellArea(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'))) > 0;
----
true

query I
SELECT typeof(startValue(cellToPoint(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'))));
----
GEOMETRY

query I
SELECT startValue(cellToParent(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'), 0))::VARCHAR;
----
5192650370358181887

# the planar counterpart of the H3 boundary in th3index.test
query I
SELECT typeof(cellToBoundary(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01')));
----
tgeometry

query I
SELECT typeof(startValue(cellToBoundary(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'))));
----
GEOMETRY

# ── a static cell compares against the temporal cell in either operand order ──
# The generic binary shape reaches these once a by-value cell id resolves to its own
# registered type; before that quadbin declared none of them, so every query below is
# new surface. h3_prefilter.test holds the H3 counterpart.

query I
SELECT eEq(quadbinTileToCell(1,0,1), tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'));
----
true

query I
SELECT eEq(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'), quadbinTileToCell(1,0,1));
----
true

# A cell the value never takes: ever-equal is false, which is what separates the
# comparison from one that answers true whatever it is handed.
query I
SELECT eEq(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'), quadbinTileToCell(2,1,2));
----
false

query II
SELECT aEq(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'), quadbinTileToCell(1,0,1)),
       aEq(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'), quadbinTileToCell(2,1,2));
----
true	false

query II
SELECT eNe(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'), quadbinTileToCell(2,1,2)),
       eNe(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'), quadbinTileToCell(1,0,1));
----
true	false

query II
SELECT aNe(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'), quadbinTileToCell(2,1,2)),
       aNe(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'), quadbinTileToCell(1,0,1));
----
true	false

# ── the temporal comparison lifts the cell over the value's own time ──
# Read through startValue so the assertion carries no session timezone.
query I
SELECT typeof(tEq(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'), quadbinTileToCell(1,0,1)));
----
tbool

query II
SELECT startValue(tEq(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'), quadbinTileToCell(1,0,1))),
       startValue(tEq(quadbinTileToCell(1,0,1), tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01')));
----
true	true

query II
SELECT startValue(tEq(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'), quadbinTileToCell(2,1,2))),
       startValue(tNe(tquadbin(quadbinTileToCell(1,0,1), TIMESTAMPTZ '2024-01-01'), quadbinTileToCell(2,1,2)));
----
false	true
