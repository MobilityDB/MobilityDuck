# name: test/sql/parity/095_index_ordering_query_on_left.test
# description: the position operators with the query on the left agree with a scan of the same rows
# group: [sql]

require mobilityduck

statement ok
CREATE TABLE ord_idx(t tgeompoint);

statement ok
CREATE TABLE ord_scan(t tgeompoint);

statement ok
INSERT INTO ord_idx SELECT ('Point(' || i || ' ' || i || ')@' || strftime(DATE '2000-01-01' + INTERVAL (i) DAY, '%Y-%m-%d'))::tgeompoint FROM range(1,3000) tbl(i);

statement ok
INSERT INTO ord_scan SELECT * FROM ord_idx;

# only one of the two tables is indexed, so the answers below are the index's against a scan's
statement ok
CREATE INDEX i_ord ON ord_idx USING TRTREE (t);

# A strict ordering with the query on the left asks the index for its opposite: `query << column`
# holds exactly when `column >> query` does.

query II
EXPLAIN SELECT count(*) FROM ord_idx WHERE 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox << t;
----
physical_plan	<REGEX>:.*MOBILITY RTREE INDEX.*

query II
SELECT (SELECT count(*) FROM ord_idx WHERE 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox << t), (SELECT count(*) FROM ord_scan WHERE 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox << t);
----
2498	2498

query II
SELECT (SELECT count(*) FROM ord_idx WHERE 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox >> t), (SELECT count(*) FROM ord_scan WHERE 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox >> t);
----
499	499

# An overlapping ordering has no opposite: `query &< column` asks for a stored box whose end is not
# before the end of the query, which no index search states, so the predicate is answered by a scan.

query II
EXPLAIN SELECT count(*) FROM ord_idx WHERE 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox &< t;
----
physical_plan	<!REGEX>:.*MOBILITY RTREE INDEX.*

query II
SELECT (SELECT count(*) FROM ord_idx WHERE 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox &< t), (SELECT count(*) FROM ord_scan WHERE 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox &< t);
----
2499	2499

query II
SELECT (SELECT count(*) FROM ord_idx WHERE stboxOverleft('STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox, t)), (SELECT count(*) FROM ord_scan WHERE stboxOverleft('STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox, t));
----
2499	2499

query II
SELECT (SELECT count(*) FROM ord_idx WHERE 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox &> t), (SELECT count(*) FROM ord_scan WHERE 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox &> t);
----
500	500

query II
SELECT (SELECT count(*) FROM ord_idx WHERE stboxOverbefore('STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox, t)), (SELECT count(*) FROM ord_scan WHERE stboxOverbefore('STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox, t));
----
2633	2633

query II
SELECT (SELECT count(*) FROM ord_idx WHERE stboxOverafter('STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox, t)), (SELECT count(*) FROM ord_scan WHERE stboxOverafter('STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox, t));
----
366	366
