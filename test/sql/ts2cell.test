# name: test/sql/ts2cell.test
# description: The Google S2 temporal cell index (s2cell / ts2cell)
# group: [sql]

require mobilityduck

# ── static cell round-trip ──────────────────────────────────────────────────
# The text form of an S2 cell is its hex token, which s2cell_in/s2cell_out own,
# so the spelling a MobilityDB user writes is the spelling DuckDB accepts.
query I
SELECT '47c3c3'::s2cell::VARCHAR;
----
47c3c3

query I
SELECT typeof('47c3c3'::s2cell);
----
s2cell

# ── the temporal cell index reports the canonical lowercase type name ────────
query I
SELECT typeof('{47c3c3@2000-01-01}'::ts2cell);
----
ts2cell

# ── generated generic Temporal<T> accessor (SIG_TEMPORAL_ACC) over ts2cell ────
query I
SELECT numInstants('{47c3c3@2000-01-01, 47c3c5@2000-01-02}'::ts2cell);
----
2

# ── generated traditional comparison (compops) over ts2cell ──────────────────
query I
SELECT '{47c3c3@2000-01-01}'::ts2cell = '{47c3c3@2000-01-01}'::ts2cell;
----
true

# ── the cell-id value accessors report the canonical lowercase base type ─────
query I
SELECT typeof(startValue('{47c3c3@2000-01-01}'::ts2cell));
----
s2cell

query I
SELECT startValue('{47c3c3@2000-01-01, 47c3c5@2000-01-02}'::ts2cell)::VARCHAR;
----
47c3c3

query I
SELECT endValue('{47c3c3@2000-01-01, 47c3c5@2000-01-02}'::ts2cell)::VARCHAR;
----
47c3c5

# ── generated cell-id valueN (Temporal<T> out-param fold) → s2cell ───────────
# The out-parameter is spelled `S2CellId *` where the quadbin and H3 twins spell
# it `uint64_t *`; the same typedef, so this generates identically to them.
query I
SELECT typeof(valueN('{47c3c3@2000-01-01}'::ts2cell, 1));
----
s2cell

query I
SELECT valueN('{47c3c3@2000-01-01, 47c3c5@2000-01-02}'::ts2cell, 2)::VARCHAR;
----
47c3c5

query I
SELECT valueN('{47c3c3@2000-01-01, 47c3c5@2000-01-02}'::ts2cell, 2)
     = endValue('{47c3c3@2000-01-01, 47c3c5@2000-01-02}'::ts2cell);
----
true

# ── getValues → s2cellset, the set of the values (temporal_valueset) ─────────
query I
SELECT typeof(getValues('{47c3c3@2000-01-01}'::ts2cell));
----
s2cellset

query I
SELECT numValues(getValues('{47c3c3@2000-01-01, 47c3c5@2000-01-02}'::ts2cell));
----
2

query I
SELECT asText(getValues('{47c3c3@2000-01-01, 47c3c5@2000-01-02}'::ts2cell));
----
{"47c3c3", "47c3c5"}

# valueAtTimestamp answers the cell a step sequence holds at that time

query I
SELECT valueAtTimestamp(ts2cell '[89c25a3@2000-01-01, 89c25a3@2000-01-02]', TIMESTAMPTZ '2000-01-01 12:00:00')::VARCHAR;
----
89c25a3

# the constructors from a cell and a time value, as MobilityDB answers the
# instant and the span forms (603_ts2cell.test.out); each is read against the
# literal of its answer

query I
SELECT asText(ts2cell(s2cell '47c3c3', TIMESTAMPTZ '2001-01-01'))
     = asText(ts2cell '47c3c3@2001-01-01');
----
true

query I
SELECT asText(ts2cell(s2cell '47c3c3', tstzset '{2001-01-01, 2001-01-02}'))
     = asText(ts2cell '{47c3c3@2001-01-01, 47c3c3@2001-01-02}');
----
true

query I
SELECT asText(ts2cell(s2cell '47c3c3', tstzspan '[2001-01-01, 2001-01-02]'))
     = asText(ts2cell '[47c3c3@2001-01-01, 47c3c3@2001-01-02]');
----
true

query I
SELECT asText(ts2cell(s2cell '47c3c3', tstzspanset '{[2001-01-01, 2001-01-02]}'))
     = asText(ts2cell '{[47c3c3@2001-01-01, 47c3c3@2001-01-02]}');
----
true

# ── the readers of the text and MF-JSON forms ───────────────────────────────
# Each reader answers the value its writer writes.
query II
SELECT ts2cellFromText(asText(t)) = t, ts2cellFromMFJSON(asMFJSON(t)) = t
FROM (SELECT '{47c3c3@2000-01-01, 47c3c5@2000-01-02}'::ts2cell AS t);
----
true	true
