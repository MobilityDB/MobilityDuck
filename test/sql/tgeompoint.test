tgeompoint(ST_Point(1,1), timestamptz '2012-01-01 09:00:00'),
tgeompoint(ST_Point(2,2), timestamptz '2012-01-01 09:10:00'),
tgeompoint(ST_Point(1,1), timestamptz '2012-01-01 09:20:00')
])]));
