48

query I
SELECT memSize(tstzset '{2000-01-01}');
----
32

query I
SELECT memSize(tstzset '{2000-01-01, 2000-01-02, 2000-01-03}');
----
48

query I
SELECT span(dateset '{2000-01-01}');
