require mobilityduck

query I
SELECT intspan('[1,2]');
----
[1, 3)

query I
SELECT intspan ('(1,2]');
----
[2, 3)

query I
SELECT tstzspan('[2000-01-01,2000-01-01]');
----
[2000-01-01 00:00:00+00, 2000-01-01 00:00:00+00]

query I
SELECT tstzspan('[2000-01-01,2000-01-03]') @> timestamptz '2000-01-02';
----
true

query I
SELECT tstzspan('[2000-01-01,2000-01-03]') @> timestamptz '2000-01-10';
----
false

query I
SELECT intspan '[1, 3]' * intspan '[3, 5]';
----
[3, 4)

query I
SELECT bigintspan '[1000, 3000]' * bigintspan '[3000, 5000]';
----
[3000, 3001)

query I
SELECT floatspan '[1, 3]' * floatspan '[1, 3]';
----
[1, 3]

query I
SELECT floatspan '[1, 3]' * floatspan '(3, 5]';
----
NULL

query I
SELECT datespan '[2000-01-01,2000-01-02]' * datespan '[2000-01-01,2000-01-02]';
----
[2000-01-01, 2000-01-03)

query I
SELECT tstzspan '[2000-01-01, 2000-01-05]' * tstzspan '[2000-01-03, 2000-01-08]';
----
[2000-01-03 00:00:00+00, 2000-01-05 00:00:00+00]

query I
SELECT intspan '[1, 2]' && intspan '[2, 3]';
----
true

query I
SELECT intspan '[1, 2]' && intspan '(2, 3]';
----
false

query I
SELECT bigintspan '[10000, 20000]' && bigintspan '[15000, 30000]';
----
true

query I
SELECT bigintspan '[10000, 20000]' && bigintspan '[25000, 30000]';
----
false

query I
SELECT floatspan '[1.5, 2.5]' && floatspan '[-0.5, 1.7]';
----
true

query I
SELECT floatspan '[1.5, 2.5]' && floatspan '(2.5, 4.5]';
----
false

query I
SELECT datespan '[2000-01-01,2000-01-03]' && datespan '[2000-01-02,2000-01-04]';
----
true

query I
SELECT datespan '[2000-01-01,2000-01-03]' && datespan '[2000-01-04,2000-01-04]';
----
false

query I
SELECT tstzspan '[2000-01-01 08:00:00+05, 2000-01-01 08:00:00+00]' && tstzspan '[2000-01-01 08:00:00+07, 2000-01-01 08:00:00+02]';
----
true

query I
SELECT tstzspan '[2000-01-01 08:00:00+05, 2000-01-01 08:00:00+00]' && tstzspan '[2000-01-01 08:00:00+07, 2000-01-01 08:00:00+06]';
----
false

# Binary span constructor (MobilityDB-compatible bounds); 2-arg defaults to [)
query I
SELECT asText(span(1, 2));
----
[1, 2)

query I
SELECT asText(span(1, 2, true, false));
----
[1, 2)

query I
SELECT asText(span(1, 2, true, true));
----
[1, 3)

query I
SELECT asText(span(timestamptz '2000-01-01', timestamptz '2000-01-02'));
----
[2000-01-01 00:00:00+00, 2000-01-02 00:00:00+00)

query I
SELECT asText(span(timestamptz '2000-01-01', timestamptz '2000-01-01', true, true));
----
[2000-01-01 00:00:00+00, 2000-01-01 00:00:00+00]