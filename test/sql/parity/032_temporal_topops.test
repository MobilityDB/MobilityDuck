# name: test/sql/parity/032_temporal_topops.test
# description: MobilityDB regression file 032_temporal_topops.test.sql adapted for MobilityDuck
# group: [sql]
#
# Topological operators (`@>`, `<@`, `&&`, `-|-`) between temporal and
# {value, span, spanset, tbox, temporal} pairs.
#
# Registered and active:
#   temporal && temporal  (overlaps_temporal_temporal)
#   temporal @> tbox      (contains_tnumber_tbox)
#   temporal -|- tstzspan (adjacent_temporal_tstzspan)
#
# Individually skipped (no MEOS symbol for raw scalar ↔ temporal):
#   temporal @> value     (needs contains_tnumber_value — not in meos.h)
#   value <@ temporal     (needs contained_value_tnumber — not in meos.h)
#   Workaround: convert value to a unit span/tbox first.

require mobilityduck

mode skip
# temporal @> value — MEOS exposes contains_tnumber_numspan but not
# contains_tnumber_value; a raw scalar overload is not yet implemented.
query I
SELECT tint '[1@2000-01-01, 5@2000-01-05]' @> 3;
----
true
mode unskip

mode skip
# value <@ temporal — same gap as @> above; contained_value_tnumber
# is not in meos.h.
query I
SELECT 3 <@ tint '[1@2000-01-01, 5@2000-01-05]';
----
true
mode unskip

# temporal && temporal

query I
SELECT tint '[1@2000-01-01, 5@2000-01-05]' && tint '[3@2000-01-03, 7@2000-01-07]';
----
true

# temporal @> tbox

query I
SELECT tint '[1@2000-01-01, 10@2000-01-10]' @> tbox 'TBOXINT XT([2,5],[2000-01-02,2000-01-05])';
----
true

# temporal -|- tstzspan

query I
SELECT tint '[1@2000-01-01, 5@2000-01-05]' -|- tstzspan '[2000-01-05, 2000-01-06]';
----
true
