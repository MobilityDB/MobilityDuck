# name: test/sql/parity/093_split_n_boxes.test
# description: The split-into-N box and span accessors — splitNStboxes /
#              splitNTboxes / splitNSpans and their splitEachN twins, which
#              return at most N bounding boxes over a temporal value, set or
#              spanset instead of one box per segment.
# group: [sql]

require mobilityduck

# A 5-instant trajectory whose points are not collinear, so normalization keeps
# all four segments: stboxes returns one box per segment.

query I
SELECT len(stboxes(tgeompoint '[POINT(1 1)@2000-01-01 00:00:00+00, POINT(5 2)@2000-01-02 00:00:00+00, POINT(2 6)@2000-01-03 00:00:00+00, POINT(9 3)@2000-01-04 00:00:00+00, POINT(4 8)@2000-01-05 00:00:00+00]'));
----
4

# splitNStboxes bounds the count: N boxes over the same four segments.

query III
SELECT len(splitNStboxes(g, 1)), len(splitNStboxes(g, 2)), len(splitNStboxes(g, 4))
FROM (SELECT tgeompoint '[POINT(1 1)@2000-01-01 00:00:00+00, POINT(5 2)@2000-01-02 00:00:00+00, POINT(2 6)@2000-01-03 00:00:00+00, POINT(9 3)@2000-01-04 00:00:00+00, POINT(4 8)@2000-01-05 00:00:00+00]' AS g);
----
1	2	4

query I
SELECT splitNStboxes(tgeompoint '[POINT(1 1)@2000-01-01 00:00:00+00, POINT(5 2)@2000-01-02 00:00:00+00, POINT(2 6)@2000-01-03 00:00:00+00, POINT(9 3)@2000-01-04 00:00:00+00, POINT(4 8)@2000-01-05 00:00:00+00]', 2)::text;
----
['STBOX XT(((1,1),(5,6)),[2000-01-01 01:00:00+01, 2000-01-03 01:00:00+01])', 'STBOX XT(((2,3),(9,8)),[2000-01-03 01:00:00+01, 2000-01-05 01:00:00+01])']

# splitEachNStboxes merges a fixed number of segments per box instead: with 3,
# the first box covers segments 1-3 and the second covers the remaining one.

query I
SELECT splitEachNStboxes(tgeompoint '[POINT(1 1)@2000-01-01 00:00:00+00, POINT(5 2)@2000-01-02 00:00:00+00, POINT(2 6)@2000-01-03 00:00:00+00, POINT(9 3)@2000-01-04 00:00:00+00, POINT(4 8)@2000-01-05 00:00:00+00]', 3)::text;
----
['STBOX XT(((1,1),(9,6)),[2000-01-01 01:00:00+01, 2000-01-04 01:00:00+01])', 'STBOX XT(((4,3),(9,8)),[2000-01-04 01:00:00+01, 2000-01-05 01:00:00+01])']

# splitNSpans over a set and over a spanset: the value spans.

query I
SELECT splitNSpans(intset '{1,3,5,7}', 2)::text;
----
['[1, 4)', '[5, 8)']

query I
SELECT splitNSpans(intspanset '{[1,3),[5,9)}', 2)::text;
----
['[1, 3)', '[5, 9)']

query I
SELECT splitEachNSpans(intset '{1,3,5,7}', 2)::text;
----
['[1, 4)', '[5, 8)']

# splitNSpans over a temporal value returns the time spans, not value spans.

query I
SELECT splitNSpans(tint '[1@2000-01-01 00:00:00+00, 3@2000-01-02 00:00:00+00, 2@2000-01-03 00:00:00+00]', 2)::text;
----
['[2000-01-01 01:00:00+01, 2000-01-02 01:00:00+01]', '[2000-01-02 01:00:00+01, 2000-01-03 01:00:00+01]']

# splitNTboxes over the temporal numbers, carrying both the value and the time
# dimension.

query I
SELECT splitNTboxes(tint '[1@2000-01-01 00:00:00+00, 3@2000-01-02 00:00:00+00, 2@2000-01-03 00:00:00+00]', 2)::text;
----
['TBOXINT XT([1, 4),[2000-01-01 01:00:00+01, 2000-01-02 01:00:00+01])', 'TBOXINT XT([2, 4),[2000-01-02 01:00:00+01, 2000-01-03 01:00:00+01])']

query I
SELECT splitNTboxes(tfloat '[1.5@2000-01-01 00:00:00+00, 3.5@2000-01-02 00:00:00+00, 2.5@2000-01-03 00:00:00+00]', 2)::text;
----
['TBOXFLOAT XT([1.5, 3.5],[2000-01-01 01:00:00+01, 2000-01-02 01:00:00+01])', 'TBOXFLOAT XT([2.5, 3.5],[2000-01-02 01:00:00+01, 2000-01-03 01:00:00+01])']

query I
SELECT splitEachNTboxes(tint '[1@2000-01-01 00:00:00+00, 3@2000-01-02 00:00:00+00, 2@2000-01-03 00:00:00+00]', 2)::text;
----
['TBOXINT XT([1, 4),[2000-01-01 01:00:00+01, 2000-01-03 01:00:00+01])']

# NULL in either argument yields a NULL list.

query II
SELECT splitNStboxes(NULL::tgeompoint, 2), splitNStboxes(tgeompoint '[POINT(1 1)@2000-01-01 00:00:00+00, POINT(5 2)@2000-01-02 00:00:00+00]', NULL);
----
NULL	NULL

# The type set comes from the catalog signatures, so the accessors cover every
# type MobilityDB declares them for, not only the ones their MEOS name mentions.
# tcbuffer is one of the six types `stboxes` is declared for: the boxes carry the
# buffer radius, so each one is the segment's extent expanded by that radius.

query III
SELECT len(stboxes(c)), len(splitNStboxes(c, 2)), len(splitEachNStboxes(c, 3))
FROM (SELECT tcbuffer '[Cbuffer(POINT(1 1),0.5)@2000-01-01 00:00:00+00, Cbuffer(POINT(5 2),1)@2000-01-02 00:00:00+00, Cbuffer(POINT(2 6),0.5)@2000-01-03 00:00:00+00, Cbuffer(POINT(9 3),2)@2000-01-04 00:00:00+00, Cbuffer(POINT(4 8),1)@2000-01-05 00:00:00+00]' AS c);
----
4	2	2

query I
SELECT splitNStboxes(tcbuffer '[Cbuffer(POINT(1 1),0.5)@2000-01-01 00:00:00+00, Cbuffer(POINT(5 2),1)@2000-01-02 00:00:00+00, Cbuffer(POINT(2 6),0.5)@2000-01-03 00:00:00+00, Cbuffer(POINT(9 3),2)@2000-01-04 00:00:00+00, Cbuffer(POINT(4 8),1)@2000-01-05 00:00:00+00]', 2)::text;
----
['STBOX XT(((0.5,0.5),(6,6.5)),[2000-01-01 01:00:00+01, 2000-01-03 01:00:00+01])', 'STBOX XT(((1.5,1),(11,9)),[2000-01-03 01:00:00+01, 2000-01-05 01:00:00+01])']

query I
SELECT splitEachNStboxes(tcbuffer '[Cbuffer(POINT(1 1),0.5)@2000-01-01 00:00:00+00, Cbuffer(POINT(5 2),1)@2000-01-02 00:00:00+00, Cbuffer(POINT(2 6),0.5)@2000-01-03 00:00:00+00, Cbuffer(POINT(9 3),2)@2000-01-04 00:00:00+00, Cbuffer(POINT(4 8),1)@2000-01-05 00:00:00+00]', 3)::text;
----
['STBOX XT(((0.5,0.5),(11,6.5)),[2000-01-01 01:00:00+01, 2000-01-04 01:00:00+01])', 'STBOX XT(((3,1),(11,9)),[2000-01-04 01:00:00+01, 2000-01-05 01:00:00+01])']

# tbigint completes the tnumber box family the same way — declared alongside
# tint and tfloat, and now registered with them.

query I
SELECT tboxes(tbigint '[1@2000-01-01 00:00:00+00, 3@2000-01-02 00:00:00+00, 2@2000-01-03 00:00:00+00]')::text;
----
['TBOXBIGINT XT([1, 4),[2000-01-01 01:00:00+01, 2000-01-02 01:00:00+01])', 'TBOXBIGINT XT([2, 4),[2000-01-02 01:00:00+01, 2000-01-03 01:00:00+01])']

query I
SELECT splitNTboxes(tbigint '[1@2000-01-01 00:00:00+00, 3@2000-01-02 00:00:00+00, 2@2000-01-03 00:00:00+00]', 2)::text;
----
['TBOXBIGINT XT([1, 4),[2000-01-01 01:00:00+01, 2000-01-02 01:00:00+01])', 'TBOXBIGINT XT([2, 4),[2000-01-02 01:00:00+01, 2000-01-03 01:00:00+01])']

query I
SELECT splitEachNTboxes(tbigint '[1@2000-01-01 00:00:00+00, 3@2000-01-02 00:00:00+00, 2@2000-01-03 00:00:00+00]', 2)::text;
----
['TBOXBIGINT XT([1, 4),[2000-01-01 01:00:00+01, 2000-01-03 01:00:00+01])']
