# name: test/sql/parquet/temporal_parquet.test
# description: TemporalParquet round-trip — write MEOS-WKB to Parquet, read back, query
# group: [sql]

require mobilityduck

require parquet

# =============================================================================
# tgeompoint — write asBinary() to Parquet, reconstruct with tgeompointFromBinary
# =============================================================================

statement ok
COPY (
  SELECT 1                                                                         AS vessel_id,
         asBinary(tgeompoint '[POINT(12.6 56.0)@2026-01-01 00:00:00+00,
                               POINT(12.8 56.2)@2026-01-01 02:00:00+00]')        AS traj
  UNION ALL
  SELECT 2,
         asBinary(tgeompoint '{POINT(11.5 55.5)@2026-01-01 00:00:00+00,
                               POINT(11.6 55.6)@2026-01-01 03:00:00+00}')
)
TO '__TEST_DIR__/tgeompoint.parquet' (FORMAT PARQUET)

# The Parquet schema must show BLOB columns for temporal data
query T
SELECT type FROM parquet_schema('__TEST_DIR__/tgeompoint.parquet')
WHERE name = 'traj'
----
BYTE_ARRAY

# Round-trip: text representation must survive Parquet storage
query IT nosort tgp_roundtrip
SELECT vessel_id, asText(tgeompointFromBinary(traj))
FROM read_parquet('__TEST_DIR__/tgeompoint.parquet')
ORDER BY vessel_id

query IT nosort tgp_roundtrip
SELECT vessel_id, asText(traj)
FROM (
  SELECT vessel_id, tgeompointFromBinary(traj) AS traj
  FROM read_parquet('__TEST_DIR__/tgeompoint.parquet')
)
ORDER BY vessel_id

# Temporal predicates on Parquet-resident data
query I
SELECT count(*)
FROM (
  SELECT tgeompointFromBinary(traj) AS traj
  FROM read_parquet('__TEST_DIR__/tgeompoint.parquet')
)
WHERE numInstants(traj) >= 1
----
2

# =============================================================================
# tint
# =============================================================================

statement ok
COPY (
  SELECT 1 AS id, asBinary(tint '[1@2000-01-01, 2@2000-01-02, 3@2000-01-03]') AS val
  UNION ALL
  SELECT 2,       asBinary(tint '{5@2000-01-01, 10@2000-01-05}')
)
TO '__TEST_DIR__/tint.parquet' (FORMAT PARQUET)

query IT
SELECT id, tintFromBinary(val)::VARCHAR
FROM read_parquet('__TEST_DIR__/tint.parquet')
ORDER BY id
----
1	[1@2000-01-01 00:00:00+01, 2@2000-01-02 00:00:00+01, 3@2000-01-03 00:00:00+01]
2	{5@2000-01-01 00:00:00+01, 10@2000-01-05 00:00:00+01}

# minValue/maxValue survive the round-trip
query II
SELECT minValue(tintFromBinary(val)), maxValue(tintFromBinary(val))
FROM read_parquet('__TEST_DIR__/tint.parquet')
WHERE id = 1
----
1	3

# =============================================================================
# tfloat
# =============================================================================

statement ok
COPY (
  SELECT 1 AS id, asBinary(tfloat '[1.5@2000-01-01, 3.5@2000-01-02]') AS val
)
TO '__TEST_DIR__/tfloat.parquet' (FORMAT PARQUET)

query IT
SELECT id, tfloatFromBinary(val)::VARCHAR
FROM read_parquet('__TEST_DIR__/tfloat.parquet')
ORDER BY id
----
1	[1.5@2000-01-01 00:00:00+01, 3.5@2000-01-02 00:00:00+01]

# =============================================================================
# tbool
# =============================================================================

statement ok
COPY (
  SELECT 1 AS id, asBinary(tbool '[t@2000-01-01, f@2000-01-02]') AS val
)
TO '__TEST_DIR__/tbool.parquet' (FORMAT PARQUET)

query IT
SELECT id, tboolFromBinary(val)::VARCHAR
FROM read_parquet('__TEST_DIR__/tbool.parquet')
ORDER BY id
----
1	[t@2000-01-01 00:00:00+01, f@2000-01-02 00:00:00+01]

# =============================================================================
# ttext
# =============================================================================

statement ok
COPY (
  SELECT 1 AS id, asBinary(ttext '[hello@2000-01-01, world@2000-01-02]') AS val
)
TO '__TEST_DIR__/ttext.parquet' (FORMAT PARQUET)

query IT
SELECT id, ttextFromBinary(val)::VARCHAR
FROM read_parquet('__TEST_DIR__/ttext.parquet')
ORDER BY id
----
1	["hello"@2000-01-01 00:00:00+01, "world"@2000-01-02 00:00:00+01]

# =============================================================================
# Mixed temporal data lake shard: multiple types in one Parquet file
# =============================================================================

statement ok
COPY (
  SELECT
    42                                                                             AS sensor_id,
    asBinary(tfloat '[0.1@2026-01-01 00:00:00+00, 0.9@2026-01-01 01:00:00+00]') AS temperature,
    asBinary(tbool  '[t@2026-01-01 00:00:00+00, f@2026-01-01 00:30:00+00]')     AS active,
    asBinary(tgeompoint '[POINT(5 52)@2026-01-01 00:00:00+00,
                          POINT(6 53)@2026-01-01 01:00:00+00]')                  AS position
)
TO '__TEST_DIR__/mixed.parquet' (FORMAT PARQUET)

# All three columns survive the round-trip and temporal functions work
query T
SELECT asText(tgeompointFromBinary(position))
FROM read_parquet('__TEST_DIR__/mixed.parquet')
----
[POINT(5 52)@2026-01-01 01:00:00+01, POINT(6 53)@2026-01-01 02:00:00+01]

query T
SELECT tfloatFromBinary(temperature)::VARCHAR
FROM read_parquet('__TEST_DIR__/mixed.parquet')
----
[0.1@2026-01-01 01:00:00+01, 0.9@2026-01-01 02:00:00+01]

query T
SELECT tboolFromBinary(active)::VARCHAR
FROM read_parquet('__TEST_DIR__/mixed.parquet')
----
[t@2026-01-01 01:00:00+01, f@2026-01-01 01:30:00+01]

# =============================================================================
# tgeogpoint — geodetic (spheroidal) round-trip; asBinary must preserve type tag
# =============================================================================

statement ok
COPY (
  SELECT 1 AS vessel_id,
         asBinary(tgeogpointSeq(
           list(TGEOGPOINT(ST_Point(lon, lat), ts) ORDER BY ts)
         )) AS traj
  FROM (VALUES
    (4.35, 50.85, TIMESTAMPTZ '2026-01-01 00:00:00+00'),
    (5.57, 50.63, TIMESTAMPTZ '2026-01-01 02:00:00+00')
  ) t(lon, lat, ts)
)
TO '__TEST_DIR__/tgeogpoint.parquet' (FORMAT PARQUET)

# Must land as BYTE_ARRAY
query T
SELECT type FROM parquet_schema('__TEST_DIR__/tgeogpoint.parquet')
WHERE name = 'traj'
----
BYTE_ARRAY

# Geodetic length survives round-trip: Brussels→Liège ~89500 m
query I
SELECT round(length(tgeogpointFromBinary(traj)) / 1000) AS length_km
FROM read_parquet('__TEST_DIR__/tgeogpoint.parquet')
WHERE vessel_id = 1
----
90

# =============================================================================
# tgeogpoint — geodetic (spheroidal) round-trip; asBinary must preserve type tag
# =============================================================================

statement ok
COPY (
  SELECT 1 AS vessel_id,
         asBinary(tgeogpointSeq(
           list(TGEOGPOINT(ST_Point(lon, lat), ts) ORDER BY ts)
         )) AS traj
  FROM (VALUES
    (4.35, 50.85, TIMESTAMPTZ '2026-01-01 00:00:00+00'),
    (5.57, 50.63, TIMESTAMPTZ '2026-01-01 02:00:00+00')
  ) t(lon, lat, ts)
)
TO '__TEST_DIR__/tgeogpoint.parquet' (FORMAT PARQUET)

# Must land as BYTE_ARRAY
query T
SELECT type FROM parquet_schema('__TEST_DIR__/tgeogpoint.parquet')
WHERE name = 'traj'
----
BYTE_ARRAY

# Geodetic length survives round-trip: Brussels→Liège ~89500 m
query I
SELECT round(length(tgeogpointFromBinary(traj)) / 1000) AS length_km
FROM read_parquet('__TEST_DIR__/tgeogpoint.parquet')
WHERE vessel_id = 1
----
90

# =============================================================================
# temporalFooter — JSON metadata builder for KV_METADATA embedding
# =============================================================================

# A geodetic column: spherical edges, a bbox and a tspan covering
query T
SELECT temporalFooter(MAP {'traj': 'tgeogpoint'})
----
{"version":"2.0.0","columns":{"traj":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tgeogpoint","edges":"spherical","geodetic":true,"covering":{"bbox":{"xmin":["traj_bbox","xmin"],"ymin":["traj_bbox","ymin"],"xmax":["traj_bbox","xmax"],"ymax":["traj_bbox","ymax"]},"tspan":{"tmin":["traj_tspan","tmin"],"tmax":["traj_tspan","tmax"]}}}}}

# A numeric and a planar column, in insertion order
query T
SELECT temporalFooter(MAP {'temperature': 'tfloat', 'position': 'tgeompoint'})
----
{"version":"2.0.0","columns":{"temperature":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tfloat","covering":{"vspan":{"vmin":["temperature_vspan","vmin"],"vmax":["temperature_vspan","vmax"]},"tspan":{"tmin":["temperature_tspan","tmin"],"tmax":["temperature_tspan","tmax"]}}},"position":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tgeompoint","edges":"planar","geodetic":false,"covering":{"bbox":{"xmin":["position_bbox","xmin"],"ymin":["position_bbox","ymin"],"xmax":["position_bbox","xmax"],"ymax":["position_bbox","ymax"]},"tspan":{"tmin":["position_tspan","tmin"],"tmax":["position_tspan","tmax"]}}}}}

# A time-only column carries a tspan covering and nothing spatial
query T
SELECT temporalFooter(MAP {'active': 'tbool'})
----
{"version":"2.0.0","columns":{"active":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tbool","covering":{"tspan":{"tmin":["active_tspan","tmin"],"tmax":["active_tspan","tmax"]}}}}}

# A column that is not a temporal type carries no covering and no edges
query T
SELECT temporalFooter(MAP {'period': 'tstzspan'})
----
{"version":"2.0.0","columns":{"period":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tstzspan"}}}

# A column name is written as a JSON string, whatever it holds
query T
SELECT temporalFooter(MAP {'a"b\c': 'tstzspan'})
----
{"version":"2.0.0","columns":{"a\"b\\c":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tstzspan"}}}

# Every temporal base type the MEOS-API covering descriptor lists, each with the
# edges and the coverings its base type fixes, and two types it lists none for
query TT
SELECT t, temporalFooter(MAP {'col': t})
FROM (VALUES ('tgeompoint'), ('tgeogpoint'), ('tgeometry'), ('tgeography'), ('tcbuffer'),
             ('tnpoint'), ('tpose'), ('trgeometry'), ('tint'), ('tfloat'), ('tbigint'),
             ('tbool'), ('ttext'), ('tposechain'), ('tstzspan')) v(t)
ORDER BY t
----
tbigint	{"version":"2.0.0","columns":{"col":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tbigint","covering":{"vspan":{"vmin":["col_vspan","vmin"],"vmax":["col_vspan","vmax"]},"tspan":{"tmin":["col_tspan","tmin"],"tmax":["col_tspan","tmax"]}}}}}
tbool	{"version":"2.0.0","columns":{"col":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tbool","covering":{"tspan":{"tmin":["col_tspan","tmin"],"tmax":["col_tspan","tmax"]}}}}}
tcbuffer	{"version":"2.0.0","columns":{"col":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tcbuffer","covering":{"bbox":{"xmin":["col_bbox","xmin"],"ymin":["col_bbox","ymin"],"xmax":["col_bbox","xmax"],"ymax":["col_bbox","ymax"]},"tspan":{"tmin":["col_tspan","tmin"],"tmax":["col_tspan","tmax"]}}}}}
tfloat	{"version":"2.0.0","columns":{"col":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tfloat","covering":{"vspan":{"vmin":["col_vspan","vmin"],"vmax":["col_vspan","vmax"]},"tspan":{"tmin":["col_tspan","tmin"],"tmax":["col_tspan","tmax"]}}}}}
tgeogpoint	{"version":"2.0.0","columns":{"col":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tgeogpoint","edges":"spherical","geodetic":true,"covering":{"bbox":{"xmin":["col_bbox","xmin"],"ymin":["col_bbox","ymin"],"xmax":["col_bbox","xmax"],"ymax":["col_bbox","ymax"]},"tspan":{"tmin":["col_tspan","tmin"],"tmax":["col_tspan","tmax"]}}}}}
tgeography	{"version":"2.0.0","columns":{"col":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tgeography","edges":"spherical","geodetic":true,"covering":{"bbox":{"xmin":["col_bbox","xmin"],"ymin":["col_bbox","ymin"],"xmax":["col_bbox","xmax"],"ymax":["col_bbox","ymax"]},"tspan":{"tmin":["col_tspan","tmin"],"tmax":["col_tspan","tmax"]}}}}}
tgeometry	{"version":"2.0.0","columns":{"col":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tgeometry","edges":"planar","geodetic":false,"covering":{"bbox":{"xmin":["col_bbox","xmin"],"ymin":["col_bbox","ymin"],"xmax":["col_bbox","xmax"],"ymax":["col_bbox","ymax"]},"tspan":{"tmin":["col_tspan","tmin"],"tmax":["col_tspan","tmax"]}}}}}
tgeompoint	{"version":"2.0.0","columns":{"col":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tgeompoint","edges":"planar","geodetic":false,"covering":{"bbox":{"xmin":["col_bbox","xmin"],"ymin":["col_bbox","ymin"],"xmax":["col_bbox","xmax"],"ymax":["col_bbox","ymax"]},"tspan":{"tmin":["col_tspan","tmin"],"tmax":["col_tspan","tmax"]}}}}}
tint	{"version":"2.0.0","columns":{"col":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tint","covering":{"vspan":{"vmin":["col_vspan","vmin"],"vmax":["col_vspan","vmax"]},"tspan":{"tmin":["col_tspan","tmin"],"tmax":["col_tspan","tmax"]}}}}}
tnpoint	{"version":"2.0.0","columns":{"col":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tnpoint","covering":{"bbox":{"xmin":["col_bbox","xmin"],"ymin":["col_bbox","ymin"],"xmax":["col_bbox","xmax"],"ymax":["col_bbox","ymax"]},"tspan":{"tmin":["col_tspan","tmin"],"tmax":["col_tspan","tmax"]}}}}}
tpose	{"version":"2.0.0","columns":{"col":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tpose","covering":{"bbox":{"xmin":["col_bbox","xmin"],"ymin":["col_bbox","ymin"],"xmax":["col_bbox","xmax"],"ymax":["col_bbox","ymax"]},"tspan":{"tmin":["col_tspan","tmin"],"tmax":["col_tspan","tmax"]}}}}}
tposechain	{"version":"2.0.0","columns":{"col":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tposechain"}}}
trgeometry	{"version":"2.0.0","columns":{"col":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"trgeometry","covering":{"bbox":{"xmin":["col_bbox","xmin"],"ymin":["col_bbox","ymin"],"xmax":["col_bbox","xmax"],"ymax":["col_bbox","ymax"]},"tspan":{"tmin":["col_tspan","tmin"],"tmax":["col_tspan","tmax"]}}}}}
tstzspan	{"version":"2.0.0","columns":{"col":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"tstzspan"}}}
ttext	{"version":"2.0.0","columns":{"col":{"encoding":"MEOS-WKB","encoding_version":"1.0","base_type":"ttext","covering":{"tspan":{"tmin":["col_tspan","tmin"],"tmax":["col_tspan","tmax"]}}}}}

# A shard with its covering columns: the bbox covering is a GeoParquet bounding
# box column (a root struct of DOUBLE fields in GeoParquet order) and the time
# extent is the tspan struct the footer declares
statement ok
COPY (
  SELECT asBinary(traj) AS traj,
         {'xmin': Xmin(stbox(traj)), 'ymin': Ymin(stbox(traj)),
          'xmax': Xmax(stbox(traj)), 'ymax': Ymax(stbox(traj))} AS traj_bbox,
         {'tmin': Tmin(stbox(traj)), 'tmax': Tmax(stbox(traj))} AS traj_tspan
  FROM (SELECT tgeompoint '[POINT(5 52)@2026-01-01 00:00:00+00,
                            POINT(6 53)@2026-01-01 01:00:00+00]' AS traj)
)
TO '__TEST_DIR__/covered.parquet' (
    FORMAT PARQUET,
    KV_METADATA {'temporal': temporalFooter(MAP {'traj': 'tgeompoint'})}
)

query TT nosort
SELECT name, type FROM parquet_schema('__TEST_DIR__/covered.parquet')
WHERE name IN ('traj', 'xmin', 'ymin', 'xmax', 'ymax', 'tmin', 'tmax')
----
traj	BYTE_ARRAY
xmin	DOUBLE
ymin	DOUBLE
xmax	DOUBLE
ymax	DOUBLE
tmin	INT64
tmax	INT64

query I
SELECT count(*) FROM read_parquet('__TEST_DIR__/covered.parquet')
WHERE traj_bbox.xmax >= 5.5 AND traj_bbox.ymin <= 52.5
  AND traj_tspan.tmin <= TIMESTAMPTZ '2026-01-01 00:30:00+00'
----
1

query T
SELECT value = temporalFooter(MAP {'traj': 'tgeompoint'})::BLOB AS ok
FROM parquet_kv_metadata('__TEST_DIR__/covered.parquet')
WHERE key = 'temporal'::BLOB
----
true

# KV_METADATA round-trip: footer survives Parquet file-level metadata
statement ok
COPY (SELECT 1 AS id)
TO '__TEST_DIR__/footer_meta.parquet' (
    FORMAT PARQUET,
    KV_METADATA {'temporal': temporalFooter(MAP {'traj': 'tgeogpoint'})}
)

query T
SELECT value = temporalFooter(MAP {'traj': 'tgeogpoint'})::BLOB AS ok
FROM parquet_kv_metadata('__TEST_DIR__/footer_meta.parquet')
WHERE key = 'temporal'::BLOB
----
true
