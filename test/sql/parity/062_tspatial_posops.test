# name: test/sql/parity/062_tspatial_posops.test
# description: Tspatial × {stbox, tspatial} position predicates — left/right/
#              below/above/front/back (and over* variants), plus the
#              time-axis before/after/overbefore/overafter, under the
#              stbox-prefixed names, and the operator form where DuckDB lexes one.
# group: [sql]

require mobilityduck

# X-axis: left / overright

query I
SELECT stboxLeft(tgeompoint '[POINT(0 0)@2000-01-01]', stbox 'STBOX X((5, 0), (10, 5))');
----
true

query I
SELECT stboxOverright(tgeompoint '[POINT(10 10)@2000-01-01]', stbox 'STBOX X((0, 0), (10, 10))');
----
true

# Operator vs named function

query I
SELECT (tgeompoint '[POINT(0 0)@2000-01-01]' << stbox 'STBOX X((5, 0), (10, 5))')
     = stboxLeft(tgeompoint '[POINT(0 0)@2000-01-01]', stbox 'STBOX X((5, 0), (10, 5))');
----
true

# Y-axis (named-only)

query I
SELECT stboxBelow(tgeompoint '[POINT(0 0)@2000-01-01]', stbox 'STBOX X((0, 5), (10, 10))');
----
true

query I
SELECT stboxAbove(stbox 'STBOX X((0, 0), (10, 5))', tgeompoint '[POINT(5 10)@2000-01-01]');
----
false

# Z-axis: requires 3D inputs

query I
SELECT stboxFront(tgeompoint '[POINT Z (0 0 0)@2000-01-01]', stbox 'STBOX Z((0, 0, 5), (10, 10, 10))');
----
true

# tspatial × tspatial

query I
SELECT stboxLeft(tgeompoint '[POINT(0 0)@2000-01-01]',
                     tgeompoint '[POINT(5 5)@2000-01-01, POINT(10 10)@2000-01-02]');
----
true

# Time-axis: before / overafter

query I
SELECT stboxBefore(tgeompoint '[POINT(5 5)@2000-01-01]',
                       stbox 'STBOX XT(((0, 0), (10, 10)), [2000-01-02, 2000-01-03])');
----
true

query I
SELECT stboxOverafter(tgeompoint '[POINT(5 5)@2000-01-03]',
                          stbox 'STBOX XT(((0, 0), (10, 10)), [2000-01-01, 2000-01-02])');
----
true

# tspatial × tspatial time-axis

query I
SELECT stboxAfter(tgeompoint '[POINT(5 5)@2000-01-03]',
                      tgeompoint '[POINT(0 0)@2000-01-01]');
----
true
