# name: test/sql/parity/009_time_ops.test
# description: MobilityDB regression file 009_time_ops.test.sql adapted for MobilityDuck
# group: [sql]
#
# Time-only specialisations of operators between tstzset / tstzspan
# and timestamptz / interval:
# - The shift of a tstzset and a tstzspan by an interval, shift(tstzset | tstzspan, interval)
# - Distance operator <-> answering the seconds between two times, as a float

require mobilityduck

# shift(tstzset | tstzspan, interval)

query I
SELECT shift(tstzset '{2000-01-01}', interval '1 day');
----
{"2000-01-02 00:00:00+01"}

query I
SELECT shift(tstzspan '[2000-01-01, 2000-01-02]', interval '1 day');
----
[2000-01-02 00:00:00+01, 2000-01-03 00:00:00+01]

# Time-difference distance: MobilityDB declares spanDistance(tstzspan, tstzspan) RETURNS interval,
# the interval between the two operands. Expected values from
# mobilitydb/test/temporal/expected/009_time_ops.test.out at the line cited.

# 009_time_ops.test.out:1435
query I
SELECT timestamptz '2001-01-01' <-> tstzset '{2001-01-02, 2001-01-03, 2001-01-05}';
----
1 day

# 009_time_ops.test.out:1495
query I
SELECT timestamptz '2001-01-05' <-> tstzspan '[2001-01-01, 2001-01-03]';
----
2 days
