SELECT raster(from_hex('53520307020000000300000002000000000000000000F0FF28B52FFD20607D0100E8000080FF0001000200FF7F06000700080009000A000B000000000000000B1000030F3CF0C063C61D786066D9DA36'), 0, 0, meta_none())
----
