# name: test/sql/parity/025_temporal_bins.test
# description: the bins and boxes of a span, a span set and a temporal number, and avgValue
# group: [sql]
#
# Each query is one of mobilitydb/test/temporal/queries/025_temporal_tile.test.sql and each
# answer the one of its expected output, read in the time zone of MobilityDB's suite
# (America/Los_Angeles), one row per element of the answer. A call MobilityDB makes with
# three arguments carries its fourth, borderInc, at its SQL default TRUE.

require mobilityduck

statement ok
SET TimeZone='America/Los_Angeles'

# MobilityDB: SELECT bins(intspan '[1, 10]', 2) LIMIT 3;
query I
SELECT unnest(bins(intspan '[1, 10]', 2))::VARCHAR
----
[0, 2)
[2, 4)
[4, 6)
[6, 8)
[8, 10)
[10, 12)

# MobilityDB: SELECT bins(intspan '[1, 10]', 2, 1) LIMIT 3;
query I
SELECT unnest(bins(intspan '[1, 10]', 2, 1, TRUE))::VARCHAR
----
[1, 3)
[3, 5)
[5, 7)
[7, 9)
[9, 11)

# MobilityDB: SELECT bins(intspan '[15, 25]', 2);
query I
SELECT unnest(bins(intspan '[15, 25]', 2))::VARCHAR
----
[14, 16)
[16, 18)
[18, 20)
[20, 22)
[22, 24)
[24, 26)

# MobilityDB: SELECT bins(bigintspan '[1, 10]', 2) LIMIT 3;
query I
SELECT unnest(bins(bigintspan '[1, 10]', 2))::VARCHAR
----
[0, 2)
[2, 4)
[4, 6)
[6, 8)
[8, 10)
[10, 12)

# MobilityDB: SELECT bins(bigintspan '[1, 10]', 2, 1) LIMIT 3;
query I
SELECT unnest(bins(bigintspan '[1, 10]', 2, 1, TRUE))::VARCHAR
----
[1, 3)
[3, 5)
[5, 7)
[7, 9)
[9, 11)

# MobilityDB: SELECT bins(floatspan '(1, 10)', 2.5) LIMIT 3;
query I
SELECT unnest(bins(floatspan '(1, 10)', 2.5))::VARCHAR
----
[0, 2.5)
[2.5, 5)
[5, 7.5)
[7.5, 10)

# MobilityDB: SELECT bins(floatspan '(1, 10)', 2.5, 1.5) LIMIT 3;
query I
SELECT unnest(bins(floatspan '(1, 10)', 2.5, 1.5, TRUE))::VARCHAR
----
[-1, 1.5)
[1.5, 4)
[4, 6.5)
[6.5, 9)
[9, 11.5)

# MobilityDB: SELECT bins(datespan '[2001-01-01, 2001-01-10]', '1 week') LIMIT 3;
query I
SELECT unnest(bins(datespan '[2001-01-01, 2001-01-10]', INTERVAL '1 week'))::VARCHAR
----
[2000-12-30, 2001-01-06)
[2001-01-06, 2001-01-13)

# MobilityDB: SELECT bins(datespan '[2001-01-01, 2001-01-10]', '1 week', '2001-01-01') LIMIT 3;
query I
SELECT unnest(bins(datespan '[2001-01-01, 2001-01-10]', INTERVAL '1 week', DATE '2001-01-01', TRUE))::VARCHAR
----
[2001-01-01, 2001-01-08)
[2001-01-08, 2001-01-15)

# MobilityDB: SELECT bins(tstzspan '[2001-01-01, 2001-01-10]', '1 week') LIMIT 3;
query I
SELECT unnest(bins(tstzspan '[2001-01-01, 2001-01-10]', INTERVAL '1 week'))::VARCHAR
----
[2001-01-01 00:00:00-08, 2001-01-08 00:00:00-08)
[2001-01-08 00:00:00-08, 2001-01-15 00:00:00-08)

# MobilityDB: SELECT bins(tstzspan '[2001-01-01, 2001-01-10]', '1 week', '2001-01-01') LIMIT 3;
query I
SELECT unnest(bins(tstzspan '[2001-01-01, 2001-01-10]', INTERVAL '1 week', TIMESTAMPTZ '2001-01-01', TRUE))::VARCHAR
----
[2001-01-01 00:00:00-08, 2001-01-08 00:00:00-08)
[2001-01-08 00:00:00-08, 2001-01-15 00:00:00-08)

# MobilityDB: SELECT bins(datespan '[2001-01-01, 2001-01-10]', '-1 week') LIMIT 3;
statement error
SELECT bins(datespan '[2001-01-01, 2001-01-10]', INTERVAL '-1 week')
----
The interval must be positive: -7 days

# MobilityDB: SELECT bins(intspan '[1, 10]', 0);
statement error
SELECT bins(intspan '[1, 10]', 0)
----
The value must be strictly positive: 0

# MobilityDB: SELECT bins(bigintspan '[1, 10]', 0::bigint);
statement error
SELECT bins(bigintspan '[1, 10]', 0::BIGINT)
----
The value must be strictly positive: 0

# MobilityDB: SELECT bins(floatspan '(1, 10)', 0.0);
statement error
SELECT bins(floatspan '(1, 10)', 0.0)
----
The value must be strictly positive: 0.000000

