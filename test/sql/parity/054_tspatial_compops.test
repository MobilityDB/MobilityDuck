# name: test/sql/parity/054_tspatial_compops.test
# description: Tspatial × {geometry, tspatial} comparison predicates —
#              eEqual / aEqual / eNotEqual / aNotEqual and tEqual /
#              tNotEqual. The MobilityDB operators `?=` / `?<>` / `#=` etc.
#              are unreachable in DuckDB's parser, so only named functions
#              are registered.
# group: [sql]

require mobilityduck

# eEqual across (geo × tgeo, tgeo × geo, tgeo × tgeo)

query I
SELECT eEqual(ST_GeomFromText('POINT(0 0)'), tgeompoint '[POINT(0 0)@2000-01-01]');
----
true

query I
SELECT eEqual(tgeompoint '[POINT(0 0)@2000-01-01, POINT(1 1)@2000-01-02]', ST_GeomFromText('POINT(0 0)'));
----
true

query I
SELECT eEqual(tgeompoint '[POINT(0 0)@2000-01-01]', tgeompoint '[POINT(0 0)@2000-01-01]');
----
true

# aEqual / eNotEqual / aNotEqual

query I
SELECT aEqual(tgeompoint '[POINT(5 5)@2000-01-01]', ST_GeomFromText('POINT(5 5)'));
----
true

query I
SELECT eNotEqual(tgeompoint '[POINT(0 0)@2000-01-01, POINT(1 1)@2000-01-02]', ST_GeomFromText('POINT(0 0)'));
----
true

query I
SELECT aNotEqual(ST_GeomFromText('POINT(5 5)'), tgeompoint '[POINT(0 0)@2000-01-01, POINT(1 1)@2000-01-02]');
----
true

# tEqual returns tbool with t/f along the trajectory

query I
SELECT tEqual(tgeompoint '[POINT(0 0)@2000-01-01]', tgeompoint '[POINT(0 0)@2000-01-01]');
----
[t@2000-01-01 00:00:00+01]

query I
SELECT tEqual(tgeompoint '[POINT(0 0)@2000-01-01]', ST_GeomFromText('POINT(0 0)'));
----
{[t@2000-01-01 00:00:00+01]}

query I
SELECT tNotEqual(ST_GeomFromText('POINT(5 5)'), tgeompoint '[POINT(0 0)@2000-01-01]');
----
{[t@2000-01-01 00:00:00+01]}
