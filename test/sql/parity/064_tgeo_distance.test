# name: test/sql/parity/064_tgeo_distance.test
# description: tgeompoint distance operator parity — mirrors the bound
#              surface of MobilityDB's 064_tgeo_distance.test.sql.
#
#              Registered in MobilityDuck:
#                - <->(tgeompoint, tgeompoint) → tfloat  (all 4 subtype combos)
#                - shortestLine(tgeompoint, tgeompoint) → geometry
#
#              NOT registered (skipped):
#                - <->(geometry, tgeompoint) and <->(tgeompoint, geometry)
#                  — geom/tgeo cross-type distance operator not bound
#                - nad / nearestApproachDistance for tgeompoint
#                  — only registered for tint/tfloat
#                - NearestApproachInstant — not registered
#                - shortestLine(tgeompoint, geometry) — not registered
# group: [sql]

require mobilityduck

# =============================================================================
# <->(tgeompoint, tgeompoint) → tfloat
# =============================================================================

# instant <-> instant: distance = 5 (3-4-5 triangle)
query I
SELECT round(startValue("<->"(tgeompoint 'Point(0 0)@2001-01-01', tgeompoint 'Point(3 4)@2001-01-01')), 6);
----
5.0

# discrete sequence <-> instant
query I
SELECT round(startValue("<->"(tgeompoint '{Point(0 0)@2001-01-01, Point(1 0)@2001-01-02}', tgeompoint 'Point(2 0)@2001-01-01')), 6);
----
2.0

# sequence <-> sequence: constant distance 3 along both trajectories
query I
SELECT CAST("<->"(tgeompoint '[Point(0 0)@2001-01-01, Point(2 0)@2001-01-02]', tgeompoint '[Point(3 0)@2001-01-01, Point(5 0)@2001-01-02]') AS VARCHAR);
----
[3@2001-01-01 00:00:00+00, 3@2001-01-02 00:00:00+00]

query I
SELECT round(startValue("<->"(tgeompoint '[Point(0 0)@2001-01-01, Point(2 0)@2001-01-02]', tgeompoint '[Point(3 0)@2001-01-01, Point(5 0)@2001-01-02]')), 6);
----
3.0

# sequence set <-> instant
query I
SELECT round(startValue("<->"(tgeompoint '{[Point(0 0)@2001-01-01, Point(1 0)@2001-01-02],[Point(2 0)@2001-01-03, Point(3 0)@2001-01-04]}', tgeompoint 'Point(5 0)@2001-01-01')), 6);
----
5.0

# identical points → distance 0
query I
SELECT round(startValue("<->"(tgeompoint 'Point(1 1)@2001-01-01', tgeompoint 'Point(1 1)@2001-01-01')), 6);
----
0.0

# 3D distance
query I
SELECT round(startValue("<->"(tgeompoint 'Point(0 0 0)@2001-01-01', tgeompoint 'Point(1 1 1)@2001-01-01')), 6);
----
1.732051

# =============================================================================
# shortestLine(tgeompoint, tgeompoint) → geometry
# =============================================================================

query I
SELECT ST_AsText(shortestLine(tgeompoint 'Point(0 0)@2001-01-01', tgeompoint 'Point(3 0)@2001-01-01'));
----
LINESTRING (0 0, 3 0)

query I
SELECT ST_AsText(shortestLine(tgeompoint '[Point(0 0)@2001-01-01, Point(2 0)@2001-01-02]', tgeompoint '[Point(0 3)@2001-01-01, Point(2 3)@2001-01-02]'));
----
LINESTRING (0 0, 0 3)

# same point → degenerate linestring
query I
SELECT ST_AsText(shortestLine(tgeompoint 'Point(1 1)@2001-01-01', tgeompoint 'Point(1 1)@2001-01-01'));
----
LINESTRING (1 1, 1 1)

# =============================================================================
# geometry <-> tgeompoint (NOT registered — skip)
# =============================================================================

mode skip
# <->(geometry, tgeompoint) and <->(tgeompoint, geometry) are not registered
# for the cross-type case.  Only <->(tgeompoint, tgeompoint) is bound.
query I
SELECT round(startValue("<->"(geometry 'Point(0 0)', tgeompoint 'Point(3 4)@2001-01-01')), 6);
----
5.0

query I
SELECT round(startValue("<->"(tgeompoint 'Point(3 4)@2001-01-01', geometry 'Point(0 0)')), 6);
----
5.0

mode unskip

# =============================================================================
# nad / nearestApproachDistance for tgeompoint (NOT registered — skip)
# =============================================================================

mode skip
# nad(tgeompoint, ...) is only registered for tint/tfloat, not tgeompoint.
query I
SELECT round(nad(tgeompoint '[Point(0 0)@2001-01-01, Point(2 0)@2001-01-02]', tgeompoint '[Point(1 0)@2001-01-01, Point(3 0)@2001-01-02]'), 6);
----
0.0

query I
SELECT round(nearestApproachDistance(tgeompoint 'Point(0 0)@2001-01-01', geometry 'Point(3 4)'), 6);
----
5.0

mode unskip
