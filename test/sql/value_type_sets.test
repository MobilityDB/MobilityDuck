# name: test/sql/value_type_sets.test
# description: Set types over the value types the binding registers itself
# group: [sql]

require mobilityduck

# Every set type the catalog MeosType enum declares is registered.
query I
SELECT count(*) FROM duckdb_types()
WHERE type_name IN ('cbufferset', 'jsonbset', 'npointset', 'pcpatchset',
                    'pcpointset', 'posechainset', 'poseset', 'quadbinset');
----
8

# A pointer-carried element: the constructor keeps each value and asText reads it back.
query I
SELECT asText(set([CAST('Cbuffer(Point(1 1),0.5)' AS cbuffer),
                   CAST('Cbuffer(Point(3 3),2)' AS cbuffer)]));
----
{"Cbuffer(0101000000000000000000F03F000000000000F03F,0.5)", "Cbuffer(010100000000000000000008400000000000000840,2)"}

query I
SELECT asText(set([CAST('POSE(Point(1 1),0.5)' AS pose)]));
----
{"POSE (0101000000000000000000F03F000000000000F03F, 0.5)"}

query I
SELECT asText(set([CAST('NPoint(1,0.5)' AS npoint)]));
----
{"NPoint(1,0.5)"}

# A by-value element: the eight bytes of the Datum, not a pointer.
query I
SELECT asText(set([CAST(5209574053332910079 AS quadbin)]));
----
{"484c1fffffffffff"}

# A single value converts to a one-element set.
query I
SELECT asText(set(CAST('Cbuffer(Point(1 1),0.5)' AS cbuffer)));
----
{"Cbuffer(0101000000000000000000F03F000000000000F03F,0.5)"}

# Unnest answers the registered element type, not a bare BLOB.
query II
SELECT typeof(unnest), unnest::VARCHAR
FROM SetUnnest(set([CAST('Cbuffer(Point(1 1),0.5)' AS cbuffer),
                    CAST('Cbuffer(Point(3 3),2)' AS cbuffer)]));
----
cbuffer	Cbuffer(0101000000000000000000F03F000000000000F03F,0.5)
cbuffer	Cbuffer(010100000000000000000008400000000000000840,2)

query II
SELECT typeof(unnest), unnest::VARCHAR
FROM SetUnnest(set([CAST(5209574053332910079 AS quadbin)]));
----
quadbin	5209574053332910079

# A jsonb element reaches its set through the value the temporal type carries.
query I
SELECT asText(set([startValue(TJSONB('{"k":1}@2000-01-01'))]));
----
{"{\"k\": 1}"}

# The set types above are name-scoped as well as registered, so the catalog families whose
# accessor is named for one of them reach the surface. jsonbset carries the JSON accessors.
query I
SELECT jsonbsetArrayLength(set([jsonb '[1,2,3]', jsonb '[4,5]']));
----
{2, 3}

query I
SELECT asText(jsonbsetStripNulls(set([jsonb '{"a":null,"b":1}'])));
----
{"{\"b\": 1}"}

query I
SELECT replace(asText(jsonbsetPretty(set([jsonb '{"a":1}']))), chr(10), '|');
----
{"{|    \"a\": 1|}"}

# The spatial value sets carry the spatial transformations of their element.
query I
SELECT asText(round(set([pose 'Pose(Point(1.23456 2.34567),0.5)']), 2));
----
{"POSE (0101000000AE47E17A14AEF33FCDCCCCCCCCCC0240, 0.5)"}

query I
SELECT asText(round(set([cbuffer 'Cbuffer(Point(1.23456 2.34567),3.14159)']), 2));
----
{"Cbuffer(0101000000AE47E17A14AEF33FCDCCCCCCCCCC0240,3.14)"}

query I
SELECT asText(setSRID(set([pose 'Pose(Point(1 2),0.5)']), 4326));
----
{"POSE (0101000020E6100000000000000000F03F0000000000000040, 0.5)"}

query I
SELECT asText(transform(setSRID(set([pose 'Pose(Point(1 2),0.5)']), 4326), 3857));
----
{"POSE (0101000020110F0000310C4ADA772DFB4066F404ABE12E0B41, 0.5)"}

query I
SELECT routes(set([npoint 'NPoint(1, 0.5)', npoint 'NPoint(2, 0.25)']));
----
{1, 2}

# A temporal value restricts to the values one of these sets holds.
query I
SELECT startValue(atValues(tjsonb '{"a":1}@2000-01-01', set([jsonb '{"a":1}'])))::VARCHAR;
----
{"a": 1}

query I
SELECT minusValues(tjsonb '{"a":1}@2000-01-01', set([jsonb '{"a":1}'])) IS NULL;
----
true

query I
SELECT startValue(minusValues(tjsonb '{"a":1}@2000-01-01', set([jsonb '{"a":2}'])))::VARCHAR;
----
{"a": 1}

# Each carries its own named hex WKB reader, round-tripping the set it wrote.
query I
SELECT asText(posesetFromHexWKB(asHexWKB(set([pose 'Pose(Point(1 2),0.5)']))));
----
{"POSE (0101000000000000000000F03F0000000000000040, 0.5)"}

query I
SELECT asText(jsonbsetFromHexWKB(asHexWKB(set([jsonb '{"a":1}']))));
----
{"{\"a\": 1}"}
