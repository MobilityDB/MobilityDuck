# name: test/sql/parity/025_temporal_tile.test
# description: MobilityDB regression file 025_temporal_tile.test.sql adapted for MobilityDuck
# group: [sql]
#
# bins(<span>, <size>[, <origin>]) → <spanset> and
# getBin(<value>, <size>[, <origin>]) → <span> are registered as scalar
# functions in src/temporal/span_functions.cpp (Span_bins / Value_get_bin).
#
# Default origins:
#   int/bigint/float: 0 (origin at zero)
#   tstz: 2000-01-03 00:00:00+00 (Monday, matching MobilityDB's Monday-aligned
#         weekly default)
#
# Table-returning variants (valueSplit, timeSplit, valueTimeSplit) need
# DuckDB TableFunction infrastructure and remain skipped.
#
# Expected outputs verified against MobilityDB 025_temporal_tile.test.out.

require mobilityduck

# =============================================================================
# bins(<span>, <size>) — integer spans
# =============================================================================

query I
SELECT bins(intspan '[1, 10]', 2);
----
{[0, 2), [2, 4), [4, 6), [6, 8), [8, 10), [10, 12)}

query I
SELECT bins(bigintspan '[1, 10]', 2::bigint);
----
{[0, 2), [2, 4), [4, 6), [6, 8), [8, 10), [10, 12)}

# =============================================================================
# bins(<span>, <size>) — float spans
# =============================================================================

query I
SELECT bins(floatspan '(1, 10)', 2.5);
----
{[0, 2.5), [2.5, 5), [5, 7.5), [7.5, 10), [10, 12.5)}

# =============================================================================
# bins(<span>, <size>) — timestamptz spans
# =============================================================================

query I
SELECT bins(tstzspan '[2000-01-01, 2000-01-10]', interval '1 week');
----
{[1999-12-27 00:00:00+00, 2000-01-03 00:00:00+00), [2000-01-03 00:00:00+00, 2000-01-10 00:00:00+00), [2000-01-10 00:00:00+00, 2000-01-17 00:00:00+00)}

# =============================================================================
# getBin(<value>, <size>) — integer and float values
# =============================================================================

query I
SELECT getBin(3, 2);
----
[2, 4)

query I
SELECT getBin(3::bigint, 2::bigint);
----
[2, 4)

query I
SELECT getBin(3.5, 2.5);
----
[2.5, 5)

# =============================================================================
# getBin(<value>, <size>) — timestamptz
# =============================================================================

query I
SELECT getBin(timestamptz '2000-01-01', interval '1 week');
----
[1999-12-27 00:00:00+00, 2000-01-03 00:00:00+00)

# =============================================================================
# valueSplit / timeSplit / valueTimeSplit — table-returning functions
# (need DuckDB TableFunction infrastructure; skipped)
# =============================================================================

mode skip

query II
SELECT * FROM valueSplit(tint '[1@2000-01-01, 5@2000-01-05]', 2);
----
[0, 2)  [1@2000-01-01 00:00:00+00, 1@2000-01-03 00:00:00+00)
[2, 4)  [2@2000-01-02 00:00:00+00, 3@2000-01-03 00:00:00+00)
[4, 6)  [4@2000-01-04 00:00:00+00, 5@2000-01-05 00:00:00+00]

mode unskip
