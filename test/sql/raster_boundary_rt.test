# name: test/sql/raster_boundary_rt.test
# description: The casts between MEOS's raster and DuckDB's raster extension (duckdb-raster),
#              whose type names RT_DATACUBE and RT_STATS exist once the extension
#              is loaded: the community binary of duckdb-raster published for the
#              DuckDB version of the build.
# group: [sql]

require mobilityduck

statement ok
INSTALL raster FROM community;

statement ok
LOAD raster;

# The raster of two bands of each PostGIS pixel type, with the header of its
# datacube, as in raster_boundary.test.
statement ok
CREATE TABLE rast(pixtype VARCHAR, head BLOB, r raster, r8 raster);

statement ok
