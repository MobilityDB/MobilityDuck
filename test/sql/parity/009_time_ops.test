# name: test/sql/parity/009_time_ops.test
# description: MobilityDB regression file 009_time_ops.test.sql adapted for MobilityDuck
# group: [sql]
#
# Time-only specialisations of operators between dateset / datespan /
# datespanset / tstzset / tstzspan / tstzspanset and timestamptz /
# date — most of the surface is covered transitively by the existing
# set / span / spanset operator registrations.
#
# DuckDB note: `+ interval` is a built-in TIMESTAMP_TZ operator that
# DuckDB will not dispatch to a custom ScalarFunction, so time-shift
# must be written as `shift(t, interval)`.
#
# Individually skipped:
#   timestamptz <-> tstzset — registered as DOUBLE return; MobilityDB
#   returns INTERVAL.  A new INTERVAL-returning overload is needed.

require mobilityduck

# tstzset / tstzspan shift by interval — use named function

query I
SELECT shift(tstzset '{2000-01-01}', interval '1 day');
----
{"2000-01-02 00:00:00+00"}

query I
SELECT shift(tstzspan '[2000-01-01, 2000-01-02]', interval '1 day');
----
[2000-01-02 00:00:00+00, 2000-01-03 00:00:00+00]

mode skip
# timestamptz <-> tstzset — the registered overload returns DOUBLE
# (seconds); MobilityDB returns INTERVAL ('2 days').  Needs a new
# INTERVAL-returning wrapper around distance_tstzset_timestamptz.
query I
SELECT timestamptz '2000-01-01' <-> tstzset '{2000-01-03}';
----
2 days
mode unskip

# tstzspan <-> tstzspan already returns INTERVAL

query I
SELECT tstzspan '[2000-01-01, 2000-01-02]' <-> tstzspan '[2000-01-04, 2000-01-05]';
----
2 days
