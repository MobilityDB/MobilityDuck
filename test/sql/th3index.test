require mobilityduck

# ── th3index construction from a temporal point at an H3 resolution ──────────
query I
SELECT numInstants(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5));
----
1

query I
SELECT numTimestamps(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5));
----
1

# ── H3-specific accessor: the cell resolution tracks the requested resolution ─
query I
SELECT startValue(getResolution(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5)));
----
5

query I
SELECT startValue(getResolution(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 8)));
----
8

# ── traditional comparison operators ────────────────────────────────────────
query I
SELECT th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5)
     = th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5);
----
true

query I
SELECT th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5)
     = th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 8);
----
false

# ── value accessors return the H3 cell id (h3index) ─────────────────────────
query I
SELECT typeof(startValue(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5)));
----
h3index

# start and end of a single instant are the same cell
query I
SELECT startValue(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5))
     = endValue(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5));
----
true

# different resolutions yield different cells
query I
SELECT startValue(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5))
     = startValue(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 8));
----
false

# ── generated cell-id valueN (Temporal<T> out-param fold) → h3index ───────────
query I
SELECT typeof(valueN(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5), 1));
----
h3index

query I
SELECT valueN(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5), 1)
     = startValue(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5));
----
true

# ── getValues → h3indexset, the set of the values (temporal_valueset) ────────
query I
SELECT typeof(getValues(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5)));
----
h3indexset

query I
SELECT asEWKT(getValues(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5)))
     = 'SRID=4326;{"' || startValue(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5))::VARCHAR || '"}';
----
true

# ── h3indexset as text, the text MobilityDB answers for the same values ──────
query I
SELECT (h3indexset '{8a2a1072b59ffff, 8a2a1072b597fff}')::VARCHAR;
----
{"8a2a1072b597fff", "8a2a1072b59ffff"}

query I
SELECT asText(h3indexset '{8a2a1072b59ffff, 8a2a1072b597fff}');
----
{"8a2a1072b597fff", "8a2a1072b59ffff"}

query I
SELECT getValues(th3index '{8a2a1072b59ffff@2001-01-01, 8a2a1072b597fff@2001-01-02}')::VARCHAR;
----
{"8a2a1072b597fff", "8a2a1072b59ffff"}

query I
SELECT setUnionAgg(v)::VARCHAR FROM (VALUES ('8a2a1072b59ffff'::h3index), ('8a2a1072b597fff'::h3index)) t(v);
----
{"8a2a1072b597fff", "8a2a1072b59ffff"}

# ── the shared DGGS cell-index slots, answered from the tcellindex kernel ─────
# MobilityDB backs getResolution/cellArea/cellToParent/isValidCell for every cell
# index from one kernel, under the bare slot names. cellToPoint is NOT among them
# for H3: it answers geodetically from th3index_to_tgeogpoint, and the tgeogpoint
# overload above is that one.
query I
SELECT startValue(isValidCell(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5)));
----
true

query I
SELECT startValue(cellArea(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5))) > 0;
----
true

query I
SELECT startValue(cellToParent(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5), 3))::VARCHAR;
----
837541fffffffff

# the parent of a resolution-5 cell at resolution 3 reports resolution 3
query I
SELECT startValue(getResolution(cellToParent(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5), 3)));
----
3

# the cell boundary leaves the cell family: H3 is geodetic, so it answers a
# tgeography, where quadbin answers a planar tgeometry (see tquadbin.test)
query I
SELECT typeof(cellToBoundary(th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 5)));
----
tgeography

# atValues and minusValues over an h3indexset: restricted to all its cells the value keeps every
# instant, to one cell it keeps that cell's instant, and minus all its cells it is empty
query III
WITH t AS (SELECT th3index('SRID=4326;{Point(1 1)@2000-01-01, Point(40 40)@2000-01-02}'::tgeompoint, 5) AS h)
SELECT numInstants(atValues(h, getValues(h))),
       numInstants(atValues(h, getValues(atTime(h, TIMESTAMPTZ '2000-01-01')))),
       minusValues(h, getValues(h)) IS NULL FROM t;
----
2	1	true

query II
SELECT asText(value), time FROM temporalUnnest(th3index '{8528f003fffffff@2001-01-01, 8528f003fffffff@2001-01-02}');
----
8528f003fffffff	{[2001-01-01 00:00:00+01, 2001-01-01 00:00:00+01], [2001-01-02 00:00:00+01, 2001-01-02 00:00:00+01]}

# valueAtTimestamp answers the cell a step sequence holds at that time

query I
SELECT valueAtTimestamp(th3index '[8928308280fffff@2000-01-01, 8928308280fffff@2000-01-02]', TIMESTAMPTZ '2000-01-01 12:00:00')::VARCHAR;
----
8928308280fffff

# the constructors from a cell and a time value, as MobilityDB answers them
# (270_th3index.test.out); each is read against the literal of that answer

query I
SELECT asText(th3index(h3index '880326b885fffff', TIMESTAMPTZ '2001-01-01 08:00'))
     = asText(th3index '880326b885fffff@2001-01-01 08:00');
----
true

query I
SELECT asText(th3index(h3index '880326b885fffff', tstzset '{2001-01-01, 2001-01-02}'))
     = asText(th3index '{880326b885fffff@2001-01-01, 880326b885fffff@2001-01-02}');
----
true

query I
SELECT asText(th3index(h3index '880326b885fffff', tstzspan '[2001-01-01, 2001-01-02]'))
     = asText(th3index '[880326b885fffff@2001-01-01, 880326b885fffff@2001-01-02]');
----
true

query I
SELECT asText(th3index(h3index '880326b885fffff', tstzspanset '{[2001-01-01, 2001-01-02]}'))
     = asText(th3index '{[880326b885fffff@2001-01-01, 880326b885fffff@2001-01-02]}');
----
true
