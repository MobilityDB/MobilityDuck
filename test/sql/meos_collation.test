# name: test/sql/meos_collation.test
# description: the comparison syntax, ORDER BY, GROUP BY, DISTINCT, joins,
# MIN, MAX and COUNT over a MEOS type answer as its MEOS comparison and
# equality do, through its sort key, never by the order of its stored bytes
# group: [sql]

require mobilityduck

# Values whose stored bytes order otherwise than MEOS does: the bounds are
# stored little-endian, so 256 is stored before 1, and a negative bound after
# every positive tbl_tfloat

statement ok
CREATE TABLE tbl_intspan AS SELECT * FROM (VALUES
  (1, intspan '[256,301)'),
  (2, intspan '[1,3)'),
  (3, intspan '[-5,1)'),
  (4, intspan '[1,4)'),
  (5, intspan '[2,4)')) t(k, i);

statement ok
CREATE TABLE tbl_floatspan AS SELECT * FROM (VALUES
  (1, floatspan '[-1.5,2]'),
  (2, floatspan '[0.5,1]'),
  (3, floatspan '[-0.25,3]'),
  (4, floatspan '[2,1e10]'),
  (5, floatspan '(-1.5,2]')) t(k, f);

statement ok
CREATE TABLE tbl_intset AS SELECT * FROM (VALUES
  (1, intset '{256}'),
  (2, intset '{1,2}'),
  (3, intset '{-5}'),
  (4, intset '{1,300}'),
  (5, intset '{1}')) t(k, i);

statement ok
CREATE TABLE tbl_tboxfloat AS SELECT * FROM (VALUES
  (1, tbox 'TBOXFLOAT X([-2,1])'),
  (2, tbox 'TBOXFLOAT X([256,300])'),
  (3, tbox 'TBOXFLOAT X([1,2])'),
  (4, tbox 'TBOXFLOAT XT([1,2],[2001-01-01,2001-01-02])')) t(k, b);

statement ok
CREATE TABLE tbl_stbox AS SELECT * FROM (VALUES
  (1, stbox 'STBOX X((-2,1),(3,4))'),
  (2, stbox 'STBOX X((256,1),(300,4))'),
  (3, stbox 'STBOX X((1,1),(2,4))'),
  (4, stbox 'STBOX X((1,-7),(2,4))')) t(k, b);

statement ok
CREATE TABLE tbl_tint AS SELECT * FROM (VALUES
  (1, tint '256@2001-01-01'),
  (2, tint '1@2001-01-01'),
  (3, tint '-5@2001-01-01'),
  (4, tint '[1@2001-01-01, 2@2001-01-02]'),
  (5, tint '1@2000-01-01')) t(k, temp);

statement ok
CREATE TABLE tbl_tgeompoint AS SELECT * FROM (VALUES
  (1, tgeompoint 'Point(256 0)@2001-01-01'),
  (2, tgeompoint 'Point(1 0)@2001-01-01'),
  (3, tgeompoint 'Point(-5 0)@2001-01-01'),
  (4, tgeompoint '[Point(1 0)@2001-01-01, Point(2 0)@2001-01-02]')) t(k, temp);

statement ok
CREATE TABLE tbl_trgeometry2d AS SELECT * FROM (VALUES
  (1, trgeometry 'Polygon((1 1,2 2,3 1,1 1));Pose(Point(1 2), 0.5)@2001-01-01'),
  (2, trgeometry 'Polygon((0 0,5 0,5 5,0 0));Pose(Point(1 2), 0.5)@2001-01-01'),
  (3, trgeometry 'Polygon((0 0,1 0,1 1,0 0));Pose(Point(-3 2), 0.5)@2001-01-01')) t(k, temp);

# The comparison syntax answers as cmp over every pair

query IIIIIII
SELECT
  (SELECT count(*) FROM tbl_intspan t1, tbl_intspan t2 WHERE (t1.i < t2.i) <> (cmp(t1.i, t2.i) < 0)
    OR (t1.i = t2.i) <> (cmp(t1.i, t2.i) = 0) OR (t1.i >= t2.i) <> (cmp(t1.i, t2.i) >= 0)),
  (SELECT count(*) FROM tbl_floatspan t1, tbl_floatspan t2 WHERE (t1.f < t2.f) <> (cmp(t1.f, t2.f) < 0)
    OR (t1.f = t2.f) <> (cmp(t1.f, t2.f) = 0) OR (t1.f >= t2.f) <> (cmp(t1.f, t2.f) >= 0)),
  (SELECT count(*) FROM tbl_intset t1, tbl_intset t2 WHERE (t1.i < t2.i) <> (cmp(t1.i, t2.i) < 0)
    OR (t1.i = t2.i) <> (cmp(t1.i, t2.i) = 0) OR (t1.i >= t2.i) <> (cmp(t1.i, t2.i) >= 0)),
  (SELECT count(*) FROM tbl_tboxfloat t1, tbl_tboxfloat t2 WHERE (t1.b < t2.b) <> (cmp(t1.b, t2.b) < 0)
    OR (t1.b = t2.b) <> (cmp(t1.b, t2.b) = 0) OR (t1.b >= t2.b) <> (cmp(t1.b, t2.b) >= 0)),
  (SELECT count(*) FROM tbl_stbox t1, tbl_stbox t2 WHERE (t1.b < t2.b) <> (cmp(t1.b, t2.b) < 0)
    OR (t1.b = t2.b) <> (cmp(t1.b, t2.b) = 0) OR (t1.b >= t2.b) <> (cmp(t1.b, t2.b) >= 0)),
  (SELECT count(*) FROM tbl_tint t1, tbl_tint t2 WHERE (t1.temp < t2.temp) <> (cmp(t1.temp, t2.temp) < 0)
    OR (t1.temp = t2.temp) <> (cmp(t1.temp, t2.temp) = 0) OR (t1.temp >= t2.temp) <> (cmp(t1.temp, t2.temp) >= 0)),
  (SELECT count(*) FROM tbl_tgeompoint t1, tbl_tgeompoint t2 WHERE (t1.temp < t2.temp) <> (cmp(t1.temp, t2.temp) < 0)
    OR (t1.temp = t2.temp) <> (cmp(t1.temp, t2.temp) = 0) OR (t1.temp >= t2.temp) <> (cmp(t1.temp, t2.temp) >= 0));
----
0	0	0	0	0	0	0

query I
SELECT count(*) FROM tbl_trgeometry2d t1, tbl_trgeometry2d t2 WHERE (t1.temp < t2.temp) <> (cmp(t1.temp, t2.temp) < 0)
  OR (t1.temp = t2.temp) <> eq(t1.temp, t2.temp);
----
0

# ORDER BY places each value after every value cmp holds smaller

query I
SELECT count(*) FROM (SELECT i, row_number() OVER (ORDER BY i) AS r FROM tbl_intspan) t1
WHERE r <> 1 + (SELECT count(*) FROM tbl_intspan t2 WHERE cmp(t2.i, t1.i) < 0);
----
0

query I
SELECT count(*) FROM (SELECT b, row_number() OVER (ORDER BY b) AS r FROM tbl_tboxfloat) t1
WHERE r <> 1 + (SELECT count(*) FROM tbl_tboxfloat t2 WHERE cmp(t2.b, t1.b) < 0);
----
0

query I
SELECT asText(i) FROM tbl_intspan ORDER BY i;
----
[-5, 1)
[1, 3)
[1, 4)
[2, 4)
[256, 301)

# MIN and MAX read the least and the greatest value of the type

query II
SELECT asText(min(i)), asText(max(i)) FROM tbl_intspan;
----
[-5, 1)
[256, 301)

query II
SELECT (SELECT count(*) FROM tbl_tint WHERE cmp(temp, (SELECT min(temp) FROM tbl_tint)) < 0),
  (SELECT count(*) FROM tbl_tint WHERE cmp(temp, (SELECT max(temp) FROM tbl_tint)) > 0);
----
0	0

query I
SELECT asText(arg_min(i, i)) FROM tbl_intspan;
----
[-5, 1)

# One value spelled three ways is tbl_tfloat value: an instant, the sequence of that
# instant alone and the discrete sequence of it

statement ok
CREATE TABLE tbl_tfloat AS SELECT * FROM (VALUES
  (1, tfloat '1.5@2001-01-01'),
  (2, tfloat '[1.5@2001-01-01]'),
  (3, tfloat '{1.5@2001-01-01}')) t(k, temp);

query IIIIII
SELECT
  (SELECT count(*) FROM tbl_tfloat t1, tbl_tfloat t2 WHERE eq(t1.temp, t2.temp)),
  (SELECT count(*) FROM tbl_tfloat t1, tbl_tfloat t2 WHERE t1.temp = t2.temp),
  (SELECT count(*) FROM tbl_tfloat t1 JOIN tbl_tfloat t2 ON t1.temp = t2.temp),
  (SELECT count(*) FROM (SELECT DISTINCT temp FROM tbl_tfloat)),
  (SELECT count(DISTINCT temp) FROM tbl_tfloat),
  (SELECT count(*) FROM (SELECT temp FROM tbl_tfloat GROUP BY temp));
----
9	9	9	1	1	1

query I
SELECT count(temp) FROM tbl_tfloat;
----
3

# A geometry with a zero of either sign is tbl_tfloat geometry

query II
SELECT geomset '{"Linestring(0 0,1 1)"}' = geomset '{"Linestring(-0 0,1 1)"}',
  eq(geomset '{"Linestring(0 0,1 1)"}', geomset '{"Linestring(-0 0,1 1)"}');
----
true	true

# Two rigid geometries moved by tbl_tfloat pose are two values

query I
SELECT count(DISTINCT temp) FROM tbl_trgeometry2d;
----
3

# A network segment, which no set holds, orders by its own key: its route,
# then its positions; the double 0.1 is stored little endian with a low byte
# 9A and 0.3 with 33, so their bytes order 0.3 first

statement ok
CREATE TABLE tbl_nsegment AS SELECT * FROM (VALUES
  (1, nsegment 'NSegment(2, 0.1, 0.2)'),
  (2, nsegment 'NSegment(1, 0.3, 0.4)'),
  (3, nsegment 'NSegment(1, 0.1, 0.2)')) t(k, ns);

query I
SELECT k FROM tbl_nsegment ORDER BY ns;
----
3
2
1

# A Raquet tile, stored as its WKB, orders by its own key: its quadbin cell,
# pixel type, width and height, then its pixels. The nodata value is not read,
# so two tiles that differ only in it are one value, though their WKB differ

statement ok
CREATE TABLE tbl_raquet AS SELECT * FROM (VALUES
  (1, raquet(from_hex('02020202'), 2, 2, quadbin '4817ffffffffffff', 'UINT8', 7.0)),
  (2, raquet(from_hex('01020304'), 2, 2, quadbin '4817ffffffffffff', 'UINT8')),
  (3, raquet(from_hex('01010101'), 2, 2, quadbin '4817ffffffffffff', 'UINT8', 7.0)),
  (4, raquet(from_hex('01010101'), 2, 2, quadbin '4817ffffffffffff', 'UINT8', 9.0))) t(k, rq);

query I
SELECT k FROM tbl_raquet ORDER BY rq, k;
----
3
4
2
1

query II
SELECT COUNT(*), COUNT(DISTINCT rq) FROM tbl_raquet;
----
4	3

query I
SELECT a.k FROM tbl_raquet a JOIN tbl_raquet b ON a.rq = b.rq AND a.k < b.k;
----
3
