# name: test/sql/parity/034_temporal_posops.test
# description: Temporal position predicates — before/after/overbefore/overafter
#              (time axis) and left/right/overleft/overright (numeric axis on
#              tnumber × {numspan, tbox, tnumber}), under the tbox-prefixed names.
# group: [sql]

require mobilityduck

# Time axis

query I
SELECT tboxBefore(tint '[1@2000-01-01]', tint '[1@2000-01-02]');
----
true

query I
SELECT tboxAfter(tint '[1@2000-01-02]', tint '[1@2000-01-01]');
----
true

query I
SELECT tboxOverbefore(tstzspan '[2000-01-01, 2000-01-02]', tint '[1@2000-01-02]');
----
true

query I
SELECT tboxOverafter(tint '[1@2000-01-02]', tstzspan '[2000-01-01, 2000-01-02]');
----
true

# Numeric axis on tnumber × numspan

query I
SELECT tboxLeft(tint '[1@2000-01-01]', intspan '[5, 10)');
----
true

query I
SELECT tboxRight(tfloat '[10@2000-01-01]', floatspan '[1, 5)');
----
true

# The named functions agree with the operator forms

query I
SELECT tboxLeft(tint '[1@2000-01-01]', intspan '[5, 10)')
     = (tint '[1@2000-01-01]' << intspan '[5, 10)');
----
true

query I
SELECT tboxOverleft(tint '[1@2000-01-01]', intspan '[5, 10)')
     = (tint '[1@2000-01-01]' &< intspan '[5, 10)');
----
true

# Numeric axis on tnumber × tbox

query I
SELECT tboxLeft(tint '[1@2000-01-01]', tbox 'TBOXINT XT([5, 10),[2000-01-01, 2000-01-02])');
----
true

# Numeric axis on tnumber × tnumber

query I
SELECT tboxLeft(tint '[1@2000-01-01]', tint '[5@2000-01-01, 10@2000-01-02]');
----
true
