# name: test/sql/set_declared_signature.test
# description: a (set, scalar) -> set function registers over the set its catalog signature
#   names, which is not always the set of its scalar: a key over a jsonbset, a resolution over an
#   h3indexset. The deletions follow PostgreSQL's jsonb `-` operator, which the MEOS kernels wrap.
# group: [sql]

require mobilityduck

# ── jsonbsetDelete(jsonbset, text) removes the key from every element ──

query I
SELECT asText(jsonbsetDelete(set([jsonb '{"a":1,"b":2}']), 'a'));
----
{"{\"b\": 2}"}

query I
SELECT asText(jsonbsetDelete(set([jsonb '{"a":1,"b":2}']), 'c'));
----
{"{\"a\": 1, \"b\": 2}"}

# ── jsonbsetDeleteIndex(jsonbset, integer) removes the array element at a 0-based index ──

query I
SELECT asText(jsonbsetDeleteIndex(set([jsonb '[1,2,3]']), 1));
----
{"[1, 3]"}

# ── the scalar's own set is not the operand these kernels read ──

statement error
SELECT jsonbsetDelete(set(['a', 'b']), 'a');
----
No function matches the given name and argument types

statement error
SELECT h3UncompactCells(set([1, 2]), 6);
----
No function matches the given name and argument types

# ── h3UncompactCells(h3indexset, integer): the resolution-6 children of a resolution-5 cover hold
#    the resolution-6 cell of a point it covers, and not that of a point far away ──

query II
SELECT eEq(h3UncompactCells(geoToH3IndexSet(ST_Point(1, 1), 5), 6),
           th3index('SRID=4326;[Point(1 1)@2000-01-01]'::tgeompoint, 6)),
       eEq(h3UncompactCells(geoToH3IndexSet(ST_Point(1, 1), 5), 6),
           th3index('SRID=4326;[Point(40 40)@2000-01-01]'::tgeompoint, 6));
----
true	false
