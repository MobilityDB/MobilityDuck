# name: test/sql/parity/068_tgeo_aggfuncs.test
# description: tgeompoint aggregate functions parity — mirrors the bound
#              surface of MobilityDB's 068_tgeo_aggfuncs.test.sql.
#
#              Registered in MobilityDuck:
#                - extent(tgeompoint) → stbox  (full aggregate)
#                - TcentroidAgg(tgeompoint) → tgeompoint
#                - twCentroid(tgeompoint) → geometry  (scalar, not aggregate)
#
#              NOT registered (skipped):
#                - AppendInstantAgg(tgeompoint)
#                  — AllTypes() covers only tint/tbool/tfloat/ttext
#                - AppendSequenceAgg(tgeompoint)
#                  — same reason
# group: [sql]

require mobilityduck

# =============================================================================
# extent(tgeompoint) → stbox aggregate
# =============================================================================

query I
SELECT extent(v)::VARCHAR FROM (VALUES
  (tgeompoint '[Point(1 1)@2001-01-01, Point(2 2)@2001-01-02]'),
  (tgeompoint '[Point(3 3)@2001-01-03, Point(4 4)@2001-01-04]')) t(v);
----
STBOX XT(((1,1),(4,4)),[2001-01-01 00:00:00+00, 2001-01-04 00:00:00+00])

query I
SELECT extent(v)::VARCHAR FROM (VALUES
  (tgeompoint '[Point(2 2)@2001-01-02, Point(3 3)@2001-01-03]'),
  (tgeompoint '[Point(1 1)@2001-01-01, Point(2 2)@2001-01-02]'),
  (tgeompoint '[Point(3 3)@2001-01-03, Point(4 4)@2001-01-04]')) t(v);
----
STBOX XT(((1,1),(4,4)),[2001-01-01 00:00:00+00, 2001-01-04 00:00:00+00])

# NULLs are ignored
query I
SELECT extent(v)::VARCHAR FROM (VALUES
  (tgeompoint 'Point(1 1)@2001-01-01'),
  (NULL::tgeompoint),
  (tgeompoint 'Point(3 3)@2001-01-03')) t(v);
----
STBOX XT(((1,1),(3,3)),[2001-01-01 00:00:00+00, 2001-01-03 00:00:00+00])

# all NULLs → NULL
query I
SELECT extent(v)::VARCHAR FROM (VALUES (NULL::tgeompoint), (NULL::tgeompoint)) t(v);
----
NULL

# =============================================================================
# TcentroidAgg(tgeompoint) → tgeompoint aggregate
# =============================================================================

# centroid of two horizontal trajectories: (0,0)→(2,0) and (0,2)→(2,2)
# → expected centroid (0,1)→(2,1)
query I
SELECT asText(TcentroidAgg(v)) FROM (VALUES
  (tgeompoint '[Point(0 0)@2001-01-01, Point(2 0)@2001-01-02]'),
  (tgeompoint '[Point(0 2)@2001-01-01, Point(2 2)@2001-01-02]')) t(v);
----
{[POINT(0 1)@2001-01-01 00:00:00+00, POINT(2 1)@2001-01-02 00:00:00+00]}

# single input → centroid is itself
query I
SELECT asText(TcentroidAgg(v)) FROM (VALUES
  (tgeompoint '[Point(1 2)@2001-01-01, Point(3 4)@2001-01-02]')) t(v);
----
{[POINT(1 2)@2001-01-01 00:00:00+00, POINT(3 4)@2001-01-02 00:00:00+00]}

# =============================================================================
# twCentroid(tgeompoint) → geometry  (scalar function, not aggregate)
# =============================================================================

query I
SELECT ST_AsText(twCentroid(tgeompoint '[Point(0 0)@2001-01-01, Point(2 0)@2001-01-02]'));
----
POINT (1 0)

query I
SELECT ST_AsText(twCentroid(tgeompoint '[Point(0 0)@2001-01-01, Point(4 0)@2001-01-03]'));
----
POINT (2 0)

# instant: twCentroid of a single point is the point itself
query I
SELECT ST_AsText(twCentroid(tgeompoint 'Point(3 5)@2001-01-01'));
----
POINT (3 5)

# =============================================================================
# AppendInstantAgg / AppendSequenceAgg for tgeompoint — NOT registered (skip)
# =============================================================================

mode skip
# AppendInstantAgg only covers tint/tbool/tfloat/ttext (via AllTypes()).
# The tgeompoint overload is not registered.
query I
SELECT AppendInstantAgg(v ORDER BY v)::VARCHAR FROM (VALUES
  (tgeompoint 'Point(1 1)@2001-01-01'),
  (tgeompoint 'Point(2 2)@2001-01-02'),
  (tgeompoint 'Point(3 3)@2001-01-03')) t(v);
----
{[POINT(1 1)@2001-01-01 00:00:00+00, POINT(2 2)@2001-01-02 00:00:00+00, POINT(3 3)@2001-01-03 00:00:00+00]}

query I
SELECT AppendSequenceAgg(v ORDER BY v)::VARCHAR FROM (VALUES
  (tgeompoint '[Point(1 1)@2001-01-01, Point(2 2)@2001-01-02]'),
  (tgeompoint '[Point(3 3)@2001-01-03, Point(4 4)@2001-01-04]')) t(v);
----
{[POINT(1 1)@2001-01-01 00:00:00+00, POINT(2 2)@2001-01-02 00:00:00+00], [POINT(3 3)@2001-01-03 00:00:00+00, POINT(4 4)@2001-01-04 00:00:00+00]}

mode unskip
