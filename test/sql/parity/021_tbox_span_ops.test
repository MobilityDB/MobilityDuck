# name: test/sql/parity/021_tbox_span_ops.test
# description: MobilityDB regression file 021_tbox.test.sql adapted for MobilityDuck
# group: [sql]
#
# The operators a span shares with a temporal box: a number span on the value
# dimension, a timestamptz span on the time dimension, in either order. The
# operators spelled with '#' are reached through their named form.

require mobilityduck

query I
SELECT intspan '[1,5)' && tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])';
----
true

query I
SELECT tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])' && intspan '[1,5)';
----
true

query I
SELECT intspan '[1,5)' @> tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])';
----
false

query I
SELECT intspan '[3,8)' @> tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])';
----
true

query I
SELECT tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])' <@ intspan '[3,8)';
----
true

query I
SELECT intspan '[3,8)' ~= tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])';
----
true

query I
SELECT intspan '[8,9)' -|- tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])';
----
true

query I
SELECT intspan '[1,5)' &< tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])';
----
true

query I
SELECT intspan '[1,5)' &> tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])';
----
false

query I
SELECT tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])' &> intspan '[1,5)';
----
true

query I
SELECT intspan '[8,9)' >> tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])';
----
true

query I
SELECT tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])' << intspan '[8,9)';
----
true

query I
SELECT bigintspan '[1,5)' && tbox 'TBOXBIGINT XT([3,8),[2001-01-01,2001-01-02])';
----
true

query I
SELECT floatspan '[1,5)' && tbox 'TBOXFLOAT XT([3,8),[2001-01-01,2001-01-02])';
----
true

query I
SELECT tstzspan '[2001-01-01,2001-01-03]' && tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])';
----
true

query I
SELECT tstzspan '[2001-01-01,2001-01-03]' @> tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])';
----
true

query I
SELECT tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])' <@ tstzspan '[2001-01-01,2001-01-03]';
----
true

query I
SELECT tboxOverbefore(tstzspan '[2001-01-01,2001-01-03]', tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])');
----
false

query I
SELECT tboxOverafter(tstzspan '[2001-01-01,2001-01-03]', tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])');
----
true

query I
SELECT tboxOverbefore(tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])', tstzspan '[2001-01-01,2001-01-03]');
----
true

query I
SELECT tboxAfter(tstzspan '[2001-01-05,2001-01-06]', tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])');
----
true

query I
SELECT tstzspan '(2001-01-02,2001-01-03]' -|- tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])';
----
true

query I
SELECT floatspan '[8,9)' -|- tbox 'TBOXFLOAT XT([3,8),[2001-01-01,2001-01-02])';
----
true

query I
SELECT tboxOverlaps(intspan '[1,5)', tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])');
----
true

query I
SELECT tboxOverbefore(tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])', tstzspan '[2001-01-01,2001-01-03]');
----
true

statement error
SELECT floatspan '[1,5)' && tbox 'TBOXINT XT([3,8),[2001-01-01,2001-01-02])';
----
Operation on mixed span types: floatspan and intspan

statement error
SELECT intspan '[1,5)' && tbox 'TBOX T([2001-01-01,2001-01-02])';
----
The temporal values must have at least one common dimension

statement error
SELECT intspan '[1,5)' << tbox 'TBOX T([2001-01-01,2001-01-02])';
----
The tbox must have X dimension

statement error
SELECT tboxBefore(tstzspan '[2001-01-01,2001-01-03]', tbox 'TBOXINT X([3,8))');
----
The tbox must have T dimension
