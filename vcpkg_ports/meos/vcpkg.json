{
    "name": "meos",
    "version-string": "git",
    "port-version": 18,
    "description": "MEOS - Mobility Engine Open Source C library (built from MobilityDB with -DMEOS=ON)",
    "homepage": "https://libmeos.org/",
    "dependencies": [
        "vcpkg-cmake",
        "vcpkg-cmake-config",
        "proj",
        "json-c",
        "h3",
        { "name": "gdal", "default-features": false },
        { "name": "libxml2", "features": [ "zlib" ], "default-features": false },
        "zlib"
    ]
}
