SELECT raster(from_hex('53520407020000000300000002000000000000000000F0FF60000000120001002380FF0100020F00300000010500410000000206002300001F00207F060D0041000000070600300000080500410000000906003000000A0500B00000000B00000000000000'), 0, 0, meta_none())
----
