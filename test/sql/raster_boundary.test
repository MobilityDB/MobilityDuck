# name: test/sql/raster_boundary.test
# description: The boundary between MEOS's raster and DuckDB's raster extension (duckdb-raster):
#              a raster from a tile, the metadata of a raster, and the datacube
#              codec over untrusted input. The casts to RT_DATACUBE and RT_STATS,
#              whose names exist once duckdb-raster is loaded, are
#              raster_boundary_rt.test.
# group: [sql]

require mobilityduck

# ── the fixtures ─────────────────────────────────────────────────────────────

# Every datacube below was written by the published duckdb-raster 1.6.1 (the
# community binary for DuckDB v1.5.6). A typed cube packs 12 values, 2 bands of
# 3 columns and 2 rows, of one DuckDB type with RT_Array2Cube; COPY ... TO
# '<type>.tif' (FORMAT RASTER, DRIVER 'GTiff', SRS 'EPSG:4326') writes it over
# the footprint POLYGON((10 46, 16 46, 16 50, 10 50, 10 46)); and
# RT_Read('<type>.tif', datacube := true, blocksize_x := 3, blocksize_y := 2,
# data_format := '<format>') reads it back. The hex is hex(datacube::BLOB) and
# the metadata is RT_Read's metadata column, verbatim.
statement ok
CREATE TABLE cube(type VARCHAR, format VARCHAR, cube BLOB);

statement ok
INSERT INTO cube VALUES
  ('UINT8', 'RAW', from_hex('535200000200000003000000020000000000000000E06F400001027F80FF0A141E28323C')),
