# name: test/sql/nullable_arguments.test
# description: A NULL argument of a parameter MEOS takes NULL for (the catalog's shape.nullable)
#              reaches MEOS as NULL, as MobilityDB's wrapper passes it, and each call answers
#              MobilityDB's regression answer; a NULL in any other argument answers NULL.
# group: [sql]

require mobilityduck

# ── jsonbSetLax: a NULL value follows handle_null ───────────────────────────

query T
SELECT jsonbSetLax(jsonb '{"a": 1}', ['a'], NULL)::VARCHAR;
----
{"a": null}

query T
SELECT jsonbSetLax(jsonb '{"a": 1}', ['a'], NULL, true, 'delete_key')::VARCHAR;
----
{}

query T
SELECT jsonbSetLax(jsonb '{"a": 1}', ['a'], NULL, true, 'return_target')::VARCHAR;
----
{"a": 1}

# A NULL value or path of no nullable parameter answers NULL
query T
SELECT jsonbSetLax(NULL::jsonb, ['a'], jsonb '2') IS NULL;
----
true

query T
SELECT jsonbSetLax(jsonb '{"a": 1}', NULL::VARCHAR[], jsonb '2') IS NULL;
----
true

# ── tjsonbSetLax: the same over a temporal JSONB value ──────────────────────

query T
SELECT tjsonbSetLax(tjsonb '{{"gears": [1, 3]}@2001-01-01}', ['gears', '1'], NULL)
  = tjsonb '{"{\"gears\": [1, null]}"@2001-01-01}';
----
true

query T
SELECT tjsonbSetLax(tjsonb '[{"speed": 10, "units": "km/h"}@2001-01-01, {"speed": 20}@2001-01-02]',
  ['units'], NULL, true, 'delete_key')
  = tjsonb '{["{\"speed\": 10}"@2001-01-01, "{\"speed\": 20}"@2001-01-02]}';
----
true
