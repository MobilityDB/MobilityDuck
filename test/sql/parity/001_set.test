{0, 1}

query I
SELECT ceil(floatset '{0.5, 1.5, 2.5}');
----
{1, 2, 3}

query I
SELECT ceil(floatset '{0.5, 1.5, 1.6}');
----
{1, 2}

query I
SELECT round(floatset '{0.12345, 1.12345, 2.12345}', 3);
