# appendInstantAgg(tbigint)
query I
SELECT appendInstantAgg(v)::VARCHAR FROM (VALUES ('1@2020-01-01'::tbigint), ('2@2020-01-02'::tbigint)) t(v);
----
[1@2020-01-01 00:00:00+00, 2@2020-01-02 00:00:00+00]

# appendInstantAgg(tbigint, VARCHAR)
query I
SELECT appendInstantAgg(v, 'step')::VARCHAR FROM (VALUES ('1@2020-01-01'::tbigint), ('2@2020-01-02'::tbigint)) t(v);
----
[1@2020-01-01 00:00:00+00, 2@2020-01-02 00:00:00+00]

# appendInstantAgg(tbigint, VARCHAR, DOUBLE, INTERVAL)
query I
SELECT appendInstantAgg(v, 'step', 10.0, interval '2 days')::VARCHAR FROM (VALUES ('1@2020-01-01'::tbigint), ('2@2020-01-02'::tbigint)) t(v);
----
[1@2020-01-01 00:00:00+00, 2@2020-01-02 00:00:00+00]

