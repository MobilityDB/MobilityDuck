# name: test/sql/parity/040_temporal_aggfuncs.test
# description: MobilityDB regression file 040_temporal_aggfuncs.test.sql adapted for MobilityDuck
# group: [sql]
#
# Temporal aggregate functions registered in src/temporal/temporal_aggregates.cpp.
# All use the *Agg suffix convention from MobilityDB RFC #827 / PR #828.
#
# Naming note: tmin/tmax/tsum cannot be used as aggregate names in DuckDB
# because scalars of the same lowercase name (tbox/stbox accessors) are already
# registered. MobilityDuck uses TminAgg / TmaxAgg / TsumAgg instead, matching
# MobilityDB's alias convention. All other names (TcountAgg, TandAgg, TorAgg,
# TavgAgg) also use the *Agg suffix for cross-binding consistency.
#
# Expected outputs verified against MobilityDB 040_temporal_aggfuncs.test.out.

require mobilityduck

# =============================================================================
# tcount — count temporal objects at each instant
# =============================================================================

query I
SELECT TcountAgg(temp) FROM (VALUES (NULL::tbool),(NULL::tbool)) t(temp);
----
NULL

query I
SELECT TcountAgg(temp) FROM (VALUES (NULL::tbool),('true@2000-01-01'::tbool)) t(temp);
----
{1@2000-01-01 00:00:00+00}

query I
SELECT TcountAgg(temp) FROM (VALUES (NULL::tint),(NULL::tint)) t(temp);
----
NULL

query I
SELECT TcountAgg(temp) FROM (VALUES (NULL::tint),('1@2000-01-01'::tint)) t(temp);
----
{1@2000-01-01 00:00:00+00}

# =============================================================================
# tand / tor — temporal boolean aggregates
# =============================================================================

query I
SELECT TandAgg(temp) FROM (VALUES (NULL::tbool),(NULL::tbool)) t(temp);
----
NULL

query I
SELECT TandAgg(temp) FROM (VALUES (NULL::tbool),('true@2000-01-01'::tbool)) t(temp);
----
{t@2000-01-01 00:00:00+00}

query I
SELECT TorAgg(temp) FROM (VALUES (NULL::tbool),(NULL::tbool)) t(temp);
----
NULL

query I
SELECT TorAgg(temp) FROM (VALUES (NULL::tbool),('true@2000-01-01'::tbool)) t(temp);
----
{t@2000-01-01 00:00:00+00}

# =============================================================================
# TminAgg / TmaxAgg / TsumAgg — temporal min / max / sum aggregates
# (MobilityDB legacy names: tmin / tmax / tsum; see naming note in header)
# =============================================================================

query I
SELECT TminAgg(temp) FROM (VALUES (NULL::tint),(NULL::tint)) t(temp);
----
NULL

query I
SELECT TminAgg(temp) FROM (VALUES (NULL::tint),('1@2000-01-01'::tint)) t(temp);
----
{1@2000-01-01 00:00:00+00}

query I
SELECT TmaxAgg(temp) FROM (VALUES (NULL::tint),(NULL::tint)) t(temp);
----
NULL

query I
SELECT TmaxAgg(temp) FROM (VALUES (NULL::tint),('1@2000-01-01'::tint)) t(temp);
----
{1@2000-01-01 00:00:00+00}

query I
SELECT TsumAgg(temp) FROM (VALUES (NULL::tint),(NULL::tint)) t(temp);
----
NULL

query I
SELECT TsumAgg(temp) FROM (VALUES (NULL::tint),('1@2000-01-01'::tint)) t(temp);
----
{1@2000-01-01 00:00:00+00}

# =============================================================================
# tAvg — temporal average aggregate (returns tfloat)
# =============================================================================

query I
SELECT TavgAgg(temp) FROM (VALUES (NULL::tint),(NULL::tint)) t(temp);
----
NULL

query I
SELECT TavgAgg(temp) FROM (VALUES (NULL::tint),('1@2000-01-01'::tint)) t(temp);
----
{1@2000-01-01 00:00:00+00}

# =============================================================================
# extent(tnumber) — bounding tbox aggregate
# =============================================================================

query I
SELECT extent(temp) FROM (VALUES (tfloat '[1@2000-01-01, 5@2000-01-05]')) t(temp);
----
TBOXFLOAT XT([1, 5],[2000-01-01 00:00:00+00, 2000-01-05 00:00:00+00])
