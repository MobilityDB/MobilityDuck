# name: test/sql/tposechain.test
# description: Pose chain types (posechain / tposechain) — type + text I/O and
#             the catalog-generated operation surface.

require mobilityduck

# ---------------------------------------------------------------------------
# Type + text I/O (hand-registered boundary).  The cast prints each link's point
# as WKT, as asText does.
# ---------------------------------------------------------------------------

# Static posechain value round-trip, two links
query I
SELECT posechain 'PoseChain(Pose(Point(0 0), 0), Pose(Point(10 0), 0))';
----
PoseChain(Pose(POINT(0 0),0),Pose(POINT(10 0),0))

# tposechain instant round-trip
query I
SELECT tposechain 'PoseChain(Pose(Point(0 0), 0), Pose(Point(10 0), 0))@2000-01-01';
----
PoseChain(Pose(POINT(0 0),0),Pose(POINT(10 0),0))@2000-01-01 00:00:00+01

# ---------------------------------------------------------------------------
# Catalog-generated operation surface.  The expected values mirror MobilityDB's
# own regression outputs under mobilitydb/test/posechain/expected/, so the two
# answer alike.
# ---------------------------------------------------------------------------

# Text form
query I
SELECT asText(tposechain 'PoseChain(Pose(Point(0 0), 0), Pose(Point(10 0), 0))@2000-01-01');
----
PoseChain(Pose(POINT(0 0),0),Pose(POINT(10 0),0))@2000-01-01 00:00:00+01

# The family's own accessor: how many links the chain carries
query I
SELECT numPoses(tposechain 'PoseChain(Pose(Point(0 0), 0), Pose(Point(10 0), 0))@2000-01-01');
----
2

# The first, last and n-th chain of a sequence, as MobilityDB answers startValue, endValue
# and valueN over it; valueN past the last chain answers NULL.
query IIII
WITH t AS (SELECT tposechain '{PoseChain(Pose(Point(0 0), 0))@2000-01-01, PoseChain(Pose(Point(1 0), 0))@2000-01-02}' AS c)
SELECT asText(startValue(c)), asText(endValue(c)), asText(valueN(c, 2)), valueN(c, 3) IS NULL
FROM t;
----
PoseChain(Pose(POINT(0 0),0))	PoseChain(Pose(POINT(1 0),0))	PoseChain(Pose(POINT(1 0),0))	true

# SRID: the outer link carries the frame, so the chain has one
query I
SELECT SRID(tposechain 'SRID=3812;PoseChain(Pose(Point(1 2), 0))@2000-01-01');
----
3812

# ---------------------------------------------------------------------------
# The value is a fixed-size varlena, so unlike trgeometry it INHERITS the
# generic Temporal<T> surface rather than owning a counterpart for each op.
# These assert that inheritance actually reaches it.
# ---------------------------------------------------------------------------

query I
SELECT numInstants(tposechain 'PoseChain(Pose(Point(0 0), 0), Pose(Point(10 0), 0))@2000-01-01');
----
1

query I
SELECT asText(startInstant(tposechain 'PoseChain(Pose(Point(0 0), 0), Pose(Point(10 0), 0))@2000-01-01'));
----
PoseChain(Pose(POINT(0 0),0),Pose(POINT(10 0),0))@2000-01-01 00:00:00+01

# Ever-equal against a chain of the same length
query I
SELECT eEqual(tposechain 'PoseChain(Pose(Point(1 1), 0))@2000-01-01', tposechain 'PoseChain(Pose(Point(1 1), 0))@2000-01-01');
----
true

# ── the readers of the text, MF-JSON and WKB forms ──────────────────────────
# Each reader answers the value its writer writes.
query I
SELECT tposechainFromText(asText(t)) = t FROM (SELECT tposechain 'PoseChain(Pose(Point(0 0), 0), Pose(Point(10 0), 0))@2000-01-01' AS t);
----
true

query I
SELECT tposechainFromEWKT(asEWKT(t)) = t FROM (SELECT tposechain 'SRID=3857;PoseChain(Pose(Point(0 0), 0), Pose(Point(10 0), 0))@2000-01-01' AS t);
----
true

query I
SELECT tposechainFromMFJSON(asMFJSON(t)) = t FROM (SELECT tposechain 'PoseChain(Pose(Point(0 0), 0), Pose(Point(10 0), 0))@2000-01-01' AS t);
----
true

query II
SELECT posechainFromText(asText(c)) = c, posechainFromEWKT(asEWKT(c)) = c FROM (SELECT posechain 'PoseChain(Pose(Point(0 0), 0), Pose(Point(10 0), 0))' AS c);
----
true	true

query II
SELECT posechainFromBinary(asBinary(c)) = c, posechainFromHexWKB(asHexWKB(c)) = c FROM (SELECT posechain 'PoseChain(Pose(Point(0 0), 0), Pose(Point(10 0), 0))' AS c);
----
true	true

query II
SELECT posechainFromEWKB(asEWKB(c)) = c, posechainFromHexEWKB(asHexEWKB(c)) = c FROM (SELECT posechain 'SRID=3857;PoseChain(Pose(Point(0 0), 0), Pose(Point(10 0), 0))' AS c);
----
true	true
