# name: test/sql/parity/027_tjsonb.test
# description: Smoke tests for the TJSONB temporal type (tjsonb family).
# group: [sql]

require mobilityduck

# Round-trip a TJSONB instant through the cast.
query I
SELECT TJSONB('{"k":1}@2000-01-01')::VARCHAR;
----
"{\"k\": 1}"@2000-01-01 00:00:00+01

# Two-argument instant constructor from JSON text + timestamptz.
query I
SELECT TJSONB('{"x":42}', TIMESTAMPTZ '2020-06-01 00:00:00+00')::VARCHAR;
----
"{\"x\": 42}"@2020-06-01 02:00:00+02

# startValue returns the JSON of the first instant.
query I
SELECT startValue(TJSONB('{"a":1}@2000-01-01'));
----
{"a": 1}

# endValue returns the JSON of the last instant.
query I
SELECT endValue(TJSONB('{"a":1}@2000-01-01'));
----
{"a": 1}

# TJSONB over a step sequence: two instants.
query I
SELECT TJSONB('[{"v":1}@2000-01-01, {"v":2}@2000-01-02]')::VARCHAR;
----
["{\"v\": 1}"@2000-01-01 00:00:00+01, "{\"v\": 2}"@2000-01-02 00:00:00+01]

# startValue of a sequence.
query I
SELECT startValue(TJSONB('[{"v":1}@2000-01-01, {"v":2}@2000-01-02]'));
----
{"v": 1}

# endValue of a sequence.
query I
SELECT endValue(TJSONB('[{"v":1}@2000-01-01, {"v":2}@2000-01-02]'));
----
{"v": 2}

# tempSubtype distinguishes instant from sequence.
query I
SELECT tempSubtype(TJSONB('{"k":1}@2000-01-01'));
----
Instant

query I
SELECT tempSubtype(TJSONB('[{"k":1}@2000-01-01, {"k":2}@2000-01-02]'));
----
Sequence

# HexWKB round-trip.
query I
SELECT tjsonbFromHexWKB(asHexWKB(TJSONB('{"k":1}@2000-01-01')))::VARCHAR;
----
"{\"k\": 1}"@2000-01-01 00:00:00+01

# A jsonb value read from text is the binary container, not the text: it renders as
# canonical JSON and equals the same value taken from a temporal instant.
query I
SELECT CAST('{"a":1}' AS jsonb)::VARCHAR;
----
{"a": 1}

query I
SELECT CAST('{"k":1}' AS jsonb) = startValue(TJSONB('{"k":1}@2000-01-01'));
----
true

# A set over the text-read value carries it whole.
query I
SELECT asText(set([CAST('{"k":1}' AS jsonb)]));
----
{"{\"k\": 1}"}

# A key of a temporal JSON value reaches a temporal of the key's own type. The third
# argument is the null-handling mode, spelled the way MobilityDB spells it.
query III
SELECT tint(TJSONB('{"a":1}@2000-01-01'), 'a', 'use_json_null')::VARCHAR,
       tbool(TJSONB('{"b":true}@2000-01-01'), 'b', 'use_json_null')::VARCHAR,
       ttext(TJSONB('{"c":"x"}@2000-01-01'), 'c', 'use_json_null')::VARCHAR;
----
1@2000-01-01 00:00:00+01	t@2000-01-01 00:00:00+01	"x"@2000-01-01 00:00:00+01

# The mode is parsed by MEOS, so an unknown one is its error rather than a silent default.
statement error
SELECT tint(TJSONB('{"a":1}@2000-01-01'), 'a', 'not_a_mode');
----
Unknown null handling type

# A key of a temporal JSONB value, with the null-handling mode as the third argument.
# `astext` is bound by the wrapper, so it is not part of the SQL surface.
query I
SELECT tjsonbObjectField(TJSONB('{"a":1}@2000-01-01'), 'a', 'use_json_null')::VARCHAR;
----
"1"@2000-01-01 00:00:00+01

# The mode reaches MEOS: an absent key becomes a JSON null under one mode.
query I
SELECT tjsonbObjectField(TJSONB('{"a":1}@2000-01-01'), 'zz', 'use_json_null')::VARCHAR;
----
"null"@2000-01-01 00:00:00+01

# An element of a temporal JSONB array, indexed from zero.
query I
SELECT tjsonbArrayElement(TJSONB('[[10,20,30]@2000-01-01]'), 1, 'use_json_null')::VARCHAR;
----
{["20"@2000-01-01 00:00:00+01]}

# A path is one SQL argument: MobilityDB declares `text[]`, so DuckDB takes a list and
# supplies the element count from the list's own length.
query I
SELECT tjsonbExtractPath(TJSONB('{"a":{"b":7}}@2000-01-01'), ['a','b'], 'use_json_null')::VARCHAR;
----
"7"@2000-01-01 00:00:00+01

query II
SELECT tjsonbExistsAny(TJSONB('{"a":1,"b":2}@2000-01-01'), ['a','zz'])::VARCHAR,
       tjsonbExistsAll(TJSONB('{"a":1,"b":2}@2000-01-01'), ['a','zz'])::VARCHAR;
----
t@2000-01-01 00:00:00+01	f@2000-01-01 00:00:00+01

query II
SELECT tjsonbDeletePath(TJSONB('{"a":{"b":7},"c":1}@2000-01-01'), ['a','b'])::VARCHAR,
       tjsonbDeleteArray(TJSONB('{"a":1,"b":2}@2000-01-01'), ['a'])::VARCHAR;
----
"{\"a\": {}, \"c\": 1}"@2000-01-01 00:00:00+01	"{\"b\": 2}"@2000-01-01 00:00:00+01

# The JSON path type: MEOS parses and renders it, so the value round-trips through
# PostgreSQL's canonical spelling rather than the text it was written in.
query II
SELECT (SELECT count(*) FROM duckdb_types() WHERE type_name = 'jsonpath'),
       CAST('$.a.b' AS jsonpath)::VARCHAR;
----
1	$."a"."b"

# An unparseable path is MEOS's error rather than a silently accepted value.
statement error
SELECT CAST('not a path' AS jsonpath)::VARCHAR;
----
jsonpath input

# The JSON path predicates take the path as a jsonpath value, the variables as jsonb and
# the silent flag; `tz` is bound by the wrapper and is not part of the SQL surface.
query II
SELECT tjsonbPathExists(TJSONB('{"a":{"b":1}}@2000-01-01'), '$.a.b'::jsonpath, '{}'::jsonb, false)::VARCHAR,
       tjsonbPathExists(TJSONB('{"a":{"b":1}}@2000-01-01'), '$.zz'::jsonpath, '{}'::jsonb, false)::VARCHAR;
----
t@2000-01-01 00:00:00+01	f@2000-01-01 00:00:00+01

query II
SELECT tjsonbPathQueryFirst(TJSONB('{"a":{"b":7}}@2000-01-01'), '$.a.b'::jsonpath, '{}'::jsonb, false)::VARCHAR,
       tjsonbPathQueryArray(TJSONB('{"a":{"b":7}}@2000-01-01'), '$.a.b'::jsonpath, '{}'::jsonb, false)::VARCHAR;
----
"7"@2000-01-01 00:00:00+01	"[7]"@2000-01-01 00:00:00+01

# Insert takes the path as a list and the new value as jsonb. The last argument is
# create-if-missing, so a missing key appears only when it is true.
query II
SELECT tjsonbInsert(TJSONB('{"a":{}}@2000-01-01'), ['a','b'], '9'::jsonb, false)::VARCHAR,
       tjsonbInsert(TJSONB('{"a":{}}@2000-01-01'), ['a','b'], '9'::jsonb, true)::VARCHAR;
----
"{\"a\": {}}"@2000-01-01 00:00:00+01	"{\"a\": {\"b\": 9}}"@2000-01-01 00:00:00+01

# The value accessors are generated from the out-parameter shape, so they answer the
# jsonb the catalog declares and a miss is SQL NULL rather than an error.
query III
SELECT valueAtTimestamp(TJSONB('{"a":1}@2000-01-01'), TIMESTAMPTZ '2000-01-01')::VARCHAR,
       typeof(valueAtTimestamp(TJSONB('{"a":1}@2000-01-01'), TIMESTAMPTZ '2000-01-01')),
       valueAtTimestamp(TJSONB('{"a":1}@2000-01-01'), TIMESTAMPTZ '2010-01-01') IS NULL;
----
{"a": 1}	jsonb	true

query II
SELECT valueN(TJSONB('{"a":1}@2000-01-01'), 1)::VARCHAR,
       valueN(TJSONB('{"a":1}@2000-01-01'), 9) IS NULL;
----
{"a": 1}	true
