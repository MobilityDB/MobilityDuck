# name: test/sql/parity/058_tpoint_tile.test
# description: the tiles of a spatiotemporal box, the boxes of a temporal point and the tile of a point
# group: [sql]
#
# spaceTiles and spaceTimeTiles return SETOF index_stbox in MobilityDB, so in DuckDB they are
# table functions called in FROM with the columns index and tile; spaceBoxes, timeBoxes and
# spaceTimeBoxes return stbox[] and getSpaceTile and getSpaceTimeTile one stbox. Each query is one
# of mobilitydb/test/geo/queries/058_tpoint_tile.test.sql and each answer the one of its expected
# output, read in the time zone of MobilityDB's suite (America/Los_Angeles); an array answer is
# read one element per row. The SRID-qualified cases are left out, a DuckDB geometry carrying no
# SRID.

require mobilityduck

statement ok
SET TimeZone='America/Los_Angeles'

# MobilityDB: SELECT spaceTiles(tgeompoint '[Point(3 3)@2001-01-15, Point(15 15)@2001-01-25]'::stbox, 2.0) LIMIT 3;
query II
SELECT index, tile::VARCHAR FROM spaceTiles(tgeompoint '[Point(3 3)@2001-01-15, Point(15 15)@2001-01-25]'::stbox, 2.0) LIMIT 3;
----
1	STBOX X((2,2),(4,4))
2	STBOX X((4,2),(6,4))
3	STBOX X((6,2),(8,4))

# MobilityDB: SELECT spaceTiles(tgeompoint '[Point(3 3 3)@2001-01-15, Point(15 15 15)@2001-01-25]'::stbox, 2.0, geometry 'Point(3 3 3)') LIMIT 3;
query II
SELECT index, tile::VARCHAR FROM spaceTiles(tgeompoint '[Point(3 3 3)@2001-01-15, Point(15 15 15)@2001-01-25]'::stbox, 2.0, ST_GeomFromText('POINT Z (3 3 3)')) LIMIT 3;
----
1	STBOX Z((3,3,3),(5,5,5))
2	STBOX Z((5,3,3),(7,5,5))
3	STBOX Z((7,3,3),(9,5,5))

# MobilityDB: SELECT spaceTimeTiles(tgeompoint '[Point(3 3)@2001-01-15, Point(15 15)@2001-01-25]'::stbox, 2.0, interval '2 days', 'Point(3 3)', '2001-01-15') LIMIT 3;
query II
SELECT index, tile::VARCHAR FROM spaceTimeTiles(tgeompoint '[Point(3 3)@2001-01-15, Point(15 15)@2001-01-25]'::stbox, 2.0, INTERVAL '2 days', ST_GeomFromText('POINT(3 3)'), TIMESTAMPTZ '2001-01-15') LIMIT 3;
----
1	STBOX XT(((3,3),(5,5)),[2001-01-15 00:00:00-08, 2001-01-17 00:00:00-08))
2	STBOX XT(((5,3),(7,5)),[2001-01-15 00:00:00-08, 2001-01-17 00:00:00-08))
3	STBOX XT(((7,3),(9,5)),[2001-01-15 00:00:00-08, 2001-01-17 00:00:00-08))

# MobilityDB: SELECT spaceTimeTiles(tgeompoint '[Point(3 3 3)@2001-01-15, Point(15 15 15)@2001-01-25]'::stbox, 2.0, interval '2 days', 'Point(3 3 3)', '2001-01-15') LIMIT 3;
query II
SELECT index, tile::VARCHAR FROM spaceTimeTiles(tgeompoint '[Point(3 3 3)@2001-01-15, Point(15 15 15)@2001-01-25]'::stbox, 2.0, INTERVAL '2 days', ST_GeomFromText('POINT Z (3 3 3)'), TIMESTAMPTZ '2001-01-15') LIMIT 3;
----
1	STBOX ZT(((3,3,3),(5,5,5)),[2001-01-15 00:00:00-08, 2001-01-17 00:00:00-08))
2	STBOX ZT(((5,3,3),(7,5,5)),[2001-01-15 00:00:00-08, 2001-01-17 00:00:00-08))
3	STBOX ZT(((7,3,3),(9,5,5)),[2001-01-15 00:00:00-08, 2001-01-17 00:00:00-08))

# MobilityDB: SELECT spaceTiles(tgeompoint '[Point(3 3 3)@2001-01-15, Point(15 15 15)@2001-01-25]'::stbox, 2.0, geometry 'Point(3 3)');
statement error
SELECT index, tile::VARCHAR FROM spaceTiles(tgeompoint '[Point(3 3 3)@2001-01-15, Point(15 15 15)@2001-01-25]'::stbox, 2.0, ST_GeomFromText('POINT(3 3)'));
----
Operation on mixed 2D/3D dimensions

# MobilityDB: SELECT getSpaceTile(geometry 'Point(3 3)', 2.0);
query I
SELECT getSpaceTile(ST_GeomFromText('POINT(3 3)'), 2.0)::VARCHAR;
----
STBOX X((2,2),(4,4))

# MobilityDB: SELECT getSpaceTile(geometry 'Point(3 3 3)', 2.0);
query I
SELECT getSpaceTile(ST_GeomFromText('POINT Z (3 3 3)'), 2.0)::VARCHAR;
----
STBOX Z((2,2,2),(4,4,4))

# MobilityDB: SELECT getSpaceTimeTile(geometry 'Point(3 3)', timestamptz '2001-01-15', 2.0, interval '2 days');
query I
SELECT getSpaceTimeTile(ST_GeomFromText('POINT(3 3)'), TIMESTAMPTZ '2001-01-15', 2.0, INTERVAL '2 days')::VARCHAR;
----
STBOX XT(((2,2),(4,4)),[2001-01-15 00:00:00-08, 2001-01-17 00:00:00-08))

# MobilityDB: SELECT getSpaceTimeTile(geometry 'Point(3 3 3)', timestamptz '2001-01-15', 2.0, interval '2 days', geometry 'Point(1 1 1)', '2020-06-15');
query I
SELECT getSpaceTimeTile(ST_GeomFromText('POINT Z (3 3 3)'), TIMESTAMPTZ '2001-01-15', 2.0, INTERVAL '2 days', ST_GeomFromText('POINT Z (1 1 1)'), TIMESTAMPTZ '2020-06-15')::VARCHAR;
----
STBOX ZT(((3,3,3),(5,5,5)),[2001-01-13 23:00:00-08, 2001-01-15 23:00:00-08))

# MobilityDB: SELECT getSpaceTimeTile(geometry 'Point(3 3 3)', timestamptz '2001-01-15', 2.0, interval '2 days', geometry 'Point(1 1)', '2020-06-15');
statement error
SELECT getSpaceTimeTile(ST_GeomFromText('POINT Z (3 3 3)'), TIMESTAMPTZ '2001-01-15', 2.0, INTERVAL '2 days', ST_GeomFromText('POINT(1 1)'), TIMESTAMPTZ '2020-06-15')::VARCHAR;
----
The geometry must have Z dimension

# MobilityDB: SELECT round(spaceBoxes(tgeompoint '[Point(1 1)@2001-01-01, Point(10 10)@2001-01-10]', 2.0), 6);
query I
SELECT unnest(spaceBoxes(tgeompoint '[Point(1 1)@2001-01-01, Point(10 10)@2001-01-10]', 2.0))::VARCHAR;
----
STBOX XT(((1,1),(2,2)),[2001-01-01 00:00:00-08, 2001-01-02 00:00:00-08))
STBOX XT(((2,2),(4,4)),[2001-01-02 00:00:00-08, 2001-01-04 00:00:00-08))
STBOX XT(((4,4),(6,6)),[2001-01-04 00:00:00-08, 2001-01-06 00:00:00-08))
STBOX XT(((6,6),(8,8)),[2001-01-06 00:00:00-08, 2001-01-08 00:00:00-08))
STBOX XT(((8,8),(10,10)),[2001-01-08 00:00:00-08, 2001-01-10 00:00:00-08))
STBOX XT(((10,10),(10,10)),[2001-01-10 00:00:00-08, 2001-01-10 00:00:00-08])

# MobilityDB: SELECT round(spaceBoxes(tgeompoint '[Point(1 1 1)@2001-01-01, Point(10 10 10)@2001-01-10]', 2.0, geometry 'Point(1 1 1)'), 6);
query I
SELECT unnest(spaceBoxes(tgeompoint '[Point(1 1 1)@2001-01-01, Point(10 10 10)@2001-01-10]', 2.0, ST_GeomFromText('POINT Z (1 1 1)')))::VARCHAR;
----
STBOX ZT(((1,1,1),(3,3,3)),[2001-01-01 00:00:00-08, 2001-01-03 00:00:00-08))
STBOX ZT(((3,3,3),(5,5,5)),[2001-01-03 00:00:00-08, 2001-01-05 00:00:00-08))
STBOX ZT(((5,5,5),(7,7,7)),[2001-01-05 00:00:00-08, 2001-01-07 00:00:00-08))
STBOX ZT(((7,7,7),(9,9,9)),[2001-01-07 00:00:00-08, 2001-01-09 00:00:00-08))
STBOX ZT(((9,9,9),(10,10,10)),[2001-01-09 00:00:00-08, 2001-01-10 00:00:00-08])

# MobilityDB: SELECT spaceBoxes(tgeompoint '[Point(1 1 1)@2001-01-01, Point(10 10 10)@2001-01-10]', 2.0, geometry 'Point(1 1)');
statement error
SELECT spaceBoxes(tgeompoint '[Point(1 1 1)@2001-01-01, Point(10 10 10)@2001-01-10]', 2.0, ST_GeomFromText('POINT(1 1)'));
----
The geometry must have Z dimension

# MobilityDB: SELECT round(timeBoxes(tgeompoint '[Point(1 1)@2001-01-01, Point(10 10)@2001-01-10]', interval '2 days', '2001-01-01'), 6);
query I
SELECT unnest(timeBoxes(tgeompoint '[Point(1 1)@2001-01-01, Point(10 10)@2001-01-10]', INTERVAL '2 days', TIMESTAMPTZ '2001-01-01'))::VARCHAR;
----
STBOX XT(((1,1),(3,3)),[2001-01-01 00:00:00-08, 2001-01-03 00:00:00-08))
STBOX XT(((3,3),(5,5)),[2001-01-03 00:00:00-08, 2001-01-05 00:00:00-08))
STBOX XT(((5,5),(7,7)),[2001-01-05 00:00:00-08, 2001-01-07 00:00:00-08))
STBOX XT(((7,7),(9,9)),[2001-01-07 00:00:00-08, 2001-01-09 00:00:00-08))
STBOX XT(((9,9),(10,10)),[2001-01-09 00:00:00-08, 2001-01-10 00:00:00-08])

# MobilityDB declares timeBoxes(<tgeompoint|tgeometry|trgeometry>, interval, timestamptz DEFAULT
# '2000-01-03', boolean DEFAULT TRUE, boolean DEFAULT TRUE), so each of its 2- to 5-argument forms
# is called below. The default origin lies 182 two-day bins before 2001-01-01, so the 2-argument
# form and the forms passing TRUE answer what the 3-argument query above answers.
query I
SELECT unnest(timeBoxes(tgeompoint '[Point(1 1)@2001-01-01, Point(10 10)@2001-01-10]', INTERVAL '2 days'))::VARCHAR;
----
STBOX XT(((1,1),(3,3)),[2001-01-01 00:00:00-08, 2001-01-03 00:00:00-08))
STBOX XT(((3,3),(5,5)),[2001-01-03 00:00:00-08, 2001-01-05 00:00:00-08))
STBOX XT(((5,5),(7,7)),[2001-01-05 00:00:00-08, 2001-01-07 00:00:00-08))
STBOX XT(((7,7),(9,9)),[2001-01-07 00:00:00-08, 2001-01-09 00:00:00-08))
STBOX XT(((9,9),(10,10)),[2001-01-09 00:00:00-08, 2001-01-10 00:00:00-08])

query I
SELECT unnest(timeBoxes(tgeompoint '[Point(1 1)@2001-01-01, Point(10 10)@2001-01-10]', INTERVAL '2 days', TIMESTAMPTZ '2001-01-01', TRUE))::VARCHAR;
----
STBOX XT(((1,1),(3,3)),[2001-01-01 00:00:00-08, 2001-01-03 00:00:00-08))
STBOX XT(((3,3),(5,5)),[2001-01-03 00:00:00-08, 2001-01-05 00:00:00-08))
STBOX XT(((5,5),(7,7)),[2001-01-05 00:00:00-08, 2001-01-07 00:00:00-08))
STBOX XT(((7,7),(9,9)),[2001-01-07 00:00:00-08, 2001-01-09 00:00:00-08))
STBOX XT(((9,9),(10,10)),[2001-01-09 00:00:00-08, 2001-01-10 00:00:00-08])

query I
SELECT unnest(timeBoxes(tgeompoint '[Point(1 1)@2001-01-01, Point(10 10)@2001-01-10]', INTERVAL '2 days', TIMESTAMPTZ '2001-01-01', TRUE, TRUE))::VARCHAR;
----
STBOX XT(((1,1),(3,3)),[2001-01-01 00:00:00-08, 2001-01-03 00:00:00-08))
STBOX XT(((3,3),(5,5)),[2001-01-03 00:00:00-08, 2001-01-05 00:00:00-08))
STBOX XT(((5,5),(7,7)),[2001-01-05 00:00:00-08, 2001-01-07 00:00:00-08))
STBOX XT(((7,7),(9,9)),[2001-01-07 00:00:00-08, 2001-01-09 00:00:00-08))
STBOX XT(((9,9),(10,10)),[2001-01-09 00:00:00-08, 2001-01-10 00:00:00-08])

# MobilityDB: SELECT count(*) AS boxes FROM unnest(timeBoxes(tgeompoint '[Point(1 1)@2001-01-01, Point(9 9)@2001-01-05]', duration := '2 days', torigin := '2001-01-01'));
query I
SELECT len(timeBoxes(tgeompoint '[Point(1 1)@2001-01-01, Point(9 9)@2001-01-05]', INTERVAL '2 days', TIMESTAMPTZ '2001-01-01'));
----
3

# MobilityDB (058_tgeo_tile): SELECT round(timeBoxes(tgeometry '[Point(1 1)@2001-01-01, Point(10 10)@2001-01-10]', interval '2 days', '2001-01-01'), 6);
query I
SELECT unnest(timeBoxes(tgeometry '[Point(1 1)@2001-01-01, Point(10 10)@2001-01-10]', INTERVAL '2 days', TIMESTAMPTZ '2001-01-01'))::VARCHAR;
----
STBOX XT(((1,1),(1,1)),[2001-01-01 00:00:00-08, 2001-01-03 00:00:00-08))
STBOX XT(((1,1),(1,1)),[2001-01-03 00:00:00-08, 2001-01-05 00:00:00-08))
STBOX XT(((1,1),(1,1)),[2001-01-05 00:00:00-08, 2001-01-07 00:00:00-08))
STBOX XT(((1,1),(1,1)),[2001-01-07 00:00:00-08, 2001-01-09 00:00:00-08))
STBOX XT(((1,1),(10,10)),[2001-01-09 00:00:00-08, 2001-01-10 00:00:00-08])

query I
SELECT [timeBoxes(g, INTERVAL '2 days') = b, timeBoxes(g, INTERVAL '2 days', TIMESTAMPTZ '2001-01-01', TRUE) = b,
  timeBoxes(g, INTERVAL '2 days', TIMESTAMPTZ '2001-01-01', TRUE, TRUE) = b]::VARCHAR
FROM (SELECT g, timeBoxes(g, INTERVAL '2 days', TIMESTAMPTZ '2001-01-01') AS b
  FROM (SELECT tgeometry '[Point(1 1)@2001-01-01, Point(10 10)@2001-01-10]' AS g));
----
[true, true, true]

# MobilityDB (158_trgeo_tile): SELECT array_length(timeBoxes(trgeometry 'Polygon((0 0,1 0,1 1,0 1,0 0));[Pose(Point(0 0),0)@2001-01-01, Pose(Point(10 0),0)@2001-01-05]', interval '1 day'), 1);
query IIII
SELECT len(timeBoxes(r, INTERVAL '1 day')), len(timeBoxes(r, INTERVAL '1 day', TIMESTAMPTZ '2000-01-03')),
  len(timeBoxes(r, INTERVAL '1 day', TIMESTAMPTZ '2000-01-03', TRUE)),
  len(timeBoxes(r, INTERVAL '1 day', TIMESTAMPTZ '2000-01-03', TRUE, TRUE))
FROM (SELECT trgeometry 'Polygon((0 0,1 0,1 1,0 1,0 0));[Pose(Point(0 0),0)@2001-01-01, Pose(Point(10 0),0)@2001-01-05]' AS r);
----
5	5	5	5

# Every timeBoxes form MobilityDB declares is registered, the spatial ones and the temporal number
# ones (timeBoxes(<tint|tfloat|tbigint>, interval, timestamptz, boolean) and its 2-argument form).
query II
SELECT parameter_types::VARCHAR, count(*) FROM duckdb_functions() WHERE function_name = 'timeBoxes'
GROUP BY ALL ORDER BY 1;
----
[tbigint, INTERVAL, TIMESTAMP WITH TIME ZONE, BOOLEAN]	1
[tbigint, INTERVAL]	1
[tfloat, INTERVAL, TIMESTAMP WITH TIME ZONE, BOOLEAN]	1
[tfloat, INTERVAL]	1
[tgeometry, INTERVAL, TIMESTAMP WITH TIME ZONE, BOOLEAN, BOOLEAN]	1
[tgeometry, INTERVAL, TIMESTAMP WITH TIME ZONE, BOOLEAN]	1
[tgeometry, INTERVAL, TIMESTAMP WITH TIME ZONE]	1
[tgeometry, INTERVAL]	1
[tgeompoint, INTERVAL, TIMESTAMP WITH TIME ZONE, BOOLEAN, BOOLEAN]	1
[tgeompoint, INTERVAL, TIMESTAMP WITH TIME ZONE, BOOLEAN]	1
[tgeompoint, INTERVAL, TIMESTAMP WITH TIME ZONE]	1
[tgeompoint, INTERVAL]	1
[tint, INTERVAL, TIMESTAMP WITH TIME ZONE, BOOLEAN]	1
[tint, INTERVAL]	1
[trgeometry, INTERVAL, TIMESTAMP WITH TIME ZONE, BOOLEAN, BOOLEAN]	1
[trgeometry, INTERVAL, TIMESTAMP WITH TIME ZONE, BOOLEAN]	1
[trgeometry, INTERVAL, TIMESTAMP WITH TIME ZONE]	1
[trgeometry, INTERVAL]	1

# MobilityDB: SELECT round(spaceTimeBoxes(tgeompoint '[Point(1 1)@2001-01-01, Point(10 10)@2001-01-10]', 2.0, interval '2 days', 'Point(1 1)', '2001-01-01'), 6);
query I
SELECT unnest(spaceTimeBoxes(tgeompoint '[Point(1 1)@2001-01-01, Point(10 10)@2001-01-10]', 2.0, INTERVAL '2 days', ST_GeomFromText('POINT(1 1)'), TIMESTAMPTZ '2001-01-01'))::VARCHAR;
----
STBOX XT(((1,1),(3,3)),[2001-01-01 00:00:00-08, 2001-01-03 00:00:00-08))
STBOX XT(((3,3),(5,5)),[2001-01-03 00:00:00-08, 2001-01-05 00:00:00-08))
STBOX XT(((5,5),(7,7)),[2001-01-05 00:00:00-08, 2001-01-07 00:00:00-08))
STBOX XT(((7,7),(9,9)),[2001-01-07 00:00:00-08, 2001-01-09 00:00:00-08))
STBOX XT(((9,9),(10,10)),[2001-01-09 00:00:00-08, 2001-01-10 00:00:00-08])

# MobilityDB: SELECT round(spaceTimeBoxes(tgeompoint '[Point(1 1 1)@2001-01-01, Point(10 10 10)@2001-01-10]', 2.0, interval '2 days', 'Point(1 1 1)', '2001-01-01'));
query I
SELECT unnest(spaceTimeBoxes(tgeompoint '[Point(1 1 1)@2001-01-01, Point(10 10 10)@2001-01-10]', 2.0, INTERVAL '2 days', ST_GeomFromText('POINT Z (1 1 1)'), TIMESTAMPTZ '2001-01-01'))::VARCHAR;
----
STBOX ZT(((1,1,1),(3,3,3)),[2001-01-01 00:00:00-08, 2001-01-03 00:00:00-08))
STBOX ZT(((3,3,3),(5,5,5)),[2001-01-03 00:00:00-08, 2001-01-05 00:00:00-08))
STBOX ZT(((5,5,5),(7,7,7)),[2001-01-05 00:00:00-08, 2001-01-07 00:00:00-08))
STBOX ZT(((7,7,7),(9,9,9)),[2001-01-07 00:00:00-08, 2001-01-09 00:00:00-08))
STBOX ZT(((9,9,9),(10,10,10)),[2001-01-09 00:00:00-08, 2001-01-10 00:00:00-08])

# MobilityDB: SELECT spaceTimeBoxes(tgeompoint '[Point(1 1 1)@2001-01-01, Point(10 10 10)@2001-01-10]', 2.0, interval '2 days', 'Point(1 1)', '2001-01-01');
statement error
SELECT spaceTimeBoxes(tgeompoint '[Point(1 1 1)@2001-01-01, Point(10 10 10)@2001-01-10]', 2.0, INTERVAL '2 days', ST_GeomFromText('POINT(1 1)'), TIMESTAMPTZ '2001-01-01');
----
The geometry must have Z dimension

