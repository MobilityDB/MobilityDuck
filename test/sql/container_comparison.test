# name: test/sql/container_comparison.test
# description: cmp between two sets, spans or span sets, from the catalog
# group: [sql]
#
# Every expected value is MobilityDB's, cited beside each query from its expected files under
# mobilitydb/test/. cmp answers -1, 0 or 1, as MobilityDB's cmp(<container>, <container>)
# RETURNS integer declares.

require mobilityduck

# posechain/expected/551_posechainset.test.out:210
query I
SELECT cmp(posechainset '{"PoseChain(Pose(Point(0 0), 0))"}', posechainset '{"PoseChain(Pose(Point(0 0), 0))"}');
----
0

# temporal/expected/007_spanset.test.out:1385
query I
SELECT cmp(datespanset '{[2001-01-01,2001-01-01]}', datespanset '{[2001-01-01,2001-01-02),[2001-01-03,2001-01-04),[2001-01-05,2001-01-06)}');
----
-1

# temporal/expected/007_spanset.test.out:1427
query I
SELECT cmp(tstzspanset '{[2001-01-01,2001-01-01]}', tstzspanset '{(2001-01-01,2001-01-02),(2001-01-02,2001-01-03),(2001-01-03,2001-01-04)}');
----
-1

# ── cmp over two h3indexset values built from a cover: a set equals itself, and the order
#    between two different covers is antisymmetric ──

query III
SELECT cmp(geoToH3IndexSet(ST_Point(1, 1), 5), geoToH3IndexSet(ST_Point(1, 1), 5)),
       sign(cmp(geoToH3IndexSet(ST_Point(1, 1), 5), geoToH3IndexSet(ST_Point(40, 40), 5))),
       sign(cmp(geoToH3IndexSet(ST_Point(40, 40), 5), geoToH3IndexSet(ST_Point(1, 1), 5)));
----
0	1	-1

# ── the type-prefixed spellings MobilityDB does not declare bind to nothing ──

statement error
SELECT set_cmp(intset '{1}', intset '{2}');
----
does not exist

statement error
SELECT span_eq(intspan '[1, 2]', intspan '[1, 2]');
----
does not exist

statement error
SELECT spanset_lt(intspanset '{[1, 2]}', intspanset '{[3, 4]}');
----
does not exist
