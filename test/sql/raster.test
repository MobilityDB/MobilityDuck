# name: test/sql/raster.test
# description: MEOS's raster: its type, its text, its accessors, its constructors
#              and the value of a raster along a tgeompoint trajectory.
# group: [sql]

require mobilityduck

# The instants of the trajectory are read and written in UTC.
statement ok
SET TimeZone = 'UTC';

# ── a raster from its text ───────────────────────────────────────────────────

# A 3x3 32BF depth raster in SRID 4326 holding 10, 20, 30 / 40, 50, 60 /
# 70, 80, 90 over unit pixels from (0, 3), as PostGIS's ST_AsHexWKB writes it.
statement ok
CREATE TABLE depth AS
SELECT rasterFromHexWKB('0100000100000000000000F03F000000000000F0BF0000000000000000000000000000084000000000000000000000000000000000E6100000030003000A00000000000020410000A0410000F04100002042000048420000704200008C420000A0420000B442') AS r;

query IIIIIIIII
SELECT numBands(r), width(r), height(r), upperLeftX(r), upperLeftY(r), scaleX(r),
  scaleY(r), SRID(r), bandPixelType(r, 1)
FROM depth;
----
1	3	3	0.0	3.0	1.0	-1.0	4326	float32

# The text of a raster is its little-endian hex-encoded WKB, and the raster
# round-trips through it.
query II
SELECT r::VARCHAR = '0100000100000000000000F03F000000000000F0BF0000000000000000000000000000084000000000000000000000000000000000E6100000030003000A00000000000020410000A0410000F04100002042000048420000704200008C420000A0420000B442',
  r::VARCHAR::RASTER = r
FROM depth;
----
true	true

# The pixels of the band, row by row and little-endian.
query I
SELECT pixels(r, 1) = from_hex('000020410000A0410000F041000020420000484200007042' || '00008C420000A0420000B442')
FROM depth;
----
true

# ── the value of a raster along a trajectory ─────────────────────────────────

# The clearance of a vessel of draught 8.5, as MobilityDB answers
# rasterValue(trip, depth - 8.5) in its raster regression test, the draught
# taken as a raster of the grid of the depth whose every pixel is 8.5.
query I
SELECT asText(rasterValue(tgeompoint 'SRID=4326;[POINT(0.5 2.5)@2001-01-01, POINT(2.5 2.5)@2001-01-02, POINT(0.5 0.5)@2001-01-03]',
  rasterSub(r, rasterFromHexWKB('0100000100000000000000F03F000000000000F0BF0000000000000000000000000000084000000000000000000000000000000000E6100000030003000A00000000000008410000084100000841000008410000084100000841000008410000084100000841'))))
FROM depth;
----
Interp=Step;[1.5@2001-01-01 00:00:00+00, 11.5@2001-01-01 06:00:00+00, 21.5@2001-01-01 18:00:00+00, 41.5@2001-01-02 06:00:00+00, 61.5@2001-01-02 18:00:00+00, 61.5@2001-01-03 00:00:00+00]

# ── constructors ─────────────────────────────────────────────────────────────

# An empty raster holds no band.
query IIII
SELECT numBands(e), width(e), height(e), SRID(e)
FROM (SELECT makeEmptyRaster(2, 3, 0.0, 3.0, 1.0, -1.0, 0.0, 0.0, 3857) AS e);
----
0	2	3	3857

# A band of an initial value, with a nodata value or without one: a NULL or
# omitted nodata value leaves the band without one.
query IIIIII
SELECT pixels(r7, 1) = from_hex('07070707'), bandPixelType(r7, 1), bandHasNoDataValue(r7, 1),
  bandHasNoDataValue(n7, 1), bandNoDataValue(n7, 1), bandHasNoDataValue(z7, 1)
FROM (SELECT addBand(e, 1, '8BUI', 7.0) AS r7, addBand(e, 1, '8BUI', 7.0, 7.0) AS n7,
        addBand(e, 1, '8BUI', 7.0, NULL) AS z7
      FROM (SELECT makeEmptyRaster(2, 2, 0.0, 2.0, 1.0, -1.0, 0.0, 0.0, 3857) AS e));
----
true	uint8	false	true	7.0	false

# A band of the default initial value, 0.
query I
SELECT pixels(addBand(makeEmptyRaster(2, 2, 0.0, 2.0, 1.0, -1.0, 0.0, 0.0, 3857), 1, '8BUI'), 1)
  = from_hex('00000000');
----
true

# The raster built from the pixels of the depth, its grid and its pixel type is
# the depth.
query I
SELECT raster(pixels(r, 1), 3, 3, 0.0, 3.0, 1.0, -1.0, 0.0, 0.0, 4326, '32BF') = r
FROM depth;
----
true

# The band of another raster is appended, or added at a position.
query IIII
SELECT numBands(addBand(r, r)), numBands(addBand(addBand(r, r), r, 1, 1)),
  pixels(addBand(r, r), 2) = pixels(r, 1), bandPixelType(addBand(r, r), 2)
FROM depth;
----
2	3	true	float32

# ── processing ───────────────────────────────────────────────────────────────

# The depth clipped to the polygon over its upper-left four pixels, as
# MobilityDB answers clip(r, g) in its raster regression test: {{10,20},{40,50}}.
# The geometry is read in the SRID of the raster.
query III
SELECT width(c), height(c), pixels(c, 1) = from_hex('000020410000A0410000204200004842')
FROM (SELECT clip(r, 'POLYGON((0 1,2 1,2 3,0 3,0 1))'::GEOMETRY) AS c FROM depth);
----
2	2	true

# Not cropped, the clipped raster keeps the extent of the depth.
query II
SELECT width(c), height(c)
FROM (SELECT clip(r, 'POLYGON((0 1,2 1,2 3,0 3,0 1))'::GEOMETRY, false) AS c FROM depth);
----
3	3

# The pixels whose centre the triangle covers, or every pixel it touches, as
# MobilityDB answers them: {{10,NULL,NULL},...} and {{10,20,NULL},{40,NULL,NULL},...}.
# A pixel left out holds the smallest float32, the band stating no nodata value.
query II
SELECT pixels(clip(r, g, false), 1) = from_hex('00002041' || repeat('FFFF7FFF', 8)),
  pixels(clip(r, g, false, true), 1) =
    from_hex('000020410000A041FFFF7FFF00002042' || repeat('FFFF7FFF', 5))
FROM depth, (SELECT 'POLYGON((0 3,1.8 3,0 1.2,0 3))'::GEOMETRY AS g);
----
true	true

# The 4x4 elevation model of MobilityDB's raster regression test, nodata -9999.
statement ok
CREATE TABLE dem AS
SELECT raster(from_hex('000020410000A0410000F04100002042000070410000C841003C1CC6000034420000A0410000F04100002042000048420000C84100000C420000344200005C42'),
  4, 4, 0.0, 4.0, 1.0, -1.0, 0.0, 0.0, 3857, '32BF', -9999.0) AS r;

# The sums over the 3x3 window of the pixels of a custom extent, as MobilityDB
# answers them: {{190,280},{235,325}}.
query IIII
SELECT width(m), height(m), upperLeftX(m),
  pixels(m, 1) = from_hex('0000000000C0674000000000008071400000000000606D400000000000507440')
FROM (SELECT mapAlgebra(r, 1, 'SUM', '64BF', 'CUSTOM',
  makeEmptyRaster(2, 2, 1.0, 3.0, 1.0, -1.0, 0.0, 0.0, 3857), 1, 1) AS m FROM dem);
----
2	2	1.0	true

# A NULL custom extent and a NULL pixel type are left out, the pixel type then
# that of the band.
query III
SELECT width(m), height(m), bandPixelType(mapAlgebra(r, 1, 'MEAN'), 1)
FROM (SELECT r, mapAlgebra(r, 1, 'MEAN', NULL, 'UNION', NULL, 1, 1) AS m FROM dem);
----
4	4	float32

# ── rows ─────────────────────────────────────────────────────────────────────

# A set-returning function answers a list of its rows, which UNNEST spreads.
# The 3x3 raster of MobilityDB's raster regression test for valueCount, nodata
# -9999: 1.24, 1.26, -9999 / 2, 2, 2 / 3, 1.24, 2.
statement ok
CREATE TABLE counts AS
SELECT raster(from_hex('52B89E3FAE47A13F003C1CC60000004000000040000000400000404052B89E3F00000040'),
  3, 3, 0.0, 3.0, 1.0, -1.0, 0.0, 0.0, 4326, '32BF', -9999.0) AS r;

# The rows MobilityDB answers for its four forms.
query TRI
SELECT 'all' AS form, round(v.value, 6) AS value, v.count FROM counts, unnest(valueCount(r)) t(v)
UNION ALL SELECT 'nodata kept', round(v.value, 6), v.count
  FROM counts, unnest(valueCount(r, 1, false)) t(v)
UNION ALL SELECT 'tenths', round(v.value, 6), v.count
  FROM counts, unnest(valueCount(r, 1, true, NULL, 0.1)) t(v)
UNION ALL SELECT 'searched', round(v.value, 6), v.count
  FROM counts, unnest(valueCount(r, [2.0, 7.0])) t(v)
ORDER BY 1, 2;
----
all	1.24	2
all	1.26	1
all	2.0	4
all	3.0	1
nodata kept	-9999.0	1
nodata kept	1.24	2
nodata kept	1.26	1
nodata kept	2.0	4
nodata kept	3.0	1
searched	2.0	4
searched	7.0	0
tenths	1.2	2
tenths	1.3	1
tenths	2.0	4
tenths	3.0	1

query RR
SELECT round(v.value, 6), round(v.percent, 6) FROM counts, unnest(valuePercent(r)) t(v) ORDER BY 1;
----
1.24	0.25
1.26	0.125
2.0	0.5
3.0	0.125

statement error
SELECT valueCount(r, [2.0, NULL]) FROM counts;
----
null array element not allowed in this context

# The regions of equal value of MobilityDB's dumpAsPolygons case, 1, 1, 2 /
# 1, 2, 2 / 3, 3, -9999: their values and areas, and four regions with the
# nodata pixel kept.
statement ok
CREATE TABLE regions AS
SELECT raster(from_hex('0000803F0000803F000000400000803F00000040000000400000404000004040003C1CC6'),
  3, 3, 0.0, 3.0, 1.0, -1.0, 0.0, 0.0, 4326, '32BF', -9999.0) AS r;

query RR
SELECT d.val, ST_Area(d.geom) FROM regions, unnest(dumpAsPolygons(r)) t(d) ORDER BY 1;
----
1.0	3.0
2.0	3.0
3.0	2.0

query I
SELECT len(dumpAsPolygons(r, 1, false)) FROM regions;
----
4

# The pixels of MobilityDB's tbl_pixels band, 1.5, -9999, 3 / 4, 5, 6: their
# points, values and positions, and the values as rows of the band.
statement ok
CREATE TABLE pixel_band AS
SELECT raster(from_hex('0000C03F003C1CC600004040000080400000A0400000C040'),
  3, 2, 10.0, 20.0, 2.0, -1.0, 0.0, 0.0, 3857, '32BF', -9999.0) AS r;

query TRII
SELECT ST_AsText(p.geom), p.val, p.x, p.y FROM pixel_band, unnest(pixelAsPoints(r)) t(p)
ORDER BY p.y, p.x;
----
POINT (10 20)	1.5	1	1
POINT (14 20)	3.0	3	1
POINT (10 19)	4.0	1	2
POINT (12 19)	5.0	2	2
POINT (14 19)	6.0	3	2

query TT
SELECT dumpValues(r, 1)::VARCHAR, dumpValues(r, 1, false)::VARCHAR FROM pixel_band;
----
[[1.5, NULL, 3.0], [4.0, 5.0, 6.0]]	[[1.5, -9999.0, 3.0], [4.0, 5.0, 6.0]]

statement error
SELECT dumpAsPolygons(r, 2) FROM pixel_band;
----
The raster has no band 2, it has 1

# ── summary statistics ───────────────────────────────────────────────────────

# The raster of MobilityDB's raster regression test for summaryStats, nodata
# -9999: 10, 20, 30 / 40, -9999, 60 / 70, 80, 90, and a band whose every pixel
# is nodata.
statement ok
CREATE TABLE stats AS
SELECT raster(from_hex('000020410000A0410000F04100002042003C1CC60000704200008C420000A0420000B442'),
  3, 3, 0.0, 3.0, 1.0, -1.0, 0.0, 0.0, 4326, '32BF', -9999.0) AS r,
  raster(from_hex(repeat('003C1CC6', 9)),
  3, 3, 0.0, 3.0, 1.0, -1.0, 0.0, 0.0, 4326, '32BF', -9999.0) AS e;

# The row of the statistics, as MobilityDB answers it: the nodata pixel left
# out, or counted as the value it holds.
query IRRRRRII
SELECT s.count, s.sum, s.mean, round(s.stddev, 6), s.min, s.max,
  summaryStats(r, 1, false).count, summaryStats(r, 1, false).sum = 400 - 9999
FROM (SELECT r, summaryStats(r) AS s FROM stats);
----
8	400.0	50.0	27.386128	10.0	90.0	9	true

# The accessors read the fields of the row, each answering the field it names.
query IRRRRRI
SELECT summarystatsCount(s), summarystatsSum(s), summarystatsMean(s),
  round(summarystatsStddev(s), 6), summarystatsMin(s), summarystatsMax(s),
  summarystatsCount(s) = s.count AND summarystatsSum(s) = s.sum AND
    summarystatsMean(s) = s.mean AND summarystatsStddev(s) = s.stddev AND
    summarystatsMin(s) = s.min AND summarystatsMax(s) = s.max
FROM (SELECT summaryStats(r) AS s FROM stats);
----
8	400.0	50.0	27.386128	10.0	90.0	true

# A band whose every pixel is nodata counts no pixel and states no statistic,
# the row MobilityDB and PostGIS answer, (0,,,,,), and the accessors answer 0
# and NULL.
query IIIIII
SELECT s.count, s.sum IS NULL, s.mean IS NULL, s.stddev IS NULL, s.min IS NULL, s.max IS NULL
FROM (SELECT summaryStats(e) AS s FROM stats);
----
0	true	true	true	true	true

query IRRRRR
SELECT summarystatsCount(s), summarystatsSum(s), summarystatsMean(s),
  summarystatsStddev(s), summarystatsMin(s), summarystatsMax(s)
FROM (SELECT summaryStats(e) AS s FROM stats);
----
0	NULL	NULL	NULL	NULL	NULL

statement error
SELECT summaryStats(r, 2) FROM stats;
----
The raster has no band 2, it has 1

# The statistics of the pixels of many rasters, the two tiles of MobilityDB's
# raster regression test for summaryStatsAgg, 2x2 bands of 1 and of 3, nodata
# -9999, as MobilityDB answers them.
statement ok
CREATE TABLE stat_tiles AS
SELECT 1 AS id, addBand(makeEmptyRaster(2, 2, 0.0, 2.0, 1.0, -1.0, 0.0, 0.0, 3857), 1, '32BF', 1.0, -9999.0) AS r
UNION ALL
SELECT 2, addBand(makeEmptyRaster(2, 2, 1.0, 1.0, 1.0, -1.0, 0.0, 0.0, 3857), 1, '32BF', 3.0, -9999.0);

query IRRRRR
SELECT s.count, s.sum, s.mean, s.stddev, s.min, s.max
FROM (SELECT summaryStatsAgg(r, 1, true) AS s FROM stat_tiles);
----
8	16.0	2.0	1.0	1.0	3.0

# The form leaving the band out reads band 1, each tile alone answers what
# summaryStats answers for it, and a NULL raster is skipped.
query I
SELECT summaryStatsAgg(r, false) = summaryStatsAgg(r, 1, false) FROM stat_tiles;
----
true

query IT
SELECT id, summaryStatsAgg(r, 1, true) = any_value(summaryStats(r, 1, true))
FROM stat_tiles GROUP BY id ORDER BY id;
----
1	true
2	true

query I
SELECT summaryStatsAgg(r, 1, true) = (SELECT summaryStatsAgg(r, 1, true) FROM stat_tiles)
FROM (SELECT r FROM stat_tiles UNION ALL SELECT NULL);
----
true

# No raster read answers NULL; rasters whose every pixel is nodata count no
# pixel and answer the row MobilityDB answers, (0,,,,,).
query I
SELECT summaryStatsAgg(r, 1, true) IS NULL FROM stat_tiles WHERE false;
----
true

query IIIIII
SELECT s.count, s.sum IS NULL, s.mean IS NULL, s.stddev IS NULL, s.min IS NULL, s.max IS NULL
FROM (SELECT summaryStatsAgg(e, 1, true) AS s FROM stats);
----
0	true	true	true	true	true
