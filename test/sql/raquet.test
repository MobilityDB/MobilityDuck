# name: test/sql/raquet.test
# description: Raster tiles addressed by a QUADBIN cell (raquet) and the
#              sampling of a tile along a tgeompoint trajectory.
# group: [sql]

require mobilityduck

# ── raquet constructor and accessors ────────────────────────────────────────

# A 1x1 UINT8 tile covering the zoom-0 world cell, single pixel value 42.
statement ok
CREATE TABLE tile AS
SELECT raquet(from_hex('2a'), 1, 1, quadbinTileToCell(0, 0, 0), 'UINT8') AS rq;

query IIII
SELECT quadbin(rq) = quadbinTileToCell(0, 0, 0), width(rq), height(rq), bandPixelType(rq)
FROM tile;
----
true	1	1	uint8

# The tile states no nodata value, so its nodata value is NULL; the sixth
# argument of the constructor states one.

query II
SELECT bandHasNoDataValue(rq), bandNoDataValue(rq) IS NULL FROM tile;
----
false	true

query II
SELECT bandHasNoDataValue(t), bandNoDataValue(t)
FROM (SELECT raquet(from_hex('2a'), 1, 1, quadbinTileToCell(0, 0, 0), 'UINT8', 255.0) AS t);
----
true	255.0

# The tile round-trips through its text (hex-WKB) form.
query I
SELECT rq::VARCHAR::RAQUET = rq FROM tile;
----
true

# The band is readable, so a tile can be taken apart into the arguments of its
# own constructor and put back together.

query I
SELECT pixels(rq) = from_hex('2a') FROM tile;
----
true

query I
SELECT raquet(pixels(rq), width(rq), height(rq), quadbin(rq), bandPixelType(rq)) = rq
FROM tile;
----
true

# A NULL nodata value states that the tile has none, whether the query writes
# it or reads it from a column, so the tile is the one built without it. A
# NULL in any other argument leaves no tile to build.

query III
SELECT raquet(from_hex('2a'), 1, 1, quadbinTileToCell(0, 0, 0), 'UINT8', NULL) = rq,
  raquet(from_hex('2a'), 1, 1, quadbinTileToCell(0, 0, 0), 'UINT8', NULL::DOUBLE) = rq,
  raquet(from_hex('2a'), 1, 1, quadbinTileToCell(0, 0, 0), 'UINT8', n) = rq
FROM tile, (VALUES (NULL::DOUBLE)) v(n);
----
true	true	true

query I
SELECT raquet(NULL, 1, 1, quadbinTileToCell(0, 0, 0), 'UINT8', 255.0) IS NULL;
----
true

# The hex-encoded WKB pair round-trips the tile.

query I
SELECT raquetFromHexWKB(asHexWKB(rq)) = rq FROM tile;
----
true

query I
SELECT raquetFromHexWKB(rq::VARCHAR) = rq FROM tile;
----
true

# A tile carries no SRID, so the extended variant adds nothing to its encoding
# and the hex-WKB form is the text form. Comparing them also pins the string
# down to its characters: the MEOS writer reports the size of a buffer that
# holds a terminating null, one more than the length of the string in it.

query I
SELECT asHexWKB(rq) = rq::VARCHAR FROM tile;
----
true

query I
SELECT length(asHexWKB(rq)) = length(rq::VARCHAR) FROM tile;
----
true

# The binary half of the pair round-trips the tile too, and its hex encoding is
# the hex-WKB form, so the two pairs carry one wire form under two spellings.

query I
SELECT raquetFromBinary(asBinary(rq)) = rq FROM tile;
----
true

query I
SELECT hex(asBinary(rq)) = asHexWKB(rq) FROM tile;
----
true

statement error
SELECT raquetFromBinary(from_hex('00'));
----


query I
SELECT eq(rq, rq) AND NOT ne(rq, rq) AND cmp(rq, rq) = 0 FROM tile;
----
true

# The tile extent is the zoom-0 world cell, covering the whole Web-Mercator
# domain in longitude.
query II
SELECT round(Xmin(stbox(rq))::NUMERIC, 6), round(Xmax(stbox(rq))::NUMERIC, 6)
FROM tile;
----
-180.000000	180.000000

# ── rasterTileValue ─────────────────────────────────────────────────────────

# POINT(0 0) falls in the single pixel of the tile.
query I
SELECT startValue(rasterTileValue(tgeompoint 'POINT(0 0)@2024-01-01', rq)) = 42.0
FROM tile;
----
true

# The array form samples a set of tiles, keeping the highest zoom where they
# overlap; with a single tile it agrees with the scalar form.
query I
SELECT startValue(rasterTileValue(tgeompoint 'POINT(0 0)@2024-01-01', [rq])) = 42.0
FROM tile;
----
true

# ── rasterTileValueQuadbin ──────────────────────────────────────────────────

# The bare pixel-band form, as a Raquet Parquet row supplies it.
query I
SELECT startValue(
  rasterTileValueQuadbin(
    tgeompoint 'POINT(0 0)@2024-01-01',
    from_hex('2a'),            -- 1-byte pixel buffer, value 42
    1, 1,                      -- tile width x height in pixels
    quadbinTileToCell(0, 0, 0),
    'UINT8', 0.0, false
  )
) = 42.0;
----
true

# A trajectory outside the tile bounding box samples nothing.
query I
SELECT rasterTileValueQuadbin(
  tgeompoint 'POINT(90 -45)@2024-01-01',    -- SE hemisphere
  from_hex('2a'), 1, 1,
  quadbinTileToCell(0, 0, 1),               -- NW quadrant of zoom 1: lon -180..0, lat 0..85
  'UINT8', 0.0, false
) IS NULL;
----
true

# An unknown pixel type is rejected.
statement error
SELECT rasterTileValueQuadbin(tgeompoint 'POINT(0 0)@2024-01-01', from_hex('2a'), 1, 1,
  quadbinTileToCell(0, 0, 0), 'UINT4', 0.0, false);
----
Unknown pixel type "UINT4"

# The dimensions are INTEGER on the SQL surface but a tile records them in 16
# bits, so a value outside that range is rejected rather than wrapped: 65537
# would otherwise sample a 1-pixel-wide tile and silently return the value of a
# tile nobody asked for.

statement error
SELECT rasterTileValueQuadbin(tgeompoint 'POINT(0 0)@2024-01-01', from_hex('2a'), 65537, 1,
  quadbinTileToCell(0, 0, 0), 'UINT8', 0.0, false);
----
must be at most 65535

statement error
SELECT rasterTileValueQuadbin(tgeompoint 'POINT(0 0)@2024-01-01', from_hex('2a'), 1, -1,
  quadbinTileToCell(0, 0, 0), 'UINT8', 0.0, false);
----
must be positive

# The tile constructor takes the same dimensions and rejects them the same way.

statement error
SELECT raquet(from_hex('2a'), 65537, 1, quadbinTileToCell(0, 0, 0), 'UINT8');
----
must be at most 65535

statement error
SELECT raquet(from_hex('2a'), 0, 1, quadbinTileToCell(0, 0, 0), 'UINT8');
----
must be positive

# ── The tiles a trajectory covers ───────────────────────────────────────────
# The QUADBIN cells a trajectory covers at a zoom are the values of its
# temporal quadbin cell, the join key of a Raquet table.

# A single-instant trajectory at the origin covers exactly one zoom-0 cell.
query I
SELECT len(getValues(tquadbin(tgeompoint 'SRID=4326;POINT(0 0)@2024-01-01', 0)));
----
1

# The cell covering the origin at zoom 0 is the world tile.
query III
SELECT quadbinCellToTileX(c), quadbinCellToTileY(c), quadbinCellToTileZ(c)
FROM (SELECT getValues(tquadbin(tgeompoint 'SRID=4326;POINT(0 0)@2024-01-01', 0))[1] AS c);
----
0	0	0

# The cover is the tiles the path enters. A QUADBIN tile holds its west and
# north boundaries, so the corner where four zoom-1 tiles meet at (0 0) belongs
# to the tile east of the meridian and south of the parallel: this diagonal
# goes from the north-western tile straight into the south-eastern one and
# enters neither of the two tiles it touches at that corner.
query I
SELECT getValues(tquadbin(
  tgeompoint 'SRID=4326;[POINT(-90 45)@2024-01-01, POINT(90 -45)@2024-01-02]', 1));
----
[4813ffffffffffff, 481fffffffffffff]

# Moved one degree south, the diagonal passes west of the corner and crosses
# the south-western tile on the way, a monotone path across a two by two span
# visiting 2 + 2 - 1 tiles.
query I
SELECT getValues(tquadbin(
  tgeompoint 'SRID=4326;[POINT(-90 44)@2024-01-01, POINT(90 -46)@2024-01-02]', 1));
----
[4813ffffffffffff, 481bffffffffffff, 481fffffffffffff]

query I
SELECT getValues(tquadbin(NULL::TGEOMPOINT, 0)) IS NULL;
----
true
