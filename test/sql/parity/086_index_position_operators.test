# name: test/sql/parity/086_index_position_operators.test
# description: the position operators an index answers agree with a scan of the same rows
# group: [sql]

require mobilityduck

statement ok
CREATE TABLE pos_idx(t tgeompoint);

statement ok
CREATE TABLE pos_scan(t tgeompoint);

statement ok
INSERT INTO pos_idx SELECT ('Point(' || i || ' ' || i || ')@' || strftime(DATE '2000-01-01' + INTERVAL (i) DAY, '%Y-%m-%d'))::tgeompoint FROM range(1,3000) tbl(i);

statement ok
INSERT INTO pos_scan SELECT * FROM pos_idx;

# only one of the two tables is indexed, so the answers below are the index's against a scan's
statement ok
CREATE INDEX i_pos ON pos_idx USING TRTREE (t);

query II
SELECT (SELECT count(*) FROM pos_idx WHERE t << 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox), (SELECT count(*) FROM pos_scan WHERE t << 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox);
----
499	499

query II
SELECT (SELECT count(*) FROM pos_idx WHERE overleft(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox)), (SELECT count(*) FROM pos_scan WHERE overleft(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox));
----
501	501

query II
SELECT (SELECT count(*) FROM pos_idx WHERE t >> 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox), (SELECT count(*) FROM pos_scan WHERE t >> 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox);
----
2498	2498

query II
SELECT (SELECT count(*) FROM pos_idx WHERE overright(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox)), (SELECT count(*) FROM pos_scan WHERE overright(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox));
----
2500	2500

query II
SELECT (SELECT count(*) FROM pos_idx WHERE below(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox)), (SELECT count(*) FROM pos_scan WHERE below(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox));
----
499	499

query II
SELECT (SELECT count(*) FROM pos_idx WHERE above(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox)), (SELECT count(*) FROM pos_scan WHERE above(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox));
----
2498	2498

query II
SELECT (SELECT count(*) FROM pos_idx WHERE before(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox)), (SELECT count(*) FROM pos_scan WHERE before(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox));
----
365	365

query II
SELECT (SELECT count(*) FROM pos_idx WHERE overbefore(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox)), (SELECT count(*) FROM pos_scan WHERE overbefore(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox));
----
367	367

query II
SELECT (SELECT count(*) FROM pos_idx WHERE after(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox)), (SELECT count(*) FROM pos_scan WHERE after(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox));
----
2632	2632

query II
SELECT (SELECT count(*) FROM pos_idx WHERE overafter(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox)), (SELECT count(*) FROM pos_scan WHERE overafter(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox));
----
2634	2634

# The equality above is only evidence if the index is what answered the left column: an operator
# the index declines is answered by a scan, and a scan agrees with a scan for free. Each axis is
# witnessed here -- a spatial operator written as a symbol, the same one written as a word, and a
# temporal one, which carries no symbol.

query II
EXPLAIN SELECT count(*) FROM pos_idx WHERE t << 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox;
----
physical_plan	<REGEX>:.*MOBILITY RTREE INDEX.*

query II
EXPLAIN SELECT count(*) FROM pos_idx WHERE overleft(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox);
----
physical_plan	<REGEX>:.*MOBILITY RTREE INDEX.*

query II
EXPLAIN SELECT count(*) FROM pos_idx WHERE below(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox);
----
physical_plan	<REGEX>:.*MOBILITY RTREE INDEX.*

query II
EXPLAIN SELECT count(*) FROM pos_idx WHERE overbefore(t, 'STBOX XT(((500,500),(501,501)),[2001-01-01,2001-01-02])'::stbox);
----
physical_plan	<REGEX>:.*MOBILITY RTREE INDEX.*
