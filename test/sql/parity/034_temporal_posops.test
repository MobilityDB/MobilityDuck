# name: test/sql/parity/034_temporal_posops.test
# description: Temporal position predicates — before/after/overbefore/overafter
#              (time axis) and left/right/overleft/overright (numeric axis on
#              tnumber × {numspan, tbox, tnumber}), bare canonical names.
# group: [sql]

require mobilityduck

# Time axis

query I
SELECT before(tint '[1@2000-01-01]', tint '[1@2000-01-02]');
----
true

query I
SELECT after(tint '[1@2000-01-02]', tint '[1@2000-01-01]');
----
true

query I
SELECT overbefore(tstzspan '[2000-01-01, 2000-01-02]', tint '[1@2000-01-02]');
----
true

query I
SELECT overafter(tint '[1@2000-01-02]', tstzspan '[2000-01-01, 2000-01-02]');
----
true

# Numeric axis on tnumber × numspan

query I
SELECT left(tint '[1@2000-01-01]', intspan '[5, 10)');
----
true

query I
SELECT right(tfloat '[10@2000-01-01]', floatspan '[1, 5)');
----
true

# Bare names agree with the operator forms

query I
SELECT left(tint '[1@2000-01-01]', intspan '[5, 10)')
     = (tint '[1@2000-01-01]' << intspan '[5, 10)');
----
true

query I
SELECT overleft(tint '[1@2000-01-01]', intspan '[5, 10)')
     = (tint '[1@2000-01-01]' &< intspan '[5, 10)');
----
true

# Numeric axis on tnumber × tbox

query I
SELECT left(tint '[1@2000-01-01]', tbox 'TBOXINT XT([5, 10),[2000-01-01, 2000-01-02])');
----
true

# Numeric axis on tnumber × tnumber

query I
SELECT left(tint '[1@2000-01-01]', tint '[5@2000-01-01, 10@2000-01-02]');
----
true
