# name: test/sql/parity/052_tpoint_analytics.test
# description: Trajectory analytics for moving points — `trajectory`,
#              `length`, `cumulativeLength`, `speed`, `direction`,
#              `azimuth`, `angularDifference`, and the `bearing` family.
#              Mirrors MobilityDB's `056_tpoint_spatialfuncs.in.sql`.
#              Registered for tgeompoint (Cartesian) on the tgeometry
#              side and tgeogpoint (geographic) on the tgeography side;
#              backed by the same MEOS `tpoint_*` / `bearing_*`
#              functions, which dispatch on the temporal value's
#              geodetic flag.
# group: [sql]

require mobilityduck

# =============================================================================
# Cartesian side: tgeompoint
# =============================================================================

# length: 3-4-5 triangle hypotenuse over a single segment.
query I
SELECT length(
  '[Point(0 0)@2000-01-01, Point(3 4)@2000-01-02]'::tgeompoint);
----
5

# direction: scalar. (3,4) is at atan(4/3) ≈ 0.6435 rad from origin.
query I
SELECT abs(direction(
  '[Point(0 0)@2000-01-01, Point(3 4)@2000-01-02]'::tgeompoint)
  - 0.6435011087932843) < 1e-12;
----
true

# Constant azimuth across a single linear segment — atan(3/4) ≈ 0.6435.
# The result is a step-interp tfloat with both endpoints equal.
query I
SELECT abs(
  startValue(azimuth(
    '[Point(0 0)@2000-01-01, Point(3 4)@2000-01-02]'::tgeompoint))
  - 0.6435011087932843) < 1e-12;
----
true

query I
SELECT startValue(azimuth(
  '[Point(0 0)@2000-01-01, Point(3 4)@2000-01-02]'::tgeompoint))
  = endValue(azimuth(
    '[Point(0 0)@2000-01-01, Point(3 4)@2000-01-02]'::tgeompoint));
----
true

# Cumulative length goes 0 → 5 over the segment.
query I
SELECT startValue(cumulativeLength(
  '[Point(0 0)@2000-01-01, Point(3 4)@2000-01-02]'::tgeompoint));
----
0

query I
SELECT endValue(cumulativeLength(
  '[Point(0 0)@2000-01-01, Point(3 4)@2000-01-02]'::tgeompoint));
----
5

# Speed across a single linear segment is constant.
query I
SELECT startValue(speed(
  '[Point(0 0)@2000-01-01, Point(3 4)@2000-01-02]'::tgeompoint))
  = endValue(speed(
    '[Point(0 0)@2000-01-01, Point(3 4)@2000-01-02]'::tgeompoint));
----
true

# Angular difference: 0 at endpoints, ~106.26° in between.
query I
SELECT startValue(angularDifference(
  '[Point(0 0)@2000-01-01, Point(3 4)@2000-01-02, Point(6 0)@2000-01-03]'::tgeompoint));
----
0

query I
SELECT abs(
  valueN(angularDifference(
    '[Point(0 0)@2000-01-01, Point(3 4)@2000-01-02, Point(6 0)@2000-01-03]'::tgeompoint), 2)
  - 106.26020470831196) < 1e-10;
----
true

# trajectory returns a geometry — verify the geometry type rather than the
# textual rendering, which is GEOMETRY-cast-dependent.
query I
SELECT ST_GeometryType(trajectory(
  '[Point(0 0)@2000-01-01, Point(3 4)@2000-01-02, Point(6 0)@2000-01-03]'::tgeompoint)::geometry);
----
LINESTRING

# trajectory(tgeompoint, bool) — second arg requests unary union.
query I
SELECT (trajectory(
  '[Point(0 0)@2000-01-01, Point(3 4)@2000-01-02]'::tgeompoint, true)
  IS NOT NULL);
----
true

# =============================================================================
# bearing — Cartesian side
# =============================================================================

# bearing(geometry, geometry) — colinear north: 0 rad.
query I
SELECT bearing('Point(0 0)'::geometry, 'Point(0 1)'::geometry);
----
0

# bearing(tgeompoint, geometry) — temporal bearing toward (10,10).
query I
SELECT abs(startValue(bearing(
  '[Point(0 0)@2000-01-01, Point(3 4)@2000-01-02]'::tgeompoint,
  'Point(10 10)'::geometry)) - 0.785398163397448) < 1e-12;
----
true

# bearing(geometry, tgeompoint) — INVERT path; result is shifted by π.
query I
SELECT abs(startValue(bearing(
  'Point(10 10)'::geometry,
  '[Point(0 0)@2000-01-01, Point(3 4)@2000-01-02]'::tgeompoint))
  - 3.926990816987241) < 1e-12;
----
true

# bearing(tgeompoint, tgeompoint).
query I
SELECT abs(startValue(bearing(
  '[Point(0 0)@2000-01-01, Point(3 4)@2000-01-02]'::tgeompoint,
  '[Point(5 5)@2000-01-01, Point(6 8)@2000-01-02]'::tgeompoint))
  - 0.785398163397448) < 1e-12;
----
true

# =============================================================================
# Geographic side: tgeogpoint (SRID 4326 by default).
# Geodetic bearings differ from Cartesian — values are validated by call.
# =============================================================================

query I
SELECT (length(
  'SRID=4326;[Point(0 0)@2000-01-01, Point(0 1)@2000-01-02]'::tgeogpoint) > 0);
----
true

query I
SELECT (speed(
  'SRID=4326;[Point(0 0)@2000-01-01, Point(0 1)@2000-01-02]'::tgeogpoint)
  IS NOT NULL);
----
true

query I
SELECT (azimuth(
  'SRID=4326;[Point(0 0)@2000-01-01, Point(0 1)@2000-01-02]'::tgeogpoint)
  IS NOT NULL);
----
true

# Northbound geodesic at the equator — direction = 0 rad.
query I
SELECT direction(
  'SRID=4326;[Point(0 0)@2000-01-01, Point(0 1)@2000-01-02]'::tgeogpoint);
----
0

query I
SELECT ST_GeometryType(trajectory(
  'SRID=4326;[Point(0 0)@2000-01-01, Point(0 1)@2000-01-02]'::tgeogpoint)::geometry);
----
LINESTRING

query I
SELECT (bearing(
  'SRID=4326;[Point(0 0)@2000-01-01, Point(0 1)@2000-01-02]'::tgeogpoint,
  'SRID=4326;[Point(1 1)@2000-01-01, Point(1 2)@2000-01-02]'::tgeogpoint)
  IS NOT NULL);
----
true
