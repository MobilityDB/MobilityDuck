# name: test/sql/parity/078_sptree_index.test
# description: TSPTREE index coverage for tgeompoint, over both space-partitioning kinds
# group: [sql]

require mobilityduck

statement ok
CREATE TABLE idx_sp AS
  SELECT i AS id,
         format('[POINT({} {})@2000-01-01, POINT({} {})@2000-01-02]', i, i, i+1, i+1)::tgeompoint AS g
  FROM range(1, 200) tbl(i);

statement ok
CREATE TABLE idx_scan AS SELECT * FROM idx_sp;

# The kind defaults to quadtree.

statement ok
CREATE INDEX i_sp_default ON idx_sp USING TSPTREE (g);

query I
SELECT count(*) FROM idx_sp
  WHERE g && 'STBOX XT(((10,10),(40,40)),[2000-01-01, 2000-01-03])'::stbox;
----
32

statement ok
DROP INDEX i_sp_default;

# Both kinds are spelled through the `kind` create option.

statement ok
CREATE INDEX i_sp_quad ON idx_sp USING TSPTREE (g) WITH (kind = 'quadtree');

# The quadtree answers the bounding box with the rows a sequential scan returns.

query I
SELECT count(*) FROM (
  SELECT id FROM idx_sp
    WHERE g && 'STBOX XT(((10,10),(40,40)),[2000-01-01, 2000-01-03])'::stbox
  EXCEPT
  SELECT id FROM idx_scan
    WHERE g && 'STBOX XT(((10,10),(40,40)),[2000-01-01, 2000-01-03])'::stbox);
----
0

query I
SELECT count(*) FROM (
  SELECT id FROM idx_scan
    WHERE g && 'STBOX XT(((10,10),(40,40)),[2000-01-01, 2000-01-03])'::stbox
  EXCEPT
  SELECT id FROM idx_sp
    WHERE g && 'STBOX XT(((10,10),(40,40)),[2000-01-01, 2000-01-03])'::stbox);
----
0

query I
SELECT min(id) FROM idx_sp
  WHERE g && 'STBOX XT(((10,10),(40,40)),[2000-01-01, 2000-01-03])'::stbox;
----
9

statement ok
DROP INDEX i_sp_quad;

# The kdtree kind answers a bounded window with the rows a sequential scan
# returns. The points of `idx_sp` move along the diagonal, so its X and Y agree
# on which rows a window selects and a search descending the wrong axis still
# finds them. These points instead walk a grid, so the two coordinates select
# different rows, and each window below constrains one coordinate while leaving
# the other free.

statement ok
CREATE TABLE idx_kd AS
  SELECT i AS id,
         format('[POINT({} {})@2000-01-01, POINT({} {})@2000-01-02]',
                i % 20, i // 20, i % 20 + 1, i // 20 + 1)::tgeompoint AS g
  FROM range(0, 400) tbl(i);

statement ok
CREATE TABLE idx_kd_scan AS SELECT * FROM idx_kd;

statement ok
CREATE INDEX i_kd ON idx_kd USING TSPTREE (g) WITH (kind = 'kdtree');

# A slab constraining X over the whole extent of Y.

query I
SELECT count(*) FROM (
  SELECT id FROM idx_kd
    WHERE g && 'STBOX XT(((5,0),(8,20)),[2000-01-01, 2000-01-03])'::stbox
  EXCEPT
  SELECT id FROM idx_kd_scan
    WHERE g && 'STBOX XT(((5,0),(8,20)),[2000-01-01, 2000-01-03])'::stbox);
----
0

query I
SELECT count(*) FROM (
  SELECT id FROM idx_kd_scan
    WHERE g && 'STBOX XT(((5,0),(8,20)),[2000-01-01, 2000-01-03])'::stbox
  EXCEPT
  SELECT id FROM idx_kd
    WHERE g && 'STBOX XT(((5,0),(8,20)),[2000-01-01, 2000-01-03])'::stbox);
----
0

# The same slab turned onto the other axis.

query I
SELECT count(*) FROM (
  SELECT id FROM idx_kd
    WHERE g && 'STBOX XT(((0,5),(20,8)),[2000-01-01, 2000-01-03])'::stbox
  EXCEPT
  SELECT id FROM idx_kd_scan
    WHERE g && 'STBOX XT(((0,5),(20,8)),[2000-01-01, 2000-01-03])'::stbox);
----
0

query I
SELECT count(*) FROM (
  SELECT id FROM idx_kd_scan
    WHERE g && 'STBOX XT(((0,5),(20,8)),[2000-01-01, 2000-01-03])'::stbox
  EXCEPT
  SELECT id FROM idx_kd
    WHERE g && 'STBOX XT(((0,5),(20,8)),[2000-01-01, 2000-01-03])'::stbox);
----
0

# A window bounded in both coordinates at once.

query I
SELECT count(*) FROM (
  SELECT id FROM idx_kd
    WHERE g && 'STBOX XT(((5,5),(9,9)),[2000-01-01, 2000-01-03])'::stbox
  EXCEPT
  SELECT id FROM idx_kd_scan
    WHERE g && 'STBOX XT(((5,5),(9,9)),[2000-01-01, 2000-01-03])'::stbox);
----
0

query I
SELECT count(*) FROM (
  SELECT id FROM idx_kd_scan
    WHERE g && 'STBOX XT(((5,5),(9,9)),[2000-01-01, 2000-01-03])'::stbox
  EXCEPT
  SELECT id FROM idx_kd
    WHERE g && 'STBOX XT(((5,5),(9,9)),[2000-01-01, 2000-01-03])'::stbox);
----
0

# The windows select a part of the table, so the agreement above is not the
# agreement of two empty answers.

query III
SELECT
  (SELECT count(*) FROM idx_kd
     WHERE g && 'STBOX XT(((5,0),(8,20)),[2000-01-01, 2000-01-03])'::stbox),
  (SELECT count(*) FROM idx_kd
     WHERE g && 'STBOX XT(((0,5),(20,8)),[2000-01-01, 2000-01-03])'::stbox),
  (SELECT count(*) FROM idx_kd
     WHERE g && 'STBOX XT(((5,5),(9,9)),[2000-01-01, 2000-01-03])'::stbox);
----
100	100	36

statement ok
DROP INDEX i_kd;

statement ok
CREATE INDEX i_sp_kd ON idx_sp USING TSPTREE (g) WITH (kind = 'kdtree');

statement ok
DROP INDEX i_sp_kd;

# Any other kind is rejected at create time.

statement error
CREATE INDEX i_sp_bad ON idx_sp USING TSPTREE (g) WITH (kind = 'rtree');
----
TSPTREE index kind must be quadtree or kdtree
