# name: test/sql/parity/025_temporal_tile_split.test
# description: TableFunctions for temporal/025_temporal_tile — valueSplit /
#              timeSplit / valueTimeSplit on tnumber (and timeSplit on the
#              other temporal subtypes).  Set-returning splitters: each
#              input row produces N output rows, one per (value[, time]) bin.
# group: [sql]

require mobilityduck

# valueSplit on tint with size 2 -> bins 0 and 4

query I
SELECT count(*) FROM valueSplit(tint '[1@2000-01-01 00:00:00+00, 5@2000-01-05 00:00:00+00]', 2);
----
2

# valueSplit returns the bin start values

query I
SELECT number FROM valueSplit(tint '[1@2000-01-01 00:00:00+00, 5@2000-01-05 00:00:00+00]', 2) ORDER BY number;
----
0
4

# valueSplit on tfloat

query I
SELECT count(*) FROM valueSplit(tfloat '[1@2000-01-01 00:00:00+00, 5@2000-01-05 00:00:00+00]', 2.0);
----
3

# valueSplit with explicit vorigin shifts the bin starts to bins {1, 5}

query I
SELECT count(*) FROM valueSplit(tint '[1@2000-01-01 00:00:00+00, 5@2000-01-05 00:00:00+00]', 2, 1);
----
2

query I
SELECT array_agg(number ORDER BY number) FROM
  valueSplit(tint '[1@2000-01-01 00:00:00+00, 5@2000-01-05 00:00:00+00]', 2, 1);
----
[1, 5]

# timeSplit on tfloat with 2-day duration -> 2 buckets

query I
SELECT count(*) FROM timeSplit(tfloat '[1@2000-01-01 00:00:00+00, 5@2000-01-05 00:00:00+00]', INTERVAL '2 days');
----
2

# timeSplit on tbool

query I
SELECT count(*) FROM timeSplit(tbool '[t@2000-01-01 00:00:00+00, f@2000-01-05 00:00:00+00]', INTERVAL '2 days');
----
2

# timeSplit on ttext

query I
SELECT count(*) FROM timeSplit(ttext '["a"@2000-01-01 00:00:00+00, "b"@2000-01-05 00:00:00+00]', INTERVAL '2 days');
----
2

# timeSplit with explicit torigin

query I
SELECT count(*) FROM timeSplit(tint '[1@2000-01-01 00:00:00+00, 5@2000-01-05 00:00:00+00]', INTERVAL '2 days', TIMESTAMPTZ '2000-01-01 00:00:00+00');
----
2

# valueTimeSplit cross-product (value × time bins)

query I
SELECT count(*) FROM valueTimeSplit(tint '[1@2000-01-01 00:00:00+00, 5@2000-01-05 00:00:00+00]', 2, INTERVAL '2 days');
----
3

query III
SELECT value, time, tempSubtype(tint) FROM
  valueTimeSplit(tint '[1@2000-01-01 00:00:00+00, 5@2000-01-05 00:00:00+00]', 2, INTERVAL '2 days')
  ORDER BY value, time;
----
0	2000-01-01 01:00:00+01	SequenceSet
0	2000-01-03 01:00:00+01	SequenceSet
4	2000-01-05 01:00:00+01	SequenceSet

# valueSplit and valueTimeSplit take their temporal number from a column: each
# row splits as its literal does (2 + 2 value bins, 3 + 2 value-time bins), and
# a NULL row splits into none

statement ok
CREATE TABLE ti AS SELECT * FROM (VALUES
  (tint '[1@2000-01-01 00:00:00+00, 5@2000-01-05 00:00:00+00]'),
  (tint '[1@2000-01-01 00:00:00+00, 3@2000-01-03 00:00:00+00]'),
  (NULL::tint)) v(temp);

statement ok
CREATE TABLE tf AS SELECT * FROM (VALUES
  (tfloat '[1@2000-01-01 00:00:00+00, 5@2000-01-05 00:00:00+00]'),
  (tfloat '[2@2000-01-01 00:00:00+00, 3@2000-01-03 00:00:00+00]')) v(temp);

query I
SELECT count(*) FROM ti, valueSplit(ti.temp, 2);
----
4

query I
SELECT array_agg(number ORDER BY number) FROM ti, valueSplit(ti.temp, 2, 1);
----
[1, 1, 3, 5]

query I
SELECT count(*) FROM tf, valueSplit(tf.temp, 2.0);
----
4

query I
SELECT count(*) FROM ti, valueTimeSplit(ti.temp, 2, INTERVAL '2 days');
----
5

query I
SELECT count(*) FROM ti, valueTimeSplit(ti.temp, 2, INTERVAL '2 days', 1, TIMESTAMPTZ '2000-01-02 00:00:00+00');
----
7

query I
SELECT count(*) FROM tf, valueTimeSplit(tf.temp, 2.0, INTERVAL '2 days');
----
5

# timeSplit takes its temporal value from a column for every type it is
# registered for: each row splits as its literal does (2 + 1 time bins, 3 + 2
# with an origin), and a NULL row splits into none

statement ok
CREATE TABLE tt AS SELECT * FROM (VALUES
  (ttext '["a"@2000-01-01 00:00:00+00, "b"@2000-01-05 00:00:00+00]'),
  (ttext '["a"@2000-01-02 00:00:00+00, "b"@2000-01-03 00:00:00+00]')) v(temp);

statement ok
CREATE TABLE tp AS SELECT * FROM (VALUES
  (tgeompoint '[Point(1 1)@2000-01-01 00:00:00+00, Point(5 5)@2000-01-05 00:00:00+00]'),
  (tgeompoint '[Point(1 1)@2000-01-02 00:00:00+00, Point(2 2)@2000-01-03 00:00:00+00]')) v(temp);

query I
SELECT count(*) FROM ti, timeSplit(ti.temp, INTERVAL '2 days');
----
3

query I
SELECT count(*) FROM ti, timeSplit(ti.temp, INTERVAL '2 days', TIMESTAMPTZ '2000-01-02 00:00:00+00');
----
5

query I
SELECT count(*) FROM tt, timeSplit(tt.temp, INTERVAL '2 days');
----
3

query I
SELECT count(*) FROM tp, timeSplit(tp.temp, INTERVAL '2 days');
----
3

query II
SELECT typeof(time), typeof(tint) FROM ti, timeSplit(ti.temp, INTERVAL '2 days') LIMIT 1;
----
TIMESTAMP WITH TIME ZONE	tint
