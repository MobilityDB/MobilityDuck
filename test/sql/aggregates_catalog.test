SELECT extent(v)::VARCHAR FROM (VALUES ('2020-01-01'::DATE), ('2020-01-02'::DATE)) t(v);
----
[2020-01-01, 2020-01-03)

# extent(DOUBLE)
query I
SELECT asText(extent(v), 6) FROM (VALUES ('1.5'::DOUBLE), ('2.5'::DOUBLE)) t(v);
----
[1.5, 2.5]

# extent(INTEGER)
query I
SELECT extent(v)::VARCHAR FROM (VALUES ('1'::INTEGER), ('2'::INTEGER)) t(v);
----
[1, 3)

# extent(TIMESTAMP WITH TIME ZONE)
query I
SELECT extent(v)::VARCHAR FROM (VALUES ('2020-01-01 00:00:00+00'::TIMESTAMP WITH TIME ZONE), ('2020-01-02 00:00:00+00'::TIMESTAMP WITH TIME ZONE)) t(v);
----
[2020-01-01 00:00:00+00, 2020-01-02 00:00:00+00]

# extent(bigintset)
query I
SELECT extent(v)::VARCHAR FROM (VALUES ('{1}'::bigintset), ('{1, 2}'::bigintset)) t(v);
