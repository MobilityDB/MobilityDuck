# name: test/sql/aggregates_catalog.test
# description: Every aggregate MobilityDuck registers, over two rows of sample values, against the
#              answer MobilityDB gives over the same rows in the time zone UTC; and the set of
#              aggregate signatures it registers, which is the catalog's but for the entries over
#              raster and geography, types MobilityDuck does not have.
#              A value whose text carries a coordinate or a float is written with six decimals in
#              both engines.
# group: [sql]

require mobilityduck

statement ok
SET TimeZone = 'UTC';

# The point cloud values name pcid 1, whose schema holds three dimensions of type double, as
# test/sql/tpcpatch.test registers it.
statement ok
CREATE TABLE pointcloud_schemas (pcid integer PRIMARY KEY, srid integer NOT NULL,
  compression text NOT NULL DEFAULT 'none', description text);

statement ok
CREATE TABLE pointcloud_dimensions (pcid integer NOT NULL, dim_no integer NOT NULL,
  dim_name text NOT NULL, interpretation text NOT NULL, dim_scale double NOT NULL DEFAULT 1,
  dim_offset double NOT NULL DEFAULT 0, active boolean NOT NULL DEFAULT true, description text,
  PRIMARY KEY (pcid, dim_no));

statement ok
INSERT INTO pointcloud_schemas VALUES (1, 0, 'none', 'Three dimensions of type double');

statement ok
INSERT INTO pointcloud_dimensions VALUES
  (1, 1, 'X', 'double', 1, 0, true, NULL),
  (1, 2, 'Y', 'double', 1, 0, true, NULL),
  (1, 3, 'Z', 'double', 1, 0, true, NULL);

query I
SELECT pointCloudSchemaRegister(s.pcid, s.srid, s.compression,
         list({'dim_no': d.dim_no, 'dim_name': d.dim_name,
               'interpretation': d.interpretation, 'dim_scale': d.dim_scale,
               'dim_offset': d.dim_offset, 'active': d.active,
               'description': d.description} ORDER BY d.dim_no))
FROM pointcloud_schemas s JOIN pointcloud_dimensions d USING (pcid)
GROUP BY s.pcid, s.srid, s.compression;
----
true

# The aggregate signatures registered under the names of the catalog
query I
SELECT function_name || '(' || array_to_string(parameter_types, ',') || ')' FROM duckdb_functions()
WHERE function_type = 'aggregate' AND function_name IN ('appendInstantAgg', 'appendSequenceAgg', 'extent', 'mergeAgg', 'rasterUnion', 'sameAlignmentAgg', 'setUnionAgg', 'spanUnionAgg', 'spansetUnionAgg', 'summaryStatsAgg', 'tAndAgg', 'tAvg', 'tCentroid', 'tCount', 'tMaxAgg', 'tMinAgg', 'tOrAgg', 'tSum', 'tdensity', 'tnpoints', 'wAvgAgg', 'wCount', 'wMax', 'wMin', 'wSum')
ORDER BY 1;
