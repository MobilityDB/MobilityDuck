# name: test/sql/parity/091_baseval_scalar_accessors.test
# description: Generated base-value scalar accessors — cbuffer/npoint/nsegment.
# group: [sql]

require mobilityduck

# cbuffer radius / SRID

query I
SELECT radius(cbuffer 'Cbuffer(Point(1 1),5.0)');
----
5.0

query I
SELECT SRID(cbuffer 'SRID=3812;Cbuffer(Point(1 1),5)');
----
3812

# cbuffer hash is deterministic; distinct cbuffers hash differently

query I
SELECT hash(cbuffer 'Cbuffer(Point(1 1),5)')
     = hash(cbuffer 'Cbuffer(Point(1 1),5)');
----
true

query I
SELECT hash(cbuffer 'Cbuffer(Point(1 1),5)')
    <> hash(cbuffer 'Cbuffer(Point(2 2),9)');
----
true

# npoint route / position ("position" is a DuckDB reserved word -> quoted)

query I
SELECT route(npoint 'NPoint(1,0.5)');
----
1

query I
SELECT "position"(npoint 'NPoint(1,0.5)');
----
0.5

# nsegment route / start / end positions

query I
SELECT route(nsegment 'NSegment(2,0.1,0.7)');
----
2

query I
SELECT startPosition(nsegment 'NSegment(2,0.1,0.7)');
----
0.1

query I
SELECT endPosition(nsegment 'NSegment(2,0.1,0.7)');
----
0.7

# npoint / nsegment SRID resolve against the ways network

query I
SELECT SRID(npoint 'NPoint(1,0.5)') = SRID(nsegment 'NSegment(1,0.1,0.7)');
----
true

# A base value is a container in its own right, so the comparison group its catalog family
# declares reaches the surface as both the operator and its named function.

query III
SELECT pose 'Pose(Point(1 2),0.5)' = pose 'Pose(Point(1 2),0.5)',
       pose 'Pose(Point(1 2),0.5)' <> pose 'Pose(Point(3 4),0.5)',
       eq(pose 'Pose(Point(1 2),0.5)', pose 'Pose(Point(1 2),0.5)');
----
true	true	true

# The order is total and antisymmetric: exactly one of lt / gt / eq holds for a distinct pair,
# and reversing the operands reverses the answer.

query III
SELECT pose 'Pose(Point(1 2),0.5)' < pose 'Pose(Point(3 4),0.5)',
       pose 'Pose(Point(1 2),0.5)' > pose 'Pose(Point(3 4),0.5)',
       pose 'Pose(Point(1 2),0.5)' = pose 'Pose(Point(3 4),0.5)';
----
false	true	false

query II
SELECT pose 'Pose(Point(3 4),0.5)' < pose 'Pose(Point(1 2),0.5)',
       pose 'Pose(Point(3 4),0.5)' >= pose 'Pose(Point(1 2),0.5)';
----
true	false

query II
SELECT cbuffer 'Cbuffer(Point(1 1),1)' <> cbuffer 'Cbuffer(Point(2 2),2)',
       npoint 'NPoint(1,0.5)' >= npoint 'NPoint(1,0.5)';
----
true	true

query I
SELECT posechain 'PoseChain(Pose(Point(0 0),0),Pose(Point(1 1),0))'
     = posechain 'PoseChain(Pose(Point(0 0),0),Pose(Point(1 1),0))';
----
true

# A seeded hash joins the bare one the unary pass already carries.

query I
SELECT hashExtended(pose 'Pose(Point(1 2),0.5)', 42::UBIGINT)
     = hashExtended(pose 'Pose(Point(1 2),0.5)', 42::UBIGINT);
----
true

query I
SELECT hashExtended(pose 'Pose(Point(1 2),0.5)', 42::UBIGINT)
    <> hashExtended(pose 'Pose(Point(3 4),0.5)', 42::UBIGINT);
----
true

# A pose places another pose's point, translating it by the frame origin.

query I
SELECT applyPose(pose 'Pose(Point(1 0),0)', pose 'Pose(Point(10 20),0)')::VARCHAR;
----
POSE (010100000000000000000026400000000000003440, 0)
