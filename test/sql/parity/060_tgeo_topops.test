# name: test/sql/parity/060_tgeo_topops.test
# description: MobilityDB regression file 060_tgeo_topops.test.sql adapted for MobilityDuck
# group: [sql]
#
# Topological operators for tgeompoint vs stbox / tstzspan.
#
# Registered overloads (tgeompoint.cpp):
#   &&(TGEOMPOINT, STBOX)    — overlaps
#   &&(TGEOMPOINT, TSTZSPAN) — overlaps (time only)
#   @>(TGEOMPOINT, STBOX)    — contains
#
# Not yet registered (skip):
#   &&(STBOX, TGEOMPOINT)    — overlaps, stbox side
#   @>(STBOX, TGEOMPOINT)    — stbox contains tgeompoint
#   <@(TGEOMPOINT, STBOX)    — tgeompoint contained in stbox
#   -|-(TGEOMPOINT, STBOX)   — adjacent
#   &&(TGEOMPOINT, TGEOMPOINT) — spatial overlaps tgeo×tgeo
#   @>(TSTZSPAN, TGEOMPOINT)  — tstzspan contains tgeompoint

require mobilityduck

# =============================================================================
# && tgeompoint × stbox
# =============================================================================

# tgeompoint instant overlaps stbox
query I
SELECT "&&"(tgeompoint 'Point(1 1)@2000-01-01', stbox 'STBOX XT(((0,0),(2,2)),[1999-12-31,2000-01-02])');
----
true

query I
SELECT "&&"(tgeompoint '{Point(1 1)@2000-01-01, Point(2 2)@2000-01-02}', stbox 'STBOX XT(((0,0),(2,2)),[1999-12-31,2000-01-02])');
----
true

query I
SELECT "&&"(tgeompoint '[Point(1 1)@2000-01-01, Point(2 2)@2000-01-02]', stbox 'STBOX XT(((0,0),(2,2)),[1999-12-31,2000-01-02])');
----
true

query I
SELECT "&&"(tgeompoint '{[Point(1 1)@2000-01-01, Point(2 2)@2000-01-02],[Point(3 3)@2000-01-04, Point(3 3)@2000-01-05]}', stbox 'STBOX XT(((0,0),(4,4)),[1999-12-31,2000-01-06])');
----
true

# no overlap (point outside stbox)
query I
SELECT "&&"(tgeompoint 'Point(10 10)@2000-01-01', stbox 'STBOX XT(((0,0),(2,2)),[1999-12-31,2000-01-02])');
----
false

# =============================================================================
# @> tgeompoint contains stbox
# =============================================================================

# sequence contains a strictly smaller stbox
query I
SELECT "@>"(tgeompoint '[Point(0 0)@2000-01-01, Point(4 4)@2000-01-05]', stbox 'STBOX XT(((1,1),(3,3)),[2000-01-02,2000-01-04])');
----
true

# instant cannot contain a larger stbox
query I
SELECT "@>"(tgeompoint 'Point(1 1)@2000-01-01', stbox 'STBOX XT(((0,0),(4,4)),[1999-12-31,2000-01-06])');
----
false

# =============================================================================
# && tgeompoint × tstzspan
# =============================================================================

query I
SELECT "&&"(tgeompoint 'Point(1 1)@2000-01-01', tstzspan '[2000-01-01,2000-01-02]');
----
true

query I
SELECT "&&"(tgeompoint '[Point(1 1)@2000-01-01, Point(2 2)@2000-01-02]', tstzspan '[2000-01-01,2000-01-02]');
----
true

# no temporal overlap
query I
SELECT "&&"(tgeompoint 'Point(1 1)@2000-01-01', tstzspan '[2000-01-05,2000-01-06]');
----
false
