# name: test/sql/tpcpatch.test
# description: Core tpcpatch type port — construction, text/WKB I/O and
#              basic accessors. A tpcpatch value is a temporal
#              pgpointcloud patch: an opaque pgpointcloud pcpatch
#              (SERIALIZED_PATCH varlena, hex-WKB at the MEOS layer) that
#              moves over time. MEOS exposes no type-specific
#              tpcpatch_in/_out — the type binds to the generic
#              temporal_in(str, T_TPCPATCH) / temporal_out dispatch, the
#              same path the canonical MobilityDB SQL uses. Multi-instant
#              sequences need a registered pgpointcloud PCSCHEMA (a
#              catalog the standalone engine does not have), so these
#              self-contained checks exercise the schema-free instant
#              path and the deterministic rejection of invalid input.
#              The pcpatch hex literal below is pcid 1, uncompressed,
#              two points (1 1 1) and (2 2 2), followed by the fifteen
#              reserved bytes pgpointcloud sizes a serialized patch with
#              (BUFFERALIGN(sizeof(SERIALIZED_PATCH)) - 1 past the data
#              offset, 64 - 1 - 48 = 15); MEOS emits them as zeros. The
#              canonical serialized output carries the varlena length in
#              the header (4F00... in -> 3C01... out).
# group: [sql]

require mobilityduck

# Test tpcpatch constructor with parentheses (instant, hex-WKB pcpatch)
query I
SELECT (tpcpatch('4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01'))::text;
----
3C010000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01 00:00:00+01

# Test tpcpatch constructor without parentheses
query I
SELECT (tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01')::text;
----
3C010000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01 00:00:00+01

# Test the VARCHAR <-> TPCPATCH cast round-trips through temporal_out
query I
SELECT (tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01')::text;
----
3C010000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01 00:00:00+01

# Test tempSubtype with instant
query I
SELECT tempSubtype(tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01');
----
Instant

# Test interp accessor on an instant
query I
SELECT interp(tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01');
----
None

# Test memSize is positive
query I
SELECT memSize(tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01') > 0;
----
true

# Test getValue surfaces the pcpatch value in canonical hex-WKB text
query I
SELECT getValue(tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01');
----
3C010000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000

# Test startValue surfaces the pcpatch value in canonical hex-WKB text
query I
SELECT startValue(tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01');
----
3C010000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000

# Test pcid returns the pgpointcloud schema id (schema-free header read)
query I
SELECT pcid(tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01');
----
1

# Test numPoints returns the patch point count (schema-free header read)
query I
SELECT numPoints(tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01');
----
2

# Test getTimestamp on an instant
query I
SELECT getTimestamp(tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2023-01-01 10:00:00+00');
----
2023-01-01 11:00:00+01

# Test tpcpatchInst transformation round-trips the instant
query I
SELECT (tpcpatchInst(tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01'))::text;
----
3C010000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01 00:00:00+01

# Test startInstant
query I
SELECT (startInstant(tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01'))::text;
----
3C010000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01 00:00:00+01

# Test binary round-trip is identity (subtype-agnostic MEOS-WKB)
query I
SELECT (tpcpatchFromBinary(asBinary(tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01')))::text
     = (tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01')::text;
----
true

# Test hex-WKB round-trip is identity
query I
SELECT (tpcpatchFromHexWKB(asHexWKB(tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01')))::text
     = (tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01')::text;
----
true

# Test tpcpatchFromText constructor
query I
SELECT (tpcpatchFromText('4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01'))::text IS NOT NULL;
----
true

# Test timeSpan function
query I
SELECT timeSpan(tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01');
----
[2024-01-01 00:00:00+01, 2024-01-01 00:00:00+01]

# Test numInstants generic accessor
query I
SELECT numInstants(tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01');
----
1

# Test asMFJSON produces valid MF-JSON (pcid / npoints / 2D bounds from the
# serialized value; schema-free)
query I
SELECT asMFJSON(tpcpatch '4F000000010000000000000002000000000000000000F03F000000000000F03F000000000000F03F000000000000004000000000000000400000000000000040000000000000000000000000000000@2024-01-01') IS NOT NULL;
----
true

# Test invalid input is rejected deterministically
statement error
SELECT tpcpatch('not-a-valid-tpcpatch');
----
Missing delimeter character
