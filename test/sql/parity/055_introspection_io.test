# name: test/sql/parity/055_introspection_io.test
# description: Cluster C + D parity gaps closed in one PR.
#
#   C — sequence/segment introspection: sequenceN(temp, int) for
#       tint/tfloat/tbool/ttext (pre-existing for the four spatial-
#       temporal types); deltaValue(tnumber).
#
#   D — MFJSON / Hex(E)WKB I/O: asMFJSON(temp[, with_bbox[, prec]])
#       for all 8 temporal types; asHexWKB(temp); asHexEWKB(tspatial)
#       alias; type-specific FromMFJSON parse constructors.
#
# Round-trip-ability via MFJSON is the headline check — every type
# can be serialised then re-parsed back to an equivalent temporal.
# group: [sql]

require mobilityduck

# =============================================================================
# Cluster C — sequenceN for tnumber/tbool/ttext
# =============================================================================

query I
SELECT (sequenceN('{[1@2000-01-01,2@2000-01-02], [3@2000-01-03,4@2000-01-04]}'::tint, 1)
        IS NOT NULL);
----
true

query I
SELECT (sequenceN('{[1.0@2000-01-01,2.0@2000-01-02], [3.0@2000-01-03,4.0@2000-01-04]}'::tfloat, 2)
        IS NOT NULL);
----
true

query I
SELECT (sequenceN('{[true@2000-01-01,false@2000-01-02], [true@2000-01-03,false@2000-01-04]}'::tbool, 1)
        IS NOT NULL);
----
true

query I
SELECT (sequenceN('{["a"@2000-01-01,"b"@2000-01-02], ["c"@2000-01-03,"d"@2000-01-04]}'::ttext, 1)
        IS NOT NULL);
----
true

# =============================================================================
# Cluster C — deltaValue
# =============================================================================

# deltaValue on a step-interp tint: 5 - 1 = 4 between t1 and t2.
query I
SELECT startValue(deltaValue('[1@2000-01-01, 5@2000-01-02, 3@2000-01-03]'::tint));
----
4

query I
SELECT abs(startValue(deltaValue('[1.0@2000-01-01, 5.0@2000-01-02]'::tfloat))
           - 4.0) < 1e-12;
----
true

# =============================================================================
# Cluster D — asMFJSON, all 8 temporal types
# =============================================================================

query I
SELECT length(asMFJSON('1@2000-01-01'::tint)) > 0;
----
true

query I
SELECT length(asMFJSON('1.5@2000-01-01'::tfloat)) > 0;
----
true

query I
SELECT length(asMFJSON('true@2000-01-01'::tbool)) > 0;
----
true

query I
SELECT length(asMFJSON('"a"@2000-01-01'::ttext)) > 0;
----
true

query I
SELECT length(asMFJSON('Point(0 0)@2000-01-01'::tgeompoint)) > 0;
----
true

query I
SELECT length(asMFJSON('Point(0 0)@2000-01-01'::tgeogpoint)) > 0;
----
true

query I
SELECT length(asMFJSON('Point(0 0)@2000-01-01'::tgeometry)) > 0;
----
true

query I
SELECT length(asMFJSON('Point(0 0)@2000-01-01'::tgeography)) > 0;
----
true

# 2-arg shape (with_bbox bool) and 3-arg shape (with_bbox + precision).
query I
SELECT length(asMFJSON('1@2000-01-01'::tint, true)) > 0;
----
true

query I
SELECT length(asMFJSON('Point(0 0)@2000-01-01'::tgeompoint, true, 5)) > 0;
----
true

# =============================================================================
# Cluster D — asHexWKB / asHexEWKB
# =============================================================================

query I
SELECT length(asHexWKB('1@2000-01-01'::tint)) > 0;
----
true

query I
SELECT length(asHexWKB('1.5@2000-01-01'::tfloat)) > 0;
----
true

query I
SELECT length(asHexWKB('Point(0 0)@2000-01-01'::tgeompoint)) > 0;
----
true

# asHexEWKB is an alias for asHexWKB on the spatio-temporal types.
query I
SELECT length(asHexEWKB('Point(0 0)@2000-01-01'::tgeompoint)) > 0;
----
true

query I
SELECT length(asHexEWKB('Point(0 0)@2000-01-01'::tgeography)) > 0;
----
true

query I
SELECT asHexWKB('1@2000-01-01'::tint) = asHexEWKB('Point(0 0)@2000-01-01'::tgeompoint);
----
false

# =============================================================================
# Cluster D — round-trip MFJSON serialise → parse for all 8 temporal types
# =============================================================================

query I
SELECT (tintFromMFJSON(asMFJSON('1@2000-01-01'::tint))::VARCHAR
        = '1@2000-01-01'::tint::VARCHAR);
----
true

query I
SELECT (tfloatFromMFJSON(asMFJSON('1.5@2000-01-01'::tfloat))::VARCHAR
        = '1.5@2000-01-01'::tfloat::VARCHAR);
----
true

query I
SELECT (tboolFromMFJSON(asMFJSON('true@2000-01-01'::tbool)) IS NOT NULL);
----
true

query I
SELECT (ttextFromMFJSON(asMFJSON('"a"@2000-01-01'::ttext)) IS NOT NULL);
----
true

query I
SELECT (tgeompointFromMFJSON(asMFJSON('Point(0 0)@2000-01-01'::tgeompoint))
        IS NOT NULL);
----
true

query I
SELECT (tgeogpointFromMFJSON(asMFJSON('Point(0 0)@2000-01-01'::tgeogpoint))
        IS NOT NULL);
----
true

query I
SELECT (tgeometryFromMFJSON(asMFJSON('Point(0 0)@2000-01-01'::tgeometry))
        IS NOT NULL);
----
true

query I
SELECT (tgeographyFromMFJSON(asMFJSON('Point(0 0)@2000-01-01'::tgeography))
        IS NOT NULL);
----
true
