# name: test/sql/time_casts.test
# description: The casts between the time types of DuckDB and those of MEOS convert through the
#              MEOS conversions of the counts from the Unix epoch, as session_timezone.test
#              reads the zone they print in: an instant crosses to the microsecond, and an
#              instant MEOS holds beyond the range of a DuckDB timestamp is refused, never
#              wrapped.
# group: [sql]

require mobilityduck

statement ok
SET TimeZone = 'UTC'

# An instant to the microsecond, in and out
query I
SELECT startTimestamp(tfloat '1@2001-01-01 08:00:00.123456+00');
----
2001-01-01 08:00:00.123456+00

query I
SELECT lower(datespan '[2001-01-01, 2001-01-05]');
----
2001-01-01

# The last finite instant of DuckDB crosses as it is
query I
SELECT asText(tstzset '{2001-01-01}' + '294247-01-01 00:00:00+00'::TIMESTAMPTZ);
----
{"2001-01-01 00:00:00+00", "294247-01-01 00:00:00+00"}

# An instant MEOS holds beyond the range of a DuckDB timestamp is refused
statement error
SELECT startTimestamp(tfloat '1@294270-01-01 00:00:00+00');
----
timestamp out of range

# An infinity of DuckDB maps to that of MEOS, which refuses it where it enters a value
statement error
SELECT asText(tstzset '{2001-01-01}' + 'infinity'::TIMESTAMPTZ);
----
The timestamp must be finite

statement error
SELECT asText(tfloat(1.0, 'infinity'::TIMESTAMPTZ));
----
The timestamp must be finite

# MEOS refuses its own infinities in a value as it refuses those of DuckDB
statement error
SELECT asText(tstzspan '[-infinity, 2001-01-01]');
----
The timestamp must be finite

statement error
SELECT asText(tstzspanset '{[2001-01-01, infinity]}');
----
The timestamp must be finite

statement error
SELECT asText(tfloat '1@infinity');
----
The timestamp must be finite

statement error
SELECT asText(datespan '[2001-01-01, infinity]');
----
The date must be finite

# A predicate over an infinity answers, as in PostgreSQL
query I
SELECT tstzspan '[2001-01-01, 2001-01-05]' @> 'infinity'::TIMESTAMPTZ;
----
false
