# name: test/sql/parity/003_span.test
# description: MobilityDB regression file 003_span.test.sql adapted for MobilityDuck
# group: [sql]
#
# Queries from mobilitydb/test/temporal/queries/003_span.test.sql.
# Expected outputs reflect MobilityDuck's display format (ISO dates,
# UTC timestamps under TZ=UTC) rather than MobilityDB's PG-locale
# format ("01-01-2000", "Sat Jan 01 00:00:00 2000 PST").

require mobilityduck

# =============================================================================
# I/O — parse errors
# =============================================================================

statement error
SELECT intspan '[1,2] xxx';
----
Could not parse

statement error
SELECT floatspan '[1,2] xxx';
----
Could not parse

statement error
SELECT tstzspan '[2000-01-01,2000-01-02] xxx';
----
Could not parse

statement error
SELECT tstzspan '2000-01-01, 2000-01-02';
----
Could not parse

statement error
SELECT tstzspan '[2000-01-01, 2000-01-02';
----
Could not parse

# =============================================================================
# Output in WKT format
# =============================================================================

query I
SELECT asText(floatspan '[1.12345678, 2.123456789]', 6);
----
[1.123457, 2.123457]

statement error
SELECT asText(floatspan '[1.12345678, 2.123456789]', -6);
----
cannot be negative

# =============================================================================
# Constructors
# =============================================================================

query I
SELECT span(timestamptz '2000-01-01', '2000-01-02');
----
[2000-01-01 00:00:00+01, 2000-01-02 00:00:00+01)

query I
SELECT span(timestamptz '2000-01-01', '2000-01-01', true, true);
----
[2000-01-01 00:00:00+01, 2000-01-01 00:00:00+01]

statement error
SELECT span(timestamptz '2000-01-01', '2000-01-01');
----
cannot be empty

statement error
SELECT span(timestamptz '2000-01-02', '2000-01-01');
----
must be less than or equal

# =============================================================================
# Conversion
# =============================================================================

# range(span) / span(range) convert to and from the PostgreSQL daterange /
# tstzrange range types. DuckDB has no range type, so these conversions are
# outside the DuckDB binding's scope.

query I
SELECT span(date '2000-01-01');
----
[2000-01-01, 2000-01-02)

query I
SELECT date '2000-01-01'::datespan;
----
[2000-01-01, 2000-01-02)

# OUT OF SCOPE: range(span) / span(range) are the PostgreSQL range<->span
# impedance layer (CREATE FUNCTION range/span over daterange/tstzrange lives
# only in mobilitydb/sql; no counterpart in meos/src). MEOS has no RANGE type
# (closed algebra), so these conversions do not exist in the DuckDB binding.

query I
SELECT span(timestamptz '2000-01-01');
----
[2000-01-01 00:00:00+01, 2000-01-01 00:00:00+01]

query I
SELECT timestamptz '2000-01-01'::tstzspan;
----
[2000-01-01 00:00:00+01, 2000-01-01 00:00:00+01]

query I
SELECT (date '2000-01-01'::timestamptz)::tstzspan;
----
[2000-01-01 00:00:00+01, 2000-01-01 00:00:00+01]

query I
SELECT span(date '2000-01-01'::timestamptz);
----
[2000-01-01 00:00:00+01, 2000-01-01 00:00:00+01]

# OUT OF SCOPE: tstzrange is a PostgreSQL range type; MEOS has no RANGE, so the
# tstzrange -> tstzspan cast (defined only in mobilitydb/sql) is not in the
# DuckDB binding.

