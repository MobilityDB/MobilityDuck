# A INT64 cube in GZIP: no MEOS pixel type holds 64-bit integers.
statement error
SELECT raster(from_hex('53520207020000000300000002000000000000000000F0FF1F8B08000000000000FF2DC9C90900201004C1D58767D09AB9C252FD298689C8EE53A8B0D27D9ADD3938B9B8F901F9F077F760000000'), 0, 0, meta_none())
----
