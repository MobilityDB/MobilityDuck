query I
SELECT scale(tstzspan '(2000-01-01,2000-01-02]', '1 hour');
----
(2000-01-01 00:00:00+01, 2000-01-01 01:00:00+01]

query I
SELECT scale(tstzspan '[2000-01-01,2000-01-02)', '1 hour');
----
[2000-01-01 00:00:00+01, 2000-01-01 01:00:00+01)

query I
SELECT scale(tstzspan '(2000-01-01,2000-01-02)', '1 hour');
----
