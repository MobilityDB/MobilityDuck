{
        "dependencies": [
          "gsl",
          { "name": "meos", "version>=": "0" },

          "vcpkg-cmake",
          "openssl",
          "zlib",
          "expat",
          "h3",
          {
            "name": "libxml2",
            "features": [ "zlib", { "name": "iconv", "platform": "!mingw" } ],
            "default-features": false
          },
          {
            "name": "sqlite3",
            "features": [ "rtree" ],
            "default-features": false
          },
          {
            "name": "proj",
            "default-features": false,
            "version>=": "9.1.1"
          },
          {
            "name": "curl",
            "platform": "!wasm32 & !ios & !android",
            "features": [ "openssl" ],
            "default-features": false
          },
          {
            "name": "gdal",
            "version>=": "3.12.0",
            "default-features": false,
            "features": [
              {
                "name": "curl",
                "platform": "!wasm32 & !ios & !android"
              },
              {
                "name": "openssl",
                "platform": "!wasm32 & !ios & !android"
              }
            ]
          }
        ],
        "builtin-baseline": "84bab45d415d22042bd0b9081aea57f362da3f35",
        "vcpkg-configuration": {
                "overlay-triplets": [
                        "./vcpkg_triplets"
                ],
                "overlay-ports": [
                        "./extension-ci-tools/vcpkg_ports",
                        "./vcpkg_ports"
                ]
        }
}
