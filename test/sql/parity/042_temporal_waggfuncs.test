# name: test/sql/parity/042_temporal_waggfuncs.test
# description: MobilityDB regression file 042_temporal_waggfuncs.test.sql adapted for MobilityDuck
# group: [sql]
#
# Windowed temporal aggregates: wmin, wmax, wsum, wavg registered in
# src/temporal/temporal_aggregates.cpp.
# wcount is NOT registered (MEOS wcount_transfn produces a tint count
# over a window, but is absent from the current MEOS public API header).
# Expected outputs verified against MobilityDB 042_temporal_waggfuncs.test.out.

require mobilityduck

mode skip
# wcount is not registered — MEOS symbol tnumber_wcount_transfn absent
# from meos.h public surface.
query I
SELECT wcount(temp, interval '5 minutes') FROM (VALUES (NULL::tint),('1@2000-01-01'::tint)) t(temp);
----
{[1@2000-01-01 00:00:00+00, 1@2000-01-01 00:05:00+00]}
mode unskip

# =============================================================================
# wmin — windowed minimum
# =============================================================================

query I
SELECT WminAgg(temp, NULL) FROM (VALUES (NULL::tint),(NULL::tint)) t(temp);
----
NULL

query I
SELECT WminAgg(temp, NULL) FROM (VALUES (NULL::tint),('1@2000-01-01'::tint)) t(temp);
----
NULL

query I
SELECT WminAgg(temp, interval '5 minutes') FROM (VALUES (NULL::tint),(NULL::tint)) t(temp);
----
NULL

query I
SELECT WminAgg(temp, interval '5 minutes') FROM (VALUES (NULL::tint),('1@2000-01-01'::tint)) t(temp);
----
{[1@2000-01-01 00:00:00+00, 1@2000-01-01 00:05:00+00]}

# =============================================================================
# wmax — windowed maximum
# =============================================================================

query I
SELECT WmaxAgg(temp, interval '5 minutes') FROM (VALUES (NULL::tint),(NULL::tint)) t(temp);
----
NULL

query I
SELECT WmaxAgg(temp, interval '5 minutes') FROM (VALUES (NULL::tint),('1@2000-01-01'::tint)) t(temp);
----
{[1@2000-01-01 00:00:00+00, 1@2000-01-01 00:05:00+00]}

# =============================================================================
# wsum — windowed sum
# =============================================================================

query I
SELECT WsumAgg(temp, interval '5 minutes') FROM (VALUES (NULL::tint),(NULL::tint)) t(temp);
----
NULL

query I
SELECT WsumAgg(temp, interval '5 minutes') FROM (VALUES (NULL::tint),('1@2000-01-01'::tint)) t(temp);
----
{[1@2000-01-01 00:00:00+00, 1@2000-01-01 00:05:00+00]}

# =============================================================================
# wavg — windowed average (returns tfloat with Interp=Step)
# =============================================================================

query I
SELECT WavgAgg(temp, interval '5 minutes') FROM (VALUES (NULL::tint),(NULL::tint)) t(temp);
----
NULL

query I
SELECT WavgAgg(temp, interval '5 minutes') FROM (VALUES (NULL::tint),('1@2000-01-01'::tint)) t(temp);
----
Interp=Step;{[1@2000-01-01 00:00:00+00, 1@2000-01-01 00:05:00+00]}
