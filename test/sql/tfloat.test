require mobilityduck

query I
SELECT tfloat(1, timestamptz '2012-01-01 08:00:00');
----
1@2012-01-01 08:00:00+01

query I
SELECT tfloat(1.5, timestamptz '2012-01-01 08:00:00');
----
1.5@2012-01-01 08:00:00+01

query I
SELECT '1.5@2025-01-01'::TFLOAT as tfloat;
----
1.5@2025-01-01 00:00:00+01

# query I
# SELECT * FROM tempUnnest(tint '[1@2001-01-01, 2@2001-01-02, 1@2001-01-03]');
# ----
# (1,'{[2001-01-01 00:00:00+00, 2001-01-02 00:00:00+00), [2001-01-03 00:00:00+00, 2001-01-03 00:00:00+00]}')
# (2,'{[2001-01-02 00:00:00+00, 2001-01-03 00:00:00+00)}')

query I
SELECT tempDump(tfloat '[1.5@2001-01-01, 2.5@2001-01-02, 1.5@2001-01-03]');
----
[{'value': 1.5, 'time': '{[2001-01-01 00:00:00+01, 2001-01-01 00:00:00+01], [2001-01-03 00:00:00+01, 2001-01-03 00:00:00+01]}'}, {'value': 2.5, 'time': '{[2001-01-02 00:00:00+01, 2001-01-02 00:00:00+01]}'}]

query I
SELECT atSpan(tfloat 'Interp=Step;{[1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03],[3.5@2000-01-04, 3.5@2000-01-05]}', floatspan '[1,3]');
----
Interp=Step;{[1.5@2000-01-01 00:00:00+01, 2.5@2000-01-02 00:00:00+01, 1.5@2000-01-03 00:00:00+01]}

query I
SELECT atMin(tfloat 'Interp=Step;{[1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03],[3.5@2000-01-04, 3.5@2000-01-05]}');
----
Interp=Step;{[1.5@2000-01-01 00:00:00+01, 1.5@2000-01-02 00:00:00+01), [1.5@2000-01-03 00:00:00+01]}

query I
SELECT instants(tfloat 'Interp=Step;{[1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03],[3.5@2000-01-04, 3.5@2000-01-05]}');
----
['1.5@2000-01-01 00:00:00+01', '2.5@2000-01-02 00:00:00+01', '1.5@2000-01-03 00:00:00+01', '3.5@2000-01-04 00:00:00+01', '3.5@2000-01-05 00:00:00+01']

query I
SELECT timestamps(tfloat 'Interp=Step;{[1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03],[3.5@2000-01-04, 3.5@2000-01-05]}');
----
['2000-01-01 00:00:00+01', '2000-01-02 00:00:00+01', '2000-01-03 00:00:00+01', '2000-01-04 00:00:00+01', '2000-01-05 00:00:00+01']

query I
SELECT atTime(tfloat 'Interp=Step;{[1.5@2000-01-01, 2.5@2000-01-03, 1.5@2000-01-05],[3.5@2000-01-06, 3.5@2000-01-07]}', timestamptz '2000-01-02');
----
1.5@2000-01-02 00:00:00+01

query I
SELECT atTime(tfloat 'Interp=Step;{[1.5@2000-01-01, 2.5@2000-01-03, 1.5@2000-01-05],[3.5@2000-01-06, 3.5@2000-01-07]}', timestamptz '2020-01-02');
----
NULL


query I
SELECT tfloat(1.5, tstzset '{2012-01-01, 2012-01-02, 2012-01-03}');
----
{1.5@2012-01-01 00:00:00+01, 1.5@2012-01-02 00:00:00+01, 1.5@2012-01-03 00:00:00+01}

query I 
SELECT tfloat(1.5, tstzspan '[2012-01-01, 2012-01-01]');
----
[1.5@2012-01-01 00:00:00+01]

query I 
SELECT tfloat(1.5, tstzspan '[2012-01-01, 2012-01-03]');
----
[1.5@2012-01-01 00:00:00+01, 1.5@2012-01-03 00:00:00+01]

query I
SELECT tfloat(1.5, tstzspan '[2012-01-01, 2012-01-03]', 'step');
----
Interp=Step;[1.5@2012-01-01 00:00:00+01, 1.5@2012-01-03 00:00:00+01]


query I 
SELECT tfloat(tint '[1@2001-01-01, 1@2001-01-02]');
----
Interp=Step;[1@2001-01-01 00:00:00+01, 1@2001-01-02 00:00:00+01]

query I 
SELECT tbox(tfloat '1.5@2000-01-01');
----
TBOXFLOAT XT([1.5, 1.5],[2000-01-01 00:00:00+01, 2000-01-01 00:00:00+01])

query I
SELECT getValue(tfloat '1.5@2000-01-01');
----
1.5

query I
SELECT segments(tfloat 'Interp=Step;[1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03]');
----
['Interp=Step;[1.5@2000-01-01 00:00:00+01, 1.5@2000-01-02 00:00:00+01)', 'Interp=Step;[2.5@2000-01-02 00:00:00+01, 2.5@2000-01-03 00:00:00+01)', 'Interp=Step;[1.5@2000-01-03 00:00:00+01]']

query I 
SELECT tfloatSeqSet(tfloat '{1@2000-01-01, 2@2000-01-02}', 'Linear');                                       
----
{[1@2000-01-01 00:00:00+01], [2@2000-01-02 00:00:00+01]}

query I
SELECT setInterp(tfloat '{1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03}', 'discrete');
----
{1.5@2000-01-01 00:00:00+01, 2.5@2000-01-02 00:00:00+01, 1.5@2000-01-03 00:00:00+01}

query I
SELECT setInterp(tfloat '{1@2000-01-01}', 'linear');                               
----
[1@2000-01-01 00:00:00+01]

query I
SELECT appendSequence(tfloat '{[1@2000-01-01, 2@2000-01-02]}', tfloat '[2@2000-01-02]');
----
{[1@2000-01-01 00:00:00+01, 2@2000-01-02 00:00:00+01]}

query I 
SELECT atValues(tfloat '{[1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03],[3.5@2000-01-04, 3.5@2000-01-05]}', 2);
----
{[2@2000-01-01 12:00:00+01], [2@2000-01-02 12:00:00+01]}

query I 
SELECT minusValues(tfloat '[1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03]', 1.5);
----
{(1.5@2000-01-01 00:00:00+01, 2.5@2000-01-02 00:00:00+01, 1.5@2000-01-03 00:00:00+01)}

query I 
SELECT atValues(tfloat 'Interp=Step;[1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03]', floatset '{1.5,2}');
----
Interp=Step;{[1.5@2000-01-01 00:00:00+01, 1.5@2000-01-02 00:00:00+01), [1.5@2000-01-03 00:00:00+01]}

query I 
SELECT minusValues(tfloat '{1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03}', floatset '{1.5,2}');
----
{2.5@2000-01-02 00:00:00+01}

query I 
SELECT atSpan(tfloat '[1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03]', floatspan '[1,3]');
----
{[1.5@2000-01-01 00:00:00+01, 2.5@2000-01-02 00:00:00+01, 1.5@2000-01-03 00:00:00+01]}

query I 
SELECT atSpanset(tfloat '{[1@2000-01-01, 3@2000-01-03],[4@2000-01-04]}', floatspanset '{[1,2],[3,4]}');
----
{[1@2000-01-01 00:00:00+01, 2@2000-01-02 00:00:00+01], [3@2000-01-03 00:00:00+01], [4@2000-01-04 00:00:00+01]}

query I 
SELECT atMin(tfloat '1.5@2000-01-01');
----
1.5@2000-01-01 00:00:00+01

query I 
SELECT atMax(tfloat '{[1@2012-01-01, 3@2012-01-03), (3@2012-01-03, 1@2012-01-05)}');
----
NULL

query I 
SELECT valueAtTimestamp(tfloat '{[1.5@2000-01-01, 2.5@2000-01-03, 1.5@2000-01-05],[3.5@2000-01-06, 3.5@2000-01-07]}', timestamptz '2000-01-02');
----
2.0

query I 
SELECT atTBox(tfloat '{[1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03],[3.5@2000-01-04, 3.5@2000-01-05]}', tbox 'TBOXFLOAT XT([1,2],[2000-01-01,2000-01-02])');
----
{[1.5@2000-01-01 00:00:00+01, 2@2000-01-01 12:00:00+01]}

query I 
SELECT minusTBox(tfloat '[1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03]', tbox 'TBOXFLOAT XT([1,2],[2000-01-01,2000-01-02])');
----
{(2@2000-01-01 12:00:00+01, 2.5@2000-01-02 00:00:00+01, 1.5@2000-01-03 00:00:00+01]}

query I 
SELECT afterTimestamp(tfloat '{1.5@2000-01-02, 2.5@2000-01-04, 1.5@2000-01-05}', timestamptz '2000-01-04');
----
NULL

query I 
SELECT insert(
  tfloat '{[1@2000-01-01, 2@2000-01-02], [3@2000-01-03, 4@2000-01-04], [5@2000-01-05, 6@2000-01-06]}',
  tfloat '{[2@2000-01-02, 3@2000-01-03], [4@2000-01-04, 5@2000-01-05]}');
----
{[1@2000-01-01 00:00:00+01, 6@2000-01-06 00:00:00+01]}

query I 
SELECT insert(
  tfloat '{[1@2000-01-01, 2@2000-01-02], [4@2000-01-04, 5@2000-01-05]}',
  tfloat '{[2@2000-01-02, 3@2000-01-03]}', false);
----
{[1@2000-01-01 00:00:00+01, 4@2000-01-04 00:00:00+01]}

query I 
SELECT update(
  tfloat '{[1@2000-01-01, 2@2000-01-02], [3@2000-01-03, 4@2000-01-04], [5@2000-01-05, 6@2000-01-06]}',
  tfloat '{[2@2000-01-02, 3@2000-01-03], [4@2000-01-04, 5@2000-01-05]}');
----
{[1@2000-01-01 00:00:00+01, 6@2000-01-06 00:00:00+01]}

query I 
SELECT update(
  tfloat '{[1@2000-01-01, 2@2000-01-02], [4@2000-01-04, 5@2000-01-05]}',
  tfloat '{[2@2000-01-02, 3@2000-01-03]}', false);
----
{[1@2000-01-01 00:00:00+01, 4@2000-01-04 00:00:00+01]}

query I 
SELECT segmentMinDuration(tfloat 'Interp=Step;{[1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03],[3.5@2000-01-04, 3.5@2000-01-05]}', '1 day');
----
{[f@2000-01-01 00:00:00+01, f@2000-01-03 00:00:00+01), [f@2000-01-04 00:00:00+01, f@2000-01-05 00:00:00+01)}

query I
SELECT segmentMaxDuration(tfloat '{[1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03],[3.5@2000-01-04, 3.5@2000-01-05]}', '1 day');
----
{[f@2000-01-01 00:00:00+01, f@2000-01-03 00:00:00+01), [f@2000-01-04 00:00:00+01, f@2000-01-05 00:00:00+01)}

query I 
SELECT integral(tfloat '{[1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03],[3.5@2000-01-04, 3.5@2000-01-05]}');
----
648000000000

query I 
SELECT round(twAvg(tfloat 'Interp=Step;[1@2000-01-01, 2@2000-01-02, 1@2000-01-03]'), 6);
----
1.5

query I 
SELECT tfloat '1.5@2000-01-01' > tfloat '{[1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03],[3.5@2000-01-04, 3.5@2000-01-05]}';
----
false

query I
SELECT duration(tfloat 'Interp=Step;[1.5@2000-01-01, 2.5@2000-01-02, 1.5@2000-01-03]');
----
2 days

# tsequenceset_make_gaps: split an array of instants into sequences at time gaps (> maxt)
# and/or value gaps (> maxdist).
query I
SELECT tfloatSeqSetGaps([tfloat '1@2000-01-01', tfloat '2@2000-01-02', tfloat '10@2000-01-10'], interval '2 days');
----
{[1@2000-01-01 00:00:00+01, 2@2000-01-02 00:00:00+01], [10@2000-01-10 00:00:00+01]}

query I
SELECT tfloatSeqSetGaps([tfloat '1@2000-01-01', tfloat '2@2000-01-02', tfloat '10@2000-01-03'], interval '5 days', 5.0);
----
{[1@2000-01-01 00:00:00+01, 2@2000-01-02 00:00:00+01], [10@2000-01-03 00:00:00+01]}

query I
SELECT tfloatSeqSetGaps([tfloat '1@2000-01-01', tfloat '2@2000-01-02', tfloat '3@2000-01-03'], interval '5 days', 5.0);
----
{[1@2000-01-01 00:00:00+01, 3@2000-01-03 00:00:00+01]}

# From MF-JSON / HexWKB parsers (generated base-type name family). Strings are the
# MEOS encodings of the corresponding literals (Europe/Brussels session tz).
query I
SELECT tfloatFromMFJSON('{"type":"MovingFloat","values":[1.5,2.5],"datetimes":["2000-01-01T00:00:00+01","2000-01-02T00:00:00+01"],"lower_inc":true,"upper_inc":true,"interpolation":"Linear"}') = tfloat '[1.5@2000-01-01, 2.5@2000-01-02]';
----
true

query I
SELECT tfloatFromHexWKB('0121000E0200000003000000000000F83F005C6C29FFFFFFFF000000000000044000BC434713000000') = tfloat '[1.5@2000-01-01, 2.5@2000-01-02]';
----
true

# asHexWKB output (base hex-WKB) — generated inherited Temporal<T> surface. Round-trips.
query I
SELECT tfloatFromHexWKB(asHexWKB(tfloat '[1.5@2000-01-01, 2.5@2000-01-02]')) = tfloat '[1.5@2000-01-01, 2.5@2000-01-02]';
----
true
