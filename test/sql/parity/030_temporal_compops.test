# name: test/sql/parity/030_temporal_compops.test
# description: Temporal comparison predicates returning Temporal — tEqual,
#              tNotEqual, tLessThan, tLessEqual, tGreaterThan,
#              tGreaterEqual across (base × t, t × base, t × t).
#              MobilityDB also exposes these as `?=`/`?<>`/`?<` etc. operators;
#              DuckDB's parser does not accept multi-character operator tokens
#              (`?=`, `#=`), so only the named functions are registered here.
# group: [sql]

require mobilityduck

# tEqual with value × t (tint side)

query I
SELECT tEqual(1, tint '[1@2000-01-01, 2@2000-01-02]');
----
[t@2000-01-01 00:00:00+01, f@2000-01-02 00:00:00+01]

query I
SELECT tEqual(tint '[1@2000-01-01, 2@2000-01-02]', 1);
----
[t@2000-01-01 00:00:00+01, f@2000-01-02 00:00:00+01]

# tEqual on tbool

query I
SELECT tEqual(true, tbool '[t@2000-01-01, f@2000-01-02]');
----
[t@2000-01-01 00:00:00+01, f@2000-01-02 00:00:00+01]

# tEqual on tfloat (continuous interpolation crosses the threshold)

query I
SELECT tEqual(2.5, tfloat '[1@2000-01-01, 5@2000-01-03]');
----
{[f@2000-01-01 00:00:00+01, t@2000-01-01 18:00:00+01], (f@2000-01-01 18:00:00+01, f@2000-01-03 00:00:00+01]}

# tEqual on ttext

query I
SELECT tNotEqual('hello', ttext '["hello"@2000-01-01, "world"@2000-01-02]');
----
[f@2000-01-01 00:00:00+01, t@2000-01-02 00:00:00+01]

# tEqual with two temporals (same shape)

query I
SELECT tEqual(tint '[1@2000-01-01, 2@2000-01-02]', tint '[1@2000-01-01, 3@2000-01-02]');
----
[t@2000-01-01 00:00:00+01, f@2000-01-02 00:00:00+01]

# tLessThan — strict less-than

query I
SELECT tLessThan(tint '[1@2000-01-01, 5@2000-01-02]', 3);
----
[t@2000-01-01 00:00:00+01, f@2000-01-02 00:00:00+01]

# tLessEqual vs tLessThan at the boundary value

query I
SELECT tLessEqual(tint '[3@2000-01-01]', 3);
----
[t@2000-01-01 00:00:00+01]

query I
SELECT tLessThan(tint '[3@2000-01-01]', 3);
----
[f@2000-01-01 00:00:00+01]

# tGreaterEqual / tGreaterThan symmetric to tLessEqual / tLessThan

query I
SELECT tGreaterEqual(tint '[3@2000-01-01]', 3);
----
[t@2000-01-01 00:00:00+01]

query I
SELECT tGreaterThan(tint '[3@2000-01-01]', 3);
----
[f@2000-01-01 00:00:00+01]

# Ordered comparisons on ttext

query I
SELECT tLessThan(ttext '["a"@2000-01-01, "z"@2000-01-02]', 'm');
----
[t@2000-01-01 00:00:00+01, f@2000-01-02 00:00:00+01]
