# appendInstantAgg(tcbuffer)
query I
SELECT asText(appendInstantAgg(v), 6) FROM (VALUES ('Cbuffer(Point(1 1),0.5)@2020-01-01'::tcbuffer), ('Cbuffer(Point(2 2),0.5)@2020-01-02'::tcbuffer)) t(v);
----
[Cbuffer(POINT(1 1),0.5)@2020-01-01 00:00:00+00, Cbuffer(POINT(2 2),0.5)@2020-01-02 00:00:00+00]

